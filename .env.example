# Variáveis do HOST lidas pelo compose (nenhuma é segredo; segredos vêm do Vaultwarden)
# origem da telemetria = máquina + instância (#22)
# OUTE_HOST=oute-mac               # nome da máquina; sem ele: hostname da máquina (OUTE_HOSTNAME antigo ainda vale)
# OUTE_INSTANCE=oute-agent         # só precisa ser único dentro da máquina
OUTE_SSH_PORT=2222
OUTE_SSH_BIND=127.0.0.1           # interface do sshd do container; NUNCA 0.0.0.0 em host com IP público (#17)
OUTE_SSH_AUTHORIZED_KEYS=~/.ssh/id_ed25519.pub
OUTE_BW_CLIENT_FILE=~/.oute/bw_client.env
OUTE_AGENTS=claude-code,codex
# OUTE_AGENT_YOLO=1                # 1 = Claude/Codex sem prompts de aprovação dentro do container; 0 = padrão
# --- rede (#230): se 172.19.0.0/16 já estiver em uso, configure uma subnet alternativa.
# Sem OUTE_NET_IP_RANGE, a metade alta da /16 é derivada automaticamente (a.b.0.0/16 → a.b.128.0/17).
# OUTE_NET_SUBNET=172.29.0.0/16     # subnet da rede docker (padrão: 172.19.0.0/16)
# OUTE_NET_GATEWAY=172.29.0.1       # gateway da rede docker (padrão: 172.19.0.1)
# OUTE_NET_IP_RANGE=172.29.128.0/17 # range dinâmico de IPs (derivado automaticamente se subnet é /16)
# OUTE_AGENT_IP=172.29.0.5          # IP fixo do agent; deve estar fora do OUTE_NET_IP_RANGE
OUTE_BUCKET=oute-shared
OUTE_SHARED_CACHE=2G             # teto do cache local do rclone mount
OUTE_OCI_BUDGET_EMAIL=           # e-mail dos alertas do budget OCI (oute oci-bootstrap)
OUTE_VAULT_HOST_IP=100.66.254.24  # IP Tailscale do oute-server (vhost do vault só escuta lá)
OUTE_OTELCOL_VERSION=0.161.0      # imagem otel/opentelemetry-collector-contrib (observabilidade, #13)
# OUTE_AI_MEMORY_VERSION=2.5.2    # servidor ai-memory; o cliente no agent segue o ARG AI_MEMORY_VERSION do Dockerfile
OUTE_BUILD_CACHE_TTL=24h          # cache de build (só p/ build local) sem uso há mais que isso é apagado (#8)
# OUTE_BUILD_LOCAL=1              # `oute up` constrói localmente em vez de puxar do ghcr
# agent-studio (ADR-08): só no oute-server. Liga o serviço agent-studio (ingestão OTLP -> DuckDB). Credenciais do
# vault (#256): item agent-studio da pasta oute-services (AGENT_STUDIO_INGEST_TOKEN e AGENT_STUDIO_SURREAL_PASS, só
# para os serviços) e item agent-studio da pasta oute-agent (AGENT_STUDIO_READ_TOKEN, só leitura). No Mac, deixe
# desligado.
# OUTE_AGENT_STUDIO=1
# OUTE_AGENT_STUDIO_PORT=8430      # porta em 127.0.0.1 (nunca 0.0.0.0); o nginx do vhost na tailnet aponta aqui
# OUTE_AGENT_STUDIO_MEM=2g         # mem_limit do agent-studio
# OUTE_SURREALDB_MEM=1g            # mem_limit do SurrealDB (obrigatório: o cache do RocksDB mede pela RAM visível)
