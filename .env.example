# Variáveis do HOST lidas pelo compose (nenhuma é segredo; segredos vêm do Vaultwarden)
# origem da telemetria = máquina + instância (#22)
# OUTE_HOST=oute-mac               # nome da máquina; sem ele: hostname da máquina (OUTE_HOSTNAME antigo ainda vale)
# OUTE_INSTANCE=oute-agent         # só precisa ser único dentro da máquina
OUTE_SSH_PORT=2222
OUTE_SSH_BIND=127.0.0.1           # interface do sshd do container; NUNCA 0.0.0.0 em host com IP público (#17)
OUTE_SSH_AUTHORIZED_KEYS=~/.ssh/id_ed25519.pub
OUTE_BW_CLIENT_FILE=~/.oute/bw_client.env
OUTE_AGENTS=pi,claude-code,codex
# OUTE_AB_MODE=off                 # A/B #15: off | split (50/50 por conversa) | auto
# OUTE_AB_AUTO_SHARE=0.5
# OUTE_AGENT_YOLO=1                # 1 = Claude/Codex sem prompts de aprovação dentro do container; 0 = padrão
OUTE_BUCKET=oute-shared
OUTE_SHARED_CACHE=2G             # teto do cache local do rclone mount
OUTE_OCI_BUDGET_EMAIL=           # e-mail dos alertas do budget OCI (oute oci-bootstrap)
OUTE_VAULT_HOST_IP=100.66.254.24  # IP Tailscale do oute-server (vhost do vault só escuta lá)
OUTE_OTELCOL_VERSION=0.161.0      # imagem otel/opentelemetry-collector-contrib (observabilidade, #13)
# OUTE_LITELLM_IMAGE=ghcr.io/berriai/litellm:<tag>@sha256:<digest>   # padrão: digest fixo no compose (litellm 1.103.0)
# OUTE_AI_MEMORY_VERSION=2.4.1    # servidor ai-memory; o cliente no agent segue o ARG AI_MEMORY_VERSION do Dockerfile
OUTE_BUILD_CACHE_TTL=24h          # cache de build (só p/ build local) sem uso há mais que isso é apagado (#8)
# OUTE_BUILD_LOCAL=1              # `oute up` constrói localmente em vez de puxar do ghcr
