#!/usr/bin/env bash
# release <x.y.z> — bump VERSION, monta a seção do CHANGELOG com os fragmentos de changelog.d/ (#121), commit
# e tag anotada. Não faz push. Roda também no bash 3.2 do macOS.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NEW="${1:-}"
[[ "$NEW" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || { echo "uso: release x.y.z" >&2; exit 2; }
cd "$ROOT"
# #9: hooks do repo ativos (pre-commit reaplica +x) e nenhum script sem +x no git
[[ "$(git config core.hooksPath || true)" == .githooks ]] || git config core.hooksPath .githooks
bad="$(bash scripts/exec-files | while read -r f; do [[ "$(git ls-files -s -- "$f" | cut -d' ' -f1)" == 100755 ]] || echo "$f"; done)"
[[ -z "$bad" ]] || { echo "sem +x no git: $bad — rode ./scripts/fix-bridge e commite" >&2; exit 1; }
[[ -z "$(git status --porcelain)" ]] || { echo "working tree sujo" >&2; exit 1; }
git rev-parse -q --verify "refs/tags/v$NEW" >/dev/null && { echo "tag v$NEW já existe" >&2; exit 1; }
grep -q '^## \[Unreleased\]' CHANGELOG.md || { echo "CHANGELOG sem seção [Unreleased]" >&2; exit 1; }

OLD="$(tr -d '[:space:]' < VERSION)"
DATE="$(date +%Y-%m-%d)"
# [Unreleased] + fragmentos -> seção [NEW] - data, com o [Unreleased] vazio; fragmento inválido para aqui, sem mudar nada
scripts/changelog release "$NEW" "$DATE"
printf '%s\n' "$NEW" > VERSION
git add VERSION CHANGELOG.md
# os fragmentos saem no mesmo commit (o changelog.d/README.md fica)
if git ls-files -- changelog.d | grep -q .; then git add -A -- changelog.d; fi
git commit -q -m "chore(release): v$NEW (de $OLD)"
git tag -a "v$NEW" -m "oute-agent v$NEW"
echo "v$NEW criada. Publicar: git push && git push origin v$NEW"
