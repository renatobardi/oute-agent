#!/usr/bin/env bash
# oute — CLI do host (Mac ou LXC) para operar o runtime
#   oute up | down | build | attach | shell | logs | sync-shared | status
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="$(tr -d '[:space:]' < "$ROOT/VERSION")"
export OUTE_VERSION="$VERSION"
# --project-directory: .env e paths relativos resolvem na raiz do repo, não em docker/
COMPOSE=(docker compose --project-directory "$ROOT" -f "$ROOT/docker/compose.yaml")
export OUTE_HOME="${OUTE_HOME:-$HOME/.oute}"
SSH_PORT="${OUTE_SSH_PORT:-2222}"
SSH_HOST="${OUTE_SSH_HOST:-localhost}"

die() { printf 'oute: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "precisa de '$1' no host"; }

# sem bw nativo no host (ex.: sem node), usa o bw da própria imagem
bw() {
  if type -P bw >/dev/null 2>&1; then command bw "$@"; return; fi
  mkdir -p "$OUTE_HOME/bwcli"
  # imagem LOCAL: a da versão atual se já existir, senão a mais nova que houver. Nunca a que ainda não foi
  # baixada — o `oute pull` precisa do bw (token do ghcr no vault) justamente para baixá-la (ovo e galinha).
  local img="ghcr.io/renatobardi/oute-agent:${OUTE_VERSION}"
  docker image inspect "$img" >/dev/null 2>&1 || img="$(docker images ghcr.io/renatobardi/oute-agent --format '{{.Repository}}:{{.Tag}}' | sort -t: -k2 -rV | head -1)"
  [[ -n "$img" ]] || { echo "oute: nenhuma imagem oute-agent local para rodar o bw (instale o bw no host ou rode OUTE_BUILD_LOCAL=1 oute build)" >&2; return 1; }
  docker run --rm -i --pull never --add-host "vault.oute.pro:${OUTE_VAULT_HOST_IP:-100.66.254.24}" \
    -e BW_SESSION -e BW_CLIENTID -e BW_CLIENTSECRET -e BW_PASSWORD \
    -v "$OUTE_HOME/bwcli:/home/oute/.config/Bitwarden CLI" \
    "$img" bw "$@"
}
export -f bw

# --- segredos do host: só o mínimo que o compose precisa antes do agent subir
host_secrets() {
  need jq
  [[ -f "$OUTE_HOME/bw_client.env" ]] || die "crie $OUTE_HOME/bw_client.env com BW_CLIENTID/BW_CLIENTSECRET (chmod 600)"
  # 1 leitura do vault (pasta oute-agent) -> env do host; o compose só repassa o que cada serviço referencia
  # oute-secrets reutiliza a sessão em cache ($OUTE_HOME/bw_session) e só pede a master password se precisar
  export BW_CLIENT_FILE="$OUTE_HOME/bw_client.env"
  local envs; envs="$("$ROOT/scripts/oute-secrets.sh" export)" || die "não consegui ler o vault"
  eval "$envs"
  [[ -n "${OPENROUTER_API_KEY:-}" ]] || die "OPENROUTER_API_KEY ausente no vault"
  export OPENROUTER_API_KEY AI_MEMORY_AUTH_TOKEN="${AI_MEMORY_AUTH_TOKEN:-}"
  export OCI_S3_ACCESS_KEY="${OCI_S3_ACCESS_KEY:-}" OCI_S3_SECRET_KEY="${OCI_S3_SECRET_KEY:-}" \
         OCI_S3_ENDPOINT="${OCI_S3_ENDPOINT:-}" OCI_S3_REGION="${OCI_S3_REGION:-}"
  # Langfuse (item "langfuse": LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY, LANGFUSE_HOST opcional) liga o pipeline de metadados
  if [[ -n "${LANGFUSE_PUBLIC_KEY:-}" && -n "${LANGFUSE_SECRET_KEY:-}" ]]; then
    OUTE_LANGFUSE_AUTH="$(printf '%s:%s' "$LANGFUSE_PUBLIC_KEY" "$LANGFUSE_SECRET_KEY" | base64 | tr -d '\n')"
    export OUTE_LANGFUSE_AUTH OUTE_OTEL_LANGFUSE=langfuse LANGFUSE_HOST="${LANGFUSE_HOST:-https://cloud.langfuse.com}"
  else
    export OUTE_OTEL_LANGFUSE=none
  fi
  # #6: o container dos agentes NÃO recebe acesso ao cofre (sem BW_SESSION, estado do bw ou API key).
  # Recebe só os VALORES da pasta oute-agent, num arquivo 0600 montado como docker secret (read-only).
  # Em disco (não tmpfs) para o container voltar sozinho depois de reboot do host.
  export OUTE_AGENT_ENV_FILE="$OUTE_HOME/agent.env"
  # 1 linha por variável (%q escapa quebras de linha de PEM/JSON) -> o entrypoint valida linha a linha
  local n; ( umask 077
    for n in $(grep -oE '^export [A-Za-z_][A-Za-z0-9_]*' <<<"$envs" | cut -d' ' -f2 | grep -v '^BW_' | sort -u); do
      printf 'export %s=%q\n' "$n" "${!n}"
    done > "$OUTE_AGENT_ENV_FILE.tmp" && mv "$OUTE_AGENT_ENV_FILE.tmp" "$OUTE_AGENT_ENV_FILE" )
}

router_sync() {
  [[ -n "${OPENROUTER_API_KEY:-}" ]] || {
    export BW_CLIENT_FILE="$OUTE_HOME/bw_client.env"
    OPENROUTER_API_KEY="$("$ROOT/scripts/oute-secrets.sh" get OPENROUTER_API_KEY)" || die "OPENROUTER_API_KEY ausente no vault"
    export OPENROUTER_API_KEY
  }
  # #16: Management key (pasta oute-admin do vault) só para ler o guardrail; opcional, nunca vai ao container dos agentes
  [[ -n "${OPENROUTER_MGMT_KEY:-}" ]] || OPENROUTER_MGMT_KEY="$(OUTE_VAULT_FOLDER=oute-admin "$ROOT/scripts/oute-secrets.sh" get OPENROUTER_MGMT_KEY 2>/dev/null || true)"
  export OPENROUTER_MGMT_KEY
  docker run --rm -e OPENROUTER_API_KEY -e OPENROUTER_MGMT_KEY -v "$ROOT:/w" -w /w --user "$(id -u):$(id -g)" \
    --entrypoint python3 "${OUTE_LITELLM_IMAGE:-ghcr.io/berriai/litellm:main-latest@sha256:114aca7726c311915c8ea5120fcc44d32a0648c3ae3aec41a1014f0e846b16d1}" scripts/router_sync.py "$@"
}

# gerados pelo router-sync; sem eles o compose montaria diretórios vazios
router_files_ok() {
  local f; for f in router.yaml config.yaml candidates.json; do [[ -s "$ROOT/config/litellm/$f" ]] || return 1; done
}

# router-sync diário às 04:00 (hora do host); idempotente, chamado em todo `up`
schedule_sync() {
  command -v crontab >/dev/null || { echo "crontab ausente; agende router-sync manualmente" >&2; return 0; }
  local line="0 4 * * * cd $ROOT && ./scripts/oute router-sync >> $OUTE_HOME/router-sync.log 2>&1"
  # sem crontab prévio, `crontab -l` e `grep -v` retornam != 0; com pipefail+errexit isso mataria o `up` em silêncio
  { crontab -l 2>/dev/null || true; } | { grep -v 'oute router-sync' || true; } | { cat; echo "$line"; } | crontab -
}

# sshd só sobe no fim do entrypoint (segredos, configs); espera o banner SSH pra `attach` logo depois não falhar
wait_sshd() {
  local i banner
  for i in $(seq 1 60); do
    # sem timeout(1) (não existe no macOS, #3): read -t limita a espera pelo banner
    banner="$(bash -c "exec 3<>/dev/tcp/$SSH_HOST/$SSH_PORT && read -r -t 2 -n 7 b <&3 && printf %s \"\$b\"" 2>/dev/null || true)"
    [[ "$banner" == SSH-2.0 ]] && { echo "sshd pronto (${i}s)"; return 0; }
    sleep 1
  done
  echo "sshd não respondeu em 60s; veja: oute logs agent" >&2; return 1
}

# uid/gid do usuário do container (fixo na imagem, lab#181)
CONTAINER_UID=10001

ensure_dirs() {
  mkdir -p "$OUTE_HOME/shared"
  # lab#181: o container só recebe um caminho do host se for o mount rclone (mount_shared exporta).
  # Sem mount: volume docker "oute-shared" (compose), nada gravável pelo container na home do host.
  # (export explícito: a env do shell vence o .env, que em hosts antigos ainda tem OUTE_SHARED_DIR=~/.oute/shared)
  export OUTE_SHARED_DIR=oute-shared
  # .env antigo: variáveis que não são mais usadas
  local v; for v in OUTE_UID OUTE_SHARED_DIR; do
    grep -qE "^[[:space:]]*$v=" "$ROOT/.env" 2>/dev/null \
      && echo "aviso: $v no .env é ignorado desde a 0.7.3 (lab#181); pode remover a linha" >&2
  done
  return 0
}

# --- storage comum: bucket OCI via rclone (ADR-03, #1)
# remote "oci" definido só por env (credenciais do item oci-storage no vault) -> nenhum rclone.conf com segredo
oci_remote_env() {
  local v; for v in OCI_S3_ACCESS_KEY OCI_S3_SECRET_KEY OCI_S3_ENDPOINT OCI_S3_REGION; do
    [[ -n "${!v:-}" ]] || { export BW_CLIENT_FILE="$OUTE_HOME/bw_client.env"; eval "$("$ROOT/scripts/oute-secrets.sh" export)"; break; }
  done
  [[ -n "${OCI_S3_ACCESS_KEY:-}" ]] || return 1
  export RCLONE_CONFIG=/dev/null   # remote só por env; evita o NOTICE "rclone.conf not found"
  export RCLONE_CONFIG_OCI_TYPE=s3 RCLONE_CONFIG_OCI_PROVIDER=Other \
    RCLONE_CONFIG_OCI_ACCESS_KEY_ID="$OCI_S3_ACCESS_KEY" RCLONE_CONFIG_OCI_SECRET_ACCESS_KEY="$OCI_S3_SECRET_KEY" \
    RCLONE_CONFIG_OCI_ENDPOINT="$OCI_S3_ENDPOINT" RCLONE_CONFIG_OCI_REGION="$OCI_S3_REGION" \
    RCLONE_CONFIG_OCI_FORCE_PATH_STYLE=true RCLONE_CONFIG_OCI_NO_CHECK_BUCKET=true
}

# mountpoint(1) não existe no macOS
is_mounted() { mount | grep -q " on $1 "; }

mount_shared() {
  local dir="$OUTE_HOME/shared" bucket="${OUTE_BUCKET:-oute-shared}"
  command -v rclone >/dev/null || { echo "rclone ausente no host; /data/shared fica local"; return 0; }
  is_mounted "$dir" && { export OUTE_SHARED_DIR="$dir"; echo "storage: $dir já montado"; return 0; }
  oci_remote_env || { echo "item oci-storage ausente no vault (rode: oute oci-bootstrap); /data/shared fica local"; return 0; }
  local extra=()
  if [[ "$(uname)" == Linux ]]; then
    # docker (root) precisa enxergar o mount FUSE do usuário
    grep -q '^user_allow_other' /etc/fuse.conf 2>/dev/null || { echo "falta 'user_allow_other' em /etc/fuse.conf (ver README); /data/shared fica local" >&2; return 0; }
    extra+=(--allow-other)
  fi
  mkdir -p "$dir" "$OUTE_HOME/rclone-cache"
  # cache longo = poucas requests (franquia Always Free: 50 mil/mês)
  # dono = usuário do container (grava); grupo = usuário do host (também grava, umask 002). FUSE de usuário
  # já é nosuid/nodev e o rclone não cria symlink -> o container não planta nada executável no host (lab#181)
  # ${extra[@]+...}: array vazio + set -u quebra no bash 3.2 do macOS (#3)
  rclone mount "oci:$bucket" "$dir" --daemon ${extra[@]+"${extra[@]}"} \
    --uid "$CONTAINER_UID" --gid "$(id -g)" --umask 002 \
    --vfs-cache-mode full --vfs-cache-max-size "${OUTE_SHARED_CACHE:-2G}" --vfs-cache-max-age 24h \
    --dir-cache-time 5m --cache-dir "$OUTE_HOME/rclone-cache" \
    --log-file "$OUTE_HOME/rclone.log" --log-level NOTICE \
    || { echo "rclone mount falhou (ver $OUTE_HOME/rclone.log); /data/shared fica local" >&2; return 0; }
  export OUTE_SHARED_DIR="$dir"
  echo "storage: oci:$bucket montado em $dir"
}

umount_shared() {
  local dir="$OUTE_HOME/shared"
  is_mounted "$dir" || return 0
  fusermount -u "$dir" 2>/dev/null || umount "$dir" 2>/dev/null || true
  echo "storage: $dir desmontado"
}

IMAGE="ghcr.io/renatobardi/oute-agent:${OUTE_VERSION}"

# imagem vem do CI (#2): login no ghcr com token só de leitura (vault: item github, campo GHCR_TOKEN) e pull
oute_pull() {
  local tok="${GHCR_TOKEN:-}"
  if [[ -z "$tok" ]]; then
    export BW_CLIENT_FILE="$OUTE_HOME/bw_client.env"
    tok="$("$ROOT/scripts/oute-secrets.sh" get GHCR_TOKEN 2>/dev/null || true)"
  fi
  [[ -n "$tok" ]] || die "GHCR_TOKEN ausente no vault (item github): token clássico com read:packages"
  printf '%s' "$tok" | docker login ghcr.io -u "${GHCR_USER:-renatobardi}" --password-stdin >/dev/null 2>&1 || die "login no ghcr falhou"
  local rc=0; docker pull -q "$IMAGE" || rc=$?
  # token só vive no vault: não deixa credencial em texto puro no ~/.docker/config.json
  docker logout ghcr.io >/dev/null 2>&1 || true
  [[ $rc -eq 0 ]] || die "imagem $IMAGE não existe no ghcr (o CI da tag v$OUTE_VERSION terminou?)"
  prune_local
}

# retenção local (mesma regra do ghcr): só a versão atual + a anterior do agent.
# Sem build local, o build cache é lixo puro (chegou a 5,5 GB) — limpa tudo.
prune_local() {
  local repo="${IMAGE%:*}" old
  old="$(docker images "$repo" --format '{{.Tag}}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+' | sort -rV | tail -n +3)"
  for t in $old; do [[ "$t" == "$OUTE_VERSION" ]] || docker rmi "$repo:$t" >/dev/null 2>&1 || true; done
  [[ "${OUTE_BUILD_LOCAL:-0}" == 1 ]] || docker builder prune -af >/dev/null 2>&1 || true
}

# no up: usa a imagem local; senão puxa do ghcr; build local só se OUTE_BUILD_LOCAL=1
ensure_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 && return 0
  if [[ "${OUTE_BUILD_LOCAL:-0}" == 1 ]]; then "$0" build; else oute_pull; fi
}

oci_bootstrap() {
  export BW_CLIENT_FILE="$OUTE_HOME/bw_client.env"
  "$ROOT/scripts/oute-secrets.sh" get OPENROUTER_API_KEY >/dev/null   # garante sessão desbloqueada em cache
  BW_SESSION="$(<"$OUTE_HOME/bw_session")"; export BW_SESSION
  docker run --rm -i --add-host "vault.oute.pro:${OUTE_VAULT_HOST_IP:-100.66.254.24}" \
    -e BW_SESSION -e DRY_RUN -e OUTE_OCI_BUDGET_EMAIL -e OUTE_OCI_SVC_EMAIL -e OUTE_BUCKET \
    -v "$OUTE_HOME/bwcli:/home/oute/.config/Bitwarden CLI" -v "$ROOT/scripts:/opt/oute-scripts:ro" \
    --entrypoint bash "ghcr.io/renatobardi/oute-agent:${OUTE_VERSION}" /opt/oute-scripts/oci-bootstrap.sh "$@"
}

case "${1:-}" in
  build)
    docker buildx version >/dev/null 2>&1 || echo "aviso: sem docker-buildx (Ubuntu: apt install docker-buildx; Mac: vem no Docker Desktop/OrbStack)" >&2
    # sem attestation de proveniência: não há registry ainda (#2) e ela só acrescenta um manifesto a cada export
    BUILDX_NO_DEFAULT_ATTESTATIONS=1 "${COMPOSE[@]}" build "${@:2}"
    # retenção (#12) SEM matar o cache usado agora: remove só o que não é usado há OUTE_BUILD_CACHE_TTL (default 72h).
    # (--max-used-space com -a apagava também o cache recente -> rebuild de 7 min; sem -a não apagava nada)
    docker builder prune -af --filter "until=${OUTE_BUILD_CACHE_TTL:-24h}" >/dev/null 2>&1 || true
    docker image prune -f >/dev/null 2>&1 || true
    docker system df --format '{{.Type}}: {{.Size}}' 2>/dev/null | grep -E '^(Images|Build Cache)' | tr '\n' ' '; echo
    df -h / | awk 'NR==2 {print "disco /: " $5 " usado (" $4 " livre)"}'
    ;;
  up)
    host_secrets; ensure_dirs; mount_shared
    # catálogo do router sempre fresco; se o OpenRouter falhar, segue com o último gerado
    router_sync || { router_files_ok && echo "router-sync falhou; usando catálogo anterior" >&2 || die "router-sync falhou e não há catálogo gerado"; }
    schedule_sync
    ensure_image
    "${COMPOSE[@]}" up -d --no-build "${@:2}"; "$0" status; wait_sshd
    # imagem antiga só fica "solta" depois que o container é recriado -> limpa aqui (retenção, #12)
    docker image prune -f >/dev/null 2>&1 || true
    ;;
  down)    "${COMPOSE[@]}" down "${@:2}"; umount_shared ;;
  restart) "$0" down; "$0" up ;;
  logs)    "${COMPOSE[@]}" logs --tail=100 "${@:2}" ;;
  follow)  "${COMPOSE[@]}" logs -f "${@:2}" ;;
  status)  "${COMPOSE[@]}" ps ;;
  attach)  exec ssh -p "$SSH_PORT" -t "oute@$SSH_HOST" 'herdr attach 2>/dev/null || herdr' ;;
  ssh)     # com comando: -t quando há terminal (CLIs como `pi -p` leem stdin se não for TTY e ficam esperando EOF)
           if [[ $# -gt 1 ]]; then t=(); [[ -t 0 ]] && t=(-t)
             exec ssh ${t[@]+"${t[@]}"} -p "$SSH_PORT" "oute@$SSH_HOST" bash -lc "$(printf '%q ' "${@:2}")"
           else exec ssh -p "$SSH_PORT" "oute@$SSH_HOST"; fi ;;
  shell)   exec docker exec -it oute-agent bash -l ;;
  sync-shared) mount_shared ;;
  oci-bootstrap) oci_bootstrap "${@:2}" ;;
  pull)    oute_pull ;;
  storage)   # acesso direto ao bucket, sem passar pelo mount: oute storage ls | lsl | about | <qualquer subcomando rclone>
    oci_remote_env || die "item oci-storage ausente no vault (rode: oute oci-bootstrap)"
    sub="${2:-ls}"; rclone "$sub" "oci:${OUTE_BUCKET:-oute-shared}${3:+/$3}" "${@:4}" ;;   # DRY_RUN=1 oute oci-bootstrap pra só ver o que faria
  lock)    "$ROOT/scripts/oute-secrets.sh" lock ;;
  router-sync)
    # consulta OpenRouter (modelos elegíveis pela key/guardrail) e regenera config do router a partir de policy.yaml
    rc=0; router_sync "${@:2}" || rc=$?
    # só a checagem do guardrail (#16): nada foi gravado, não reinicia; devolve 0/2/1
    [[ " ${*:2} " == *" --check-guardrail "* ]] && exit "$rc"
    (( rc == 0 )) || exit "$rc"
    if [[ " ${*:2} " != *" --dry-run "* ]] && docker ps -q -f name=oute-jev-router | grep -q .; then
      "${COMPOSE[@]}" restart jev-router agent >/dev/null && echo "jev-router e agent reiniciados"
    fi
    ;;
  schedule) schedule_sync; echo "agendado: router-sync diário 04:00 (log: $OUTE_HOME/router-sync.log)" ;;
  version)
    echo "repo:    $VERSION ($(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo '?'))"
    img="$(docker inspect -f '{{index .Config.Labels "org.opencontainers.image.version"}}' oute-agent 2>/dev/null || true)"
    echo "running: ${img:-não está rodando}"
    ;;
  *)
    cat <<EOF
uso: oute <cmd>
  pull         baixa a imagem da versão atual do ghcr (feita pelo CI na tag)
  build        constrói a imagem localmente (fallback; normal é o CI) (arm64; mantém cache usado nas últimas 72h)
  up           sobe agent + jev-router + ai-memory + otel-collector (pede master password do Vaultwarden)
  down|restart
  attach       ssh -> herdr
  ssh [cmd]    ssh direto no container
  shell        docker exec bash
  logs [svc] | follow [svc]
  status
  sync-shared  monta bucket OCI em ~/.oute/shared via rclone (credencial: item oci-storage do vault)
  storage [ls|lsl|about] [path]  lista o bucket direto no OCI (confere o que o mount enviou)
  oci-bootstrap  provisiona compartment/buckets/IAM/budget no OCI e grava a chave S3 no vault [DRY_RUN=1]
  lock         apaga a sessão do Vaultwarden em cache (próximo up pede a master password)
  router-sync  consulta OpenRouter e regenera router.yaml/config.yaml a partir de policy.yaml [--dry-run]
               (roda sozinho em todo `up`)
  schedule     agenda router-sync diário (crontab do host, 04:00) — `up` já faz isso
  version      versão do repo e da imagem em execução
EOF
    ;;
esac
