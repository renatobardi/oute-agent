#!/usr/bin/env bash
# oute — CLI do host (Mac ou LXC) para operar o runtime
#   oute up | down | build | attach | shell | logs | sync-shared | status
set -euo pipefail

# resolve symlinks (oute instalado em ~/.local/bin etc. aponta pra cá); sem readlink -f (macOS antigo)
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do _dir="$(cd "$(dirname "$_src")" && pwd)"; _src="$(readlink "$_src")"; [[ "$_src" == /* ]] || _src="$_dir/$_src"; done
ROOT="$(cd "$(dirname "$_src")/.." && pwd)"; unset _src _dir
VERSION="$(tr -d '[:space:]' < "$ROOT/VERSION")"
export OUTE_VERSION="$VERSION"
# --project-directory: .env e paths relativos resolvem na raiz do repo, não em docker/
COMPOSE=(docker compose --project-directory "$ROOT" -f "$ROOT/docker/compose.yaml")
export OUTE_HOME="${OUTE_HOME:-$HOME/.oute}"
SSH_PORT="${OUTE_SSH_PORT:-2222}"
SSH_HOST="${OUTE_SSH_HOST:-localhost}"

die() { printf 'oute: %s\n' "$*" >&2; exit 1; }

# --- origem da telemetria = máquina + instância (#22). A instância só precisa ser única DENTRO da máquina.
# valor do .env sem carregá-lo inteiro (o compose lê o .env; aqui só o que o script precisa decidir)
env_get() { sed -n "s/^[[:space:]]*$1=//p" "$ROOT/.env" 2>/dev/null | sed "s/[[:space:]]*#.*//; s/^[\"']//; s/[\"']\$//" | tail -1; }
# nome seguro para partição do bucket: minúsculo, [a-z0-9_-], até 40
slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' | sed 's/^-*//; s/-*$//' | cut -c1-40; }
# máquina: OUTE_HOST > OUTE_HOSTNAME (nome antigo, mesmo papel) > hostname da máquina
OUTE_HOST="$(slug "${OUTE_HOST:-$(env_get OUTE_HOST)}")"
[[ -n "$OUTE_HOST" ]] || OUTE_HOST="$(slug "${OUTE_HOSTNAME:-$(env_get OUTE_HOSTNAME)}")"
[[ -n "$OUTE_HOST" ]] || OUTE_HOST="$(slug "$(hostname -s 2>/dev/null || hostname)")"
OUTE_INSTANCE="$(slug "${OUTE_INSTANCE:-$(env_get OUTE_INSTANCE)}")"; OUTE_INSTANCE="${OUTE_INSTANCE:-oute-agent}"
export OUTE_HOST OUTE_INSTANCE
need() { command -v "$1" >/dev/null || die "precisa de '$1' no host"; }

# sem bw nativo no host (ex.: sem node), usa o bw da própria imagem
bw() {
  if type -P bw >/dev/null 2>&1; then command bw "$@"; return; fi
  mkdir -p "$OUTE_HOME/bwcli"
  # imagem LOCAL: a da versão atual se já existir, senão a mais nova que houver. Nunca a que ainda não foi
  # baixada — o `oute pull` precisa do bw (token do ghcr no vault) justamente para baixá-la (ovo e galinha).
  local img="ghcr.io/renatobardi/oute-agent:${OUTE_VERSION}"
  docker image inspect "$img" >/dev/null 2>&1 || img="$(docker images ghcr.io/renatobardi/oute-agent --format '{{.Repository}}:{{.Tag}}' | sort -t: -k2 -rV | head -1)"
  [[ -n "$img" ]] || { echo "oute: nenhuma imagem oute-agent local para rodar o bw (instale o bw no host ou rode OUTE_BUILD_LOCAL=1 oute build)" >&2; return 1; }
  # roda com o uid do HOST (não o 10001 da imagem, lab#181): o estado do bw em $OUTE_HOME/bwcli é do usuário do host
  docker run --rm -i --pull never --add-host "vault.oute.pro:${OUTE_VAULT_HOST_IP:-100.66.254.24}" \
    --user "$(id -u):$(id -g)" -e HOME=/tmp -e BITWARDENCLI_APPDATA_DIR=/bwcli \
    -e BW_SESSION -e BW_CLIENTID -e BW_CLIENTSECRET -e BW_PASSWORD \
    -v "$OUTE_HOME/bwcli:/bwcli" \
    "$img" bw "$@"
}
export -f bw

# --- segredos do host (#21): ~/.oute/agent.env é o cache. O vault só é aberto quando o segredo muda
# (`oute up --refresh-secrets` / `oute secrets refresh`) ou em comando admin, com a master password, e a
# sessão é trancada logo depois (nada de sessão do Vaultwarden em disco).
AGENT_ENV_FILE="$OUTE_HOME/agent.env"
# --- segredo de serviço (#256): a pasta oute-services do vault vai para services.env (0600), que só o host lê e só
# os serviços (agent-studio, surrealdb, otel-collector) recebem, pela interpolação do compose. Nunca é montado no
# agent nem entra no agent.env.
SERVICES_ENV_FILE="$OUTE_HOME/services.env"
SERVICES_FOLDER="${OUTE_VAULT_SERVICES_FOLDER:-oute-services}"
# nomes de serviço conhecidos: nunca ficam no agent.env, venham de onde vierem (transição: pasta oute-services
# ainda não criada, item ainda na pasta oute-agent, agent.env gravado por versão antiga). AGENT_STUDIO_TOKEN é o
# token único de antes da #256 (ingestão + leitura).
# OPENROUTER_MEMORY_API_KEY (#459) é a chave do proxy do LLM do ai-memory: só ele a recebe.
# AGENT_STUDIO_MARK_TOKEN (#510) é a credencial de marcação das ações da página da rodada: só o agent-studio a recebe (o `agent`
# tem a de leitura e alcança o studio pela rede docker; se a marcação aceitasse a leitura, aceitaria o agente).
SERVICE_SECRET_NAMES="AGENT_STUDIO_SURREAL_PASS AGENT_STUDIO_INGEST_TOKEN AGENT_STUDIO_TOKEN OPENROUTER_MEMORY_API_KEY AGENT_STUDIO_MARK_TOKEN"

# fallback de quem precisa de um segredo e não o tem no ambiente: só o agent.env, nunca o vault
load_agent_env() {
  [[ -s "$AGENT_ENV_FILE" ]] || return 0
  # shellcheck disable=SC1090
  . "$AGENT_ENV_FILE"
}
load_services_env() {
  [[ -s "$SERVICES_ENV_FILE" ]] || return 0
  # shellcheck disable=SC1090
  . "$SERVICES_ENV_FILE"
}
no_secret() { die "$1 ausente em $AGENT_ENV_FILE; rode: oute secrets refresh${2:+ ($2)}"; }

# nomes das variáveis de uma saída do `oute-secrets export`, sem BW_*, um por linha
env_names() { grep -oE '^export [A-Za-z_][A-Za-z0-9_]*' <<<"$1" | cut -d' ' -f2 | grep -v '^BW_' | sort -u || true; }
# write_env_file <arquivo> <nomes…>: 1 linha `export NOME=<%q>` por variável (%q escapa quebras de linha de
# PEM/JSON) -> o entrypoint valida linha a linha. 0600, troca atômica.
write_env_file() {
  local f="$1" n; shift
  ( umask 077
    for n in "$@"; do printf 'export %s=%q\n' "$n" "${!n}"; done > "$f.tmp" && mv "$f.tmp" "$f" )
}
# env_file_drop <arquivo> <nomes…>: tira as linhas desses nomes (1 linha por variável; só este script escreve o arquivo)
env_file_drop() {
  local f="$1" pat; shift
  pat="^export ($(printf '%s' "$*" | tr ' ' '|'))="
  ( umask 077; { grep -vE "$pat" "$f" || true; } > "$f.tmp" && mv "$f.tmp" "$f" )
}

# --- sessão do vault aberta por este processo (#297): trancada na saída, qualquer que seja o caminho (fim normal,
# erro no meio, Ctrl+C, kill). VAULT_OWN=1 = há sessão nossa para trancar; sessão recebida de quem chama não é nossa.
VAULT_OWN=0
vault_lock() {
  (( VAULT_OWN )) || return 0
  VAULT_OWN=0
  bw lock >/dev/null 2>&1 || true
  unset BW_SESSION
}
# abre a sessão (master password) só no ambiente deste processo. Os traps entram antes de abrir: abertura que falha
# ou é interrompida depois do desbloqueio também tranca. Sinal: tranca e sai com 128+n.
vault_open() {
  trap vault_lock EXIT
  trap 'vault_lock; exit 129' HUP
  trap 'vault_lock; exit 130' INT
  trap 'vault_lock; exit 143' TERM
  VAULT_OWN=1
  BW_SESSION="$("$ROOT/scripts/oute-secrets.sh" session)" || die "não consegui abrir o vault"
  export BW_SESSION
}

# 1 leitura do vault (pastas oute-agent e oute-services, uma senha só) -> agent.env e services.env. A sessão é
# aberta aqui e trancada ao fim; com BW_SESSION já aberta pelo chamador (oci-bootstrap), usa essa e não tranca.
vault_to_agent_env() {
  need jq
  [[ -f "$OUTE_HOME/bw_client.env" ]] || die "crie $OUTE_HOME/bw_client.env com BW_CLIENTID/BW_CLIENTSECRET (chmod 600)"
  export BW_CLIENT_FILE="$OUTE_HOME/bw_client.env"
  local own=0 envs="" svc="" rc=0 src=0 n names=()
  if [[ -z "${BW_SESSION:-}" ]]; then vault_open; own=1; fi
  echo "lendo o Vaultwarden (pastas ${OUTE_VAULT_FOLDER:-oute-agent} e $SERVICES_FOLDER)…" >&2
  envs="$("$ROOT/scripts/oute-secrets.sh" export)" || rc=$?
  # pasta de serviço: rc 4 = a pasta não existe (transição); outro erro não vira "sem pasta"
  [[ $rc -ne 0 ]] || svc="$(OUTE_VAULT_FOLDER="$SERVICES_FOLDER" "$ROOT/scripts/oute-secrets.sh" export)" || src=$?
  # leitura feita (ou falha): tranca já, sem esperar a saída; o trap cobre o que sair antes daqui
  (( ! own )) || vault_lock
  [[ $rc -eq 0 ]] || die "não consegui ler o vault"
  case "$src" in
    0) ;;
    4) svc=""
       echo "aviso: a pasta $SERVICES_FOLDER não existe no vault (#256). Os segredos de serviço que ainda estão na" \
         "pasta ${OUTE_VAULT_FOLDER:-oute-agent} seguem só para os serviços, fora do arquivo do agent. Crie a pasta," \
         "mova os itens e rode: oute secrets refresh" >&2 ;;
    *) die "não consegui ler a pasta $SERVICES_FOLDER do vault" ;;
  esac
  # #6: o container dos agentes NÃO recebe acesso ao cofre (sem BW_SESSION, estado do bw ou API key).
  # Recebe só os VALORES da pasta oute-agent, num arquivo 0600 montado como docker secret (read-only).
  # Em disco (não tmpfs) para o container voltar sozinho depois de reboot do host.
  # #256: nome que existe na pasta de serviço nunca entra no arquivo do agent, mesmo repetido na oute-agent.
  local svc_names; svc_names=" $(env_names "$svc" | tr '\n' ' ')"
  eval "$envs"
  for n in $(env_names "$envs"); do [[ "$svc_names" == *" $n "* ]] || names+=("$n"); done
  write_env_file "$AGENT_ENV_FILE" ${names[@]+"${names[@]}"}
  echo "agent.env regravado ($AGENT_ENV_FILE)" >&2
  # services.env sempre regravado (sem a pasta, vazio: o service_secrets_split põe nele o que achar no agent.env)
  eval "$svc"
  # shellcheck disable=SC2086
  write_env_file "$SERVICES_ENV_FILE" $svc_names
  echo "services.env regravado ($SERVICES_ENV_FILE)" >&2
}

# #256: os nomes de serviço conhecidos saem do agent.env em todo `up`, com ou sem leitura do vault (o agent.env em
# cache de uma versão antiga também é limpo). O valor vai para o services.env quando ele ainda não tem o nome; o da
# pasta oute-services vence. Só nomes na mensagem, nunca valores.
service_secrets_split() {
  [[ -s "$AGENT_ENV_FILE" ]] || return 0
  local n found="" pat
  for n in $SERVICE_SECRET_NAMES; do
    grep -q "^export $n=" "$AGENT_ENV_FILE" && found="$found${found:+ }$n"
  done
  [[ -n "$found" ]] || return 0
  # primeiro guarda, depois tira: se cair no meio, nenhum valor se perde
  ( umask 077
    { [[ ! -e "$SERVICES_ENV_FILE" ]] || cat "$SERVICES_ENV_FILE"
      for n in $found; do
        grep -q "^export $n=" "$SERVICES_ENV_FILE" 2>/dev/null || grep "^export $n=" "$AGENT_ENV_FILE" | tail -1
      done; } > "$SERVICES_ENV_FILE.tmp" && mv "$SERVICES_ENV_FILE.tmp" "$SERVICES_ENV_FILE" )
  # shellcheck disable=SC2086
  env_file_drop "$AGENT_ENV_FILE" $found
  echo "aviso: segredo de serviço fora do arquivo do agent (#256): $found estava em $AGENT_ENV_FILE (pasta" \
    "${OUTE_VAULT_FOLDER:-oute-agent} do vault) e agora fica só em $SERVICES_ENV_FILE, que o agent não recebe." \
    "Mova o item para a pasta $SERVICES_FOLDER do vault e rode: oute secrets refresh" >&2
}

# só o mínimo que o compose precisa antes do agent subir; $1=1 força a releitura do vault
host_secrets() {
  # resto das versões <= 0.7.x: sessão em cache em disco
  if [[ -e "$OUTE_HOME/bw_session" ]]; then
    "$ROOT/scripts/oute-secrets.sh" lock >/dev/null 2>&1 || true
    rm -f "$OUTE_HOME/bw_session"
  fi
  # o que vale é o que está nos arquivos: nome de serviço herdado do ambiente de quem chamou não conta
  local n; for n in $SERVICE_SECRET_NAMES AGENT_STUDIO_READ_TOKEN; do unset "$n"; done
  if [[ "${1:-0}" == 1 || ! -s "$AGENT_ENV_FILE" ]]; then vault_to_agent_env; fi
  service_secrets_split
  load_agent_env; load_services_env
  # credencial de leitura igual à de ingestão daria a ingestão ao agent: não vai ao arquivo dele (#256)
  local ingest="${AGENT_STUDIO_INGEST_TOKEN:-${AGENT_STUDIO_TOKEN:-}}"
  if [[ -n "${AGENT_STUDIO_READ_TOKEN:-}" && "$AGENT_STUDIO_READ_TOKEN" == "$ingest" ]]; then
    env_file_drop "$AGENT_ENV_FILE" AGENT_STUDIO_READ_TOKEN; unset AGENT_STUDIO_READ_TOKEN
    echo "aviso: AGENT_STUDIO_READ_TOKEN é igual à credencial de ingestão do agent-studio: tirado do arquivo do" \
      "agent (#256). Gere um valor próprio para a leitura no vault e rode: oute secrets refresh" >&2
  fi
  export OUTE_AGENT_ENV_FILE="$AGENT_ENV_FILE"
  export AI_MEMORY_AUTH_TOKEN="${AI_MEMORY_AUTH_TOKEN:-}"
  export OCI_S3_ACCESS_KEY="${OCI_S3_ACCESS_KEY:-}" OCI_S3_SECRET_KEY="${OCI_S3_SECRET_KEY:-}" \
         OCI_S3_ENDPOINT="${OCI_S3_ENDPOINT:-}" OCI_S3_REGION="${OCI_S3_REGION:-}"
}

# --- agent-studio (ADR-08, #185): só no host que o liga com OUTE_AGENT_STUDIO=1 no .env (o oute-server; no Mac
# fica desligado). Duas credenciais (#256, ADR-08 §6): a de ingestão (AGENT_STUDIO_INGEST_TOKEN) e a senha root do
# SurrealDB (AGENT_STUDIO_SURREAL_PASS, #187) são do item agent-studio da pasta oute-services, via services.env, e
# vão só aos serviços; a de leitura (AGENT_STUDIO_READ_TOKEN) é do item agent-studio da pasta oute-agent, via
# agent.env, e é a única que o agent recebe.
STUDIO_PROFILE=agent-studio
# destino do collector (#190) e de onde o agent lê (#259): no host com o agent-studio, a rede docker; nos outros
# (Mac), o vhost só na tailnet (lab#244), com a mesma credencial de ingestão. OUTE_AGENT_STUDIO_URL no .env troca o vhost.
STUDIO_LOCAL_URL=http://agent-studio:8430
STUDIO_REMOTE_URL=https://agent-studio.oute.pro
agent_studio_enabled() { [[ "${OUTE_AGENT_STUDIO:-$(env_get OUTE_AGENT_STUDIO)}" == 1 ]]; }
# `oute up`: liga o profile do compose quando o host tem o agent-studio e as credenciais existem; sem o item, avisa
# e sobe o resto (nunca bloqueia a subida). Junto, o pipeline do collector ao agent-studio
# (config/otel/agent-studio.yaml, #189): pela rede docker no host com o agent-studio, pelo vhost nos outros (#190).
# Sem a credencial de ingestão, none.yaml e o collector não muda (a fila não enche de 401).
# Pasta do host para os dados do agent-studio (#570): OUTE_AGENT_STUDIO_DIR (DuckDB) e OUTE_SURREALDB_DIR, no .env ou no
# ambiente. Pasta errada para a subida: o Docker criaria uma pasta vazia e o agent-studio subiria com um banco novo,
# como se o histórico tivesse sumido. Sem a variável, o compose usa o volume docker.
studio_data_dir() {
  local var="$1" dir
  dir="${!var:-$(env_get "$var" || true)}"   # sem .env, o env_get falha sob pipefail
  [[ -n "$dir" ]] || return 0
  [[ "$dir" == /* ]] || { echo "oute: $var=$dir precisa ser um caminho absoluto" >&2; return 1; }
  [[ -d "$dir" ]] || { echo "oute: $var=$dir não existe. Crie a pasta e copie os dados antes de subir (o agent-studio" \
    "não pode subir com um banco vazio no lugar do histórico)" >&2; return 1; }
  local owner; owner="$(stat -c %u "$dir" 2>/dev/null || stat -f %u "$dir")"
  [[ "$owner" == "${CONTAINER_UID:-10001}" ]] || { echo "oute: $var=$dir tem dono $owner; o dono precisa ser" \
    "${CONTAINER_UID:-10001} (o usuário do container)" >&2; return 1; }
  export "$var=$dir"
}
agent_studio_up() {
  export OUTE_OTEL_STUDIO=none AGENT_STUDIO_URL="$STUDIO_LOCAL_URL"
  # transição (#256): sem a credencial nova, a ingestão segue com o token único de antes
  if [[ -z "${AGENT_STUDIO_INGEST_TOKEN:-}" && -n "${AGENT_STUDIO_TOKEN:-}" ]]; then
    AGENT_STUDIO_INGEST_TOKEN="$AGENT_STUDIO_TOKEN"
    echo "aviso: transição (#256): a ingestão do agent-studio segue com o AGENT_STUDIO_TOKEN antigo. Crie" \
      "AGENT_STUDIO_INGEST_TOKEN no item agent-studio da pasta $SERVICES_FOLDER do vault e rode: oute up --refresh-secrets" >&2
  fi
  # o nome antigo não segue para o compose: os serviços recebem só as duas credenciais novas
  unset AGENT_STUDIO_TOKEN
  if ! agent_studio_enabled; then
    # o vhost vale mesmo sem a credencial de ingestão: o agent lê por ele, com a de leitura (ops-observe, #259)
    AGENT_STUDIO_URL="${OUTE_AGENT_STUDIO_URL:-$(env_get OUTE_AGENT_STUDIO_URL || true)}"
    export AGENT_STUDIO_URL="${AGENT_STUDIO_URL:-$STUDIO_REMOTE_URL}"
    if [[ -z "${AGENT_STUDIO_INGEST_TOKEN:-}" ]]; then
      echo "aviso: AGENT_STUDIO_INGEST_TOKEN não está em $SERVICES_ENV_FILE (item agent-studio da pasta" \
        "$SERVICES_FOLDER do vault). O collector não manda ao agent-studio do oute-server; crie o item e rode:" \
        "oute up --refresh-secrets" >&2
      return 0
    fi
    export AGENT_STUDIO_INGEST_TOKEN OUTE_OTEL_STUDIO=agent-studio
    return 0
  fi
  studio_data_dir OUTE_AGENT_STUDIO_DIR
  studio_data_dir OUTE_SURREALDB_DIR
  local v falta=""
  for v in AGENT_STUDIO_INGEST_TOKEN AGENT_STUDIO_SURREAL_PASS; do [[ -n "${!v:-}" ]] || falta="$falta${falta:+ }$v"; done
  if [[ -n "$falta" ]]; then
    echo "aviso: OUTE_AGENT_STUDIO=1, mas $falta não está em $SERVICES_ENV_FILE (item agent-studio da pasta" \
      "$SERVICES_FOLDER do vault). O agent-studio não sobe; crie o item e rode: oute up --refresh-secrets" >&2
    return 0
  fi
  if [[ -z "${AGENT_STUDIO_READ_TOKEN:-}" ]]; then
    echo "aviso: AGENT_STUDIO_READ_TOKEN não está em $AGENT_ENV_FILE (item agent-studio da pasta" \
      "${OUTE_VAULT_FOLDER:-oute-agent} do vault). O agent-studio sobe com uma credencial só: a tela e o tray leem" \
      "com a de ingestão e o agent fica sem leitura; crie o campo e rode: oute up --refresh-secrets" >&2
  fi
  # credencial de marcação (#510): opcional. Sem ela o agent-studio sobe igual, sem `POST /rodada/acao` (a rota não existe)
  if [[ -z "${AGENT_STUDIO_MARK_TOKEN:-}" ]]; then
    echo "nota: AGENT_STUDIO_MARK_TOKEN não está em $SERVICES_ENV_FILE (item agent-studio da pasta $SERVICES_FOLDER do vault)." \
      "O agent-studio sobe sem marcação de ações: as caixas da página da rodada ficam só para leitura. Para ligar, crie o campo" \
      "e rode: oute up --refresh-secrets" >&2
  fi
  export AGENT_STUDIO_INGEST_TOKEN AGENT_STUDIO_SURREAL_PASS AGENT_STUDIO_READ_TOKEN="${AGENT_STUDIO_READ_TOKEN:-}" \
    AGENT_STUDIO_MARK_TOKEN="${AGENT_STUDIO_MARK_TOKEN:-}" OUTE_OTEL_STUDIO=agent-studio
  COMPOSE_PROFILES="${COMPOSE_PROFILES:+$COMPOSE_PROFILES,}$STUDIO_PROFILE"
  export COMPOSE_PROFILES
}

# --- proxy do LLM do ai-memory (#459, ADR-08 adendo): o serviço llm-proxy do compose (profile llm-proxy) é a única porta do
# ai-memory para o OpenRouter e emite o consumo ao collector. Sobe nos dois hosts (oute-server e Mac) quando o
# services.env tem OPENROUTER_MEMORY_API_KEY (campo do item openrouter-memoria da pasta oute-services do vault). A chave
# é só dele: o compose a interpola só no serviço llm-proxy, nunca no agent nem no ai-memory. Sem a chave, sobe o resto
# (o ai-memory segue sem LLM, como hoje) e a nota diz como ligar. Nunca bloqueia a subida.
LLM_PROXY_PROFILE=llm-proxy
llm_proxy_up() {
  if [[ -z "${OPENROUTER_MEMORY_API_KEY:-}" ]]; then
    echo "nota: OPENROUTER_MEMORY_API_KEY não está em $SERVICES_ENV_FILE (item openrouter-memoria da pasta" \
      "$SERVICES_FOLDER do vault): o proxy do LLM do ai-memory não sobe e o ai-memory segue sem LLM" >&2
    unset OPENROUTER_MEMORY_API_KEY
    return 0
  fi
  export OPENROUTER_MEMORY_API_KEY
  COMPOSE_PROFILES="${COMPOSE_PROFILES:+$COMPOSE_PROFILES,}$LLM_PROXY_PROFILE"
  export COMPOSE_PROFILES
}

# --- restos do roteador de modelos, que saiu do stack na #218 (ADR-02, Histórico). Chamado em todo `up` e `down`;
# idempotente: host sem os restos não muda. Os padrões levam [-] para o nome antigo não voltar a aparecer no repo.
legacy_cleanup() {
  # entrada diária (04:00) que as versões <= 0.7.30 punham no crontab do host. Só regrava se a entrada existe;
  # crontab que ficaria vazio é removido (como estava antes da entrada)
  if command -v crontab >/dev/null; then
    local cur new
    cur="$(crontab -l 2>/dev/null || true)"
    if grep -q 'oute router[-]sync' <<<"$cur"; then
      new="$(grep -v 'oute router[-]sync' <<<"$cur" || true)"
      if [[ -n "$new" ]]; then printf '%s\n' "$new" | crontab -; else crontab -r; fi
      echo "crontab: entrada diária do roteador removida (#218)" >&2
    fi
  fi
  # container do serviço que saiu do compose: ficaria órfão, de pé e preso à rede (o `down` não removeria a rede)
  if docker ps -aq -f 'name=^oute-jev[-]router$' 2>/dev/null | grep -q .; then
    docker rm -f "$(docker ps -aq -f 'name=^oute-jev[-]router$')" >/dev/null 2>&1 \
      && echo "container do roteador removido (#218)" >&2 \
      || echo "aviso: não consegui remover o container do roteador (#218); remova à mão com docker rm -f" >&2
  fi
  # pasta dos gerados do roteador no checkout (#271): saiu do repo e do .gitignore, os gerados ficaram não rastreados
  # e sujam a árvore. Só sai inteira se nada nela está no índice (rastreado, modificado ou staged); fora de um
  # checkout git não há como saber, então fica
  local rel="config/lite""llm"
  if [[ -d "$ROOT/$rel" ]] && command -v git >/dev/null && git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    if [[ -n "$(git -C "$ROOT" ls-files -- "$rel" 2>/dev/null)" ]]; then
      echo "aviso: $rel tem arquivo rastreado; não removi a pasta do roteador (#271)" >&2
    elif rm -rf "${ROOT:?}/$rel"; then
      echo "checkout: pasta $rel do roteador removida (#271)" >&2
    else
      echo "aviso: não consegui remover $rel do checkout (#271); remova à mão" >&2
    fi
  fi
  return 0
}

# sshd só sobe no fim do entrypoint (segredos, configs); espera o banner SSH pra `attach` logo depois não falhar
wait_sshd() {
  local i banner
  for i in $(seq 1 60); do
    # sem timeout(1) (não existe no macOS, #3): read -t limita a espera pelo banner
    banner="$(bash -c "exec 3<>/dev/tcp/$SSH_HOST/$SSH_PORT && read -r -t 2 -n 7 b <&3 && printf %s \"\$b\"" 2>/dev/null || true)"
    [[ "$banner" == SSH-2.0 ]] && { echo "sshd pronto (${i}s)"; return 0; }
    sleep 1
  done
  echo "sshd não respondeu em 60s; veja: oute logs agent" >&2; return 1
}

# uid/gid do usuário do container (fixo na imagem, lab#181)
CONTAINER_UID=10001

ensure_dirs() {
  mkdir -p "$OUTE_HOME/shared"
  # lab#181: o container só recebe um caminho do host se for o mount rclone (mount_shared exporta).
  # Sem mount: volume docker "oute-shared" (compose), nada gravável pelo container na home do host.
  # (export explícito: a env do shell vence o .env, que em hosts antigos ainda tem OUTE_SHARED_DIR=~/.oute/shared)
  export OUTE_SHARED_DIR=oute-shared
  # chave pública do host para o sshd do container: se não existir, o Docker cria um DIRETÓRIO vazio no lugar
  # e o entrypoint entra em loop de restart (visto no Mac, #3)
  local pub="${OUTE_SSH_AUTHORIZED_KEYS:-$(sed -n 's/^[[:space:]]*OUTE_SSH_AUTHORIZED_KEYS=//p' "$ROOT/.env" 2>/dev/null | sed 's/[[:space:]]*#.*//' | tail -1)}"
  pub="${pub:-$HOME/.ssh/id_ed25519.pub}"; pub="${pub/#\~/$HOME}"
  [[ -f "$pub" ]] || die "chave pública $pub não existe (ou virou diretório vazio criado pelo Docker: rmdir). Gere com ssh-keygen -t ed25519 ou aponte OUTE_SSH_AUTHORIZED_KEYS no .env"
  # .env antigo: variáveis que não são mais usadas
  local v; for v in OUTE_UID OUTE_SHARED_DIR; do
    grep -qE "^[[:space:]]*$v=" "$ROOT/.env" 2>/dev/null \
      && echo "aviso: $v no .env é ignorado desde a 0.7.3 (lab#181); pode remover a linha" >&2
  done
  return 0
}

# --- storage comum: bucket OCI via rclone (ADR-03, #1)
# remote "oci" definido só por env (credenciais do item oci-storage, via agent.env) -> nenhum rclone.conf com segredo
oci_remote_env() {
  local v; for v in OCI_S3_ACCESS_KEY OCI_S3_SECRET_KEY OCI_S3_ENDPOINT OCI_S3_REGION; do
    [[ -n "${!v:-}" ]] || { load_agent_env; break; }
  done
  [[ -n "${OCI_S3_ACCESS_KEY:-}" ]] || return 1
  export RCLONE_CONFIG=/dev/null   # remote só por env; evita o NOTICE "rclone.conf not found"
  export RCLONE_CONFIG_OCI_TYPE=s3 RCLONE_CONFIG_OCI_PROVIDER=Other \
    RCLONE_CONFIG_OCI_ACCESS_KEY_ID="$OCI_S3_ACCESS_KEY" RCLONE_CONFIG_OCI_SECRET_ACCESS_KEY="$OCI_S3_SECRET_KEY" \
    RCLONE_CONFIG_OCI_ENDPOINT="$OCI_S3_ENDPOINT" RCLONE_CONFIG_OCI_REGION="$OCI_S3_REGION" \
    RCLONE_CONFIG_OCI_FORCE_PATH_STYLE=true RCLONE_CONFIG_OCI_NO_CHECK_BUCKET=true
}

# --- oute studio replay (#159, ADR-08 §7): reenvia objetos do bucket de telemetria à ingestão do agent-studio, pelo
# mesmo caminho do collector (dedupe da ingestão; um escritor só no DuckDB). Só no host com o agent-studio: lista e
# baixa com o rclone do `oute storage` (só leitura no bucket) e passa cada objeto por `docker exec -i` ao
# `agent_studio.replay`, que usa a credencial de ingestão do ambiente do próprio serviço (nunca argv, nunca log).
# bash 3.2: sem mapfile, sem ${v,,}; data em UTC por aritmética (o `date` do macOS não tem -d).
replay_usage() {
  cat >&2 <<'EOF2'
uso: oute studio replay --from <ISO> --to <ISO> [--signal logs|traces|metrics] [--host <máquina>] [--legacy]
  --from/--to   faixa pela hora de chegada (a partição do bucket), em UTC: 2026-10-01 ou 2026-10-01T12[:30[:00]][Z];
                vale a partição de hora que cruza a faixa com 1 h de folga de cada lado
  --signal      um sinal só (padrão: os três)
  --host        só os objetos de host=<máquina>
  --legacy      inclui os objetos sem host= (anteriores à 0.7.5)
EOF2
}
# iso_to_epoch <ISO em UTC> -> segundos desde a época; vazio e rc 1 se não for uma data válida
iso_to_epoch() {
  local s="${1%Z}" y m d H=0 M=0 S=0 era yoe doy doe
  local re_d='^([0-9]{4})-([0-9]{2})-([0-9]{2})$'
  local re_t='^([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2})(:([0-9]{2})(:([0-9]{2}))?)?$'
  if [[ "$s" =~ $re_d ]]; then
    y="${BASH_REMATCH[1]}"; m="${BASH_REMATCH[2]}"; d="${BASH_REMATCH[3]}"
  elif [[ "$s" =~ $re_t ]]; then
    y="${BASH_REMATCH[1]}"; m="${BASH_REMATCH[2]}"; d="${BASH_REMATCH[3]}"; H="${BASH_REMATCH[4]}"
    M="${BASH_REMATCH[6]:-0}"; S="${BASH_REMATCH[8]:-0}"
  else
    return 1
  fi
  y=$((10#$y)); m=$((10#$m)); d=$((10#$d)); H=$((10#$H)); M=$((10#$M)); S=$((10#$S))
  (( m >= 1 && m <= 12 && d >= 1 && d <= 31 && H < 24 && M < 60 && S < 60 && y >= 1970 && y <= 2262 )) || return 1
  # dias desde 1970-01-01 (calendário civil proléptico)
  (( m <= 2 )) && y=$((y - 1))
  era=$((y / 400)); yoe=$((y - era * 400))
  doy=$(( (153 * (m > 2 ? m - 3 : m + 9) + 2) / 5 + d - 1 ))
  doe=$((yoe * 365 + yoe / 4 - yoe / 100 + doy))
  echo $(( (era * 146097 + doe - 719468) * 86400 + H * 3600 + M * 60 + S ))
}
studio_replay() {
  local from="" to="" signals="logs traces metrics" host="" legacy=0
  agent_studio_enabled \
    || die "oute studio replay só roda no host com o agent-studio (OUTE_AGENT_STUDIO=1 no .env, o oute-server); a credencial de ingestão não existe fora dele"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from)   from="${2:-}"; shift 2 || { replay_usage; exit 2; } ;;
      --to)     to="${2:-}"; shift 2 || { replay_usage; exit 2; } ;;
      --signal) signals="${2:-}"; shift 2 || { replay_usage; exit 2; } ;;
      --host)   host="${2:-}"; shift 2 || { replay_usage; exit 2; } ;;
      --legacy) legacy=1; shift ;;
      *) echo "oute: opção desconhecida: $1" >&2; replay_usage; exit 2 ;;
    esac
  done
  [[ -n "$from" && -n "$to" ]] || { echo "oute: --from e --to são obrigatórios" >&2; replay_usage; exit 2; }
  case "$signals" in logs|traces|metrics) ;; "logs traces metrics") ;; *) echo "oute: --signal precisa ser logs, traces ou metrics" >&2; exit 2 ;; esac
  [[ -z "$host" || "$host" =~ ^[a-z0-9_-]+$ ]] || { echo "oute: --host inválido (use o nome da máquina, [a-z0-9_-])" >&2; exit 2; }
  local from_s to_s
  from_s="$(iso_to_epoch "$from")" || { echo "oute: --from inválido: use ISO 8601 em UTC (ex.: 2026-10-01 ou 2026-10-01T12:00:00Z)" >&2; exit 2; }
  to_s="$(iso_to_epoch "$to")" || { echo "oute: --to inválido: use ISO 8601 em UTC (ex.: 2026-10-01 ou 2026-10-01T12:00:00Z)" >&2; exit 2; }
  (( from_s < to_s )) || { echo "oute: --from precisa ser antes de --to" >&2; exit 2; }
  need rclone; need docker
  docker ps -q -f name='^oute-agent-studio$' -f status=running | grep -q . \
    || die "o container oute-agent-studio não está de pé (oute up)"
  oci_remote_env || die "item oci-storage ausente no vault (rode: oute oci-bootstrap)"
  local bucket="${OUTE_OBSERVABILITY_BUCKET:-oute-observability}" sig key rc=0 tmp
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/oute-replay.XXXXXX")" || die "não criei a pasta temporária"
  REPLAY_TMP="$tmp"; trap 'rm -rf "${REPLAY_TMP:?}"' EXIT
  for sig in $signals; do
    local nread=0 written=0 duplicate=0 failed=0 skipped=0 lsrc=0
    rclone lsf -R --files-only "oci:$bucket/otel/$sig" >"$tmp/all" 2>"$tmp/err" || lsrc=$?
    if [[ "$lsrc" == 3 ]]; then : >"$tmp/all"   # prefixo sem nenhum objeto
    elif [[ "$lsrc" != 0 ]]; then
      echo "$sig: não consegui listar oci:$bucket/otel/$sig (rclone rc $lsrc)" >&2; rc=1; continue
    fi
    LC_ALL=C sort "$tmp/all" >"$tmp/list"
    local re_part='year=([0-9]{4})/month=([0-9]{2})/day=([0-9]{2})/hour=([0-9]{2})/' re_host='(^|/)host=([^/]+)/'
    while IFS= read -r key; do
      [[ "$key" == *.gz ]] || continue
      local obj_host="" part_s
      if [[ "$key" =~ $re_host ]]; then obj_host="${BASH_REMATCH[2]}"; fi
      if [[ -z "$obj_host" ]]; then [[ "$legacy" == 1 ]] || continue
      elif [[ -n "$host" && "$obj_host" != "$host" ]]; then continue; fi
      [[ "$key" =~ $re_part ]] || { skipped=$((skipped + 1)); continue; }
      part_s="$(iso_to_epoch "${BASH_REMATCH[1]}-${BASH_REMATCH[2]}-${BASH_REMATCH[3]}T${BASH_REMATCH[4]}")" \
        || { skipped=$((skipped + 1)); continue; }
      # a partição cobre [part_s, part_s + 1 h); entra se cruza [from - 1 h, to + 1 h)
      (( part_s + 3600 > from_s - 3600 && part_s < to_s + 3600 )) || continue
      nread=$((nread + 1)); key="otel/$sig/$key"   # o lsf lista relativo ao prefixo do sinal
      if ! rclone copyto --retries 2 "oci:$bucket/$key" "$tmp/obj" >/dev/null 2>"$tmp/err"; then
        echo "$sig: objeto ilegível, pulado (Archive? restaure antes: ADR-08 §7): $key" >&2
        failed=$((failed + 1)); rm -f "$tmp/obj"; continue
      fi
      local out orc=0 w d f
      out="$(docker exec -i oute-agent-studio /opt/agent-studio/venv/bin/python -m agent_studio.replay "$sig" <"$tmp/obj")" || orc=$?
      rm -f "$tmp/obj"
      if [[ "$out" =~ ^written=([0-9]+)\ duplicate=([0-9]+)\ failed=([0-9]+)$ ]]; then
        w="${BASH_REMATCH[1]}"; d="${BASH_REMATCH[2]}"; f="${BASH_REMATCH[3]}"
        written=$((written + w)); duplicate=$((duplicate + d))
        if [[ "$orc" != 0 || "$f" != 0 ]]; then failed=$((failed + 1)); echo "$sig: falhou no replay: $key" >&2; fi
      else
        failed=$((failed + 1)); echo "$sig: falhou no replay (rc $orc): $key" >&2
      fi
    done <"$tmp/list"
    [[ "$skipped" == 0 ]] || echo "$sig: $skipped objeto(s) sem partição de hora no caminho, ignorados" >&2
    printf '%s: objetos lidos=%d gravados=%d repetidos=%d falharam=%d\n' "$sig" "$nread" "$written" "$duplicate" "$failed"
    [[ "$failed" == 0 ]] || rc=1
  done
  return "$rc"
}

# --- oute studio rebuild-state (#345, ADR-08 §7): remonta o estado do SurrealDB (pedidos, rodadas, sessões) a partir
# dos logs e spans do DuckDB, sem ler o bucket. Para o agent-studio (o DuckDB aceita um escritor só), roda o one-off
# `agent_studio.rebuild_state` na mesma imagem e no mesmo ambiente do serviço (as credenciais vêm do compose, nunca de
# argv nem de log) e sobe o serviço de novo, qualquer que seja o resultado. Enquanto ele está parado, o collector
# segura a ingestão na fila em disco (ADR-08 §7). Só no host com o agent-studio.
studio_rebuild_state() {
  agent_studio_enabled \
    || die "oute studio rebuild-state só roda no host com o agent-studio (OUTE_AGENT_STUDIO=1 no .env, o oute-server)"
  need docker
  host_secrets 0; agent_studio_up
  [[ ",${COMPOSE_PROFILES:-}," == *",$STUDIO_PROFILE,"* ]] \
    || die "o agent-studio não está configurado (credenciais ausentes no services.env, aviso acima): oute up --refresh-secrets"
  docker ps -q -f name='^oute-surrealdb$' -f status=running | grep -q . \
    || die "o container oute-surrealdb não está de pé (oute up)"
  echo "parando o agent-studio (a ingestão fica na fila do collector)..."
  "${COMPOSE[@]}" stop agent-studio >/dev/null || die "não consegui parar o agent-studio"
  local rc=0 up=0
  "${COMPOSE[@]}" run --rm --no-deps -T --entrypoint /opt/agent-studio/venv/bin/python agent-studio \
    -m agent_studio.rebuild_state || rc=$?
  echo "subindo o agent-studio de novo..."
  "${COMPOSE[@]}" up -d --no-build --no-deps agent-studio >/dev/null || up=1
  if [[ "$up" != 0 ]]; then echo "oute: o agent-studio não subiu de novo: rode oute up" >&2; return 1; fi
  [[ "$rc" == 0 ]] || echo "oute: rebuild-state falhou (rc $rc); o que já entrou fica e rodar de novo termina" >&2
  return "$rc"
}

# --- oute studio backup (#570): cópia de segurança do DuckDB do agent-studio. O banco guarda tudo, sem retenção, e só o
# próprio agent-studio abre o arquivo: a cópia consistente sai de dentro dele (`python -m agent_studio.backup`, no
# container) e vai por pipe ao bucket de telemetria (o mesmo do bruto; nunca o oute-shared, que o agent monta e onde
# qualquer sessão leria e apagaria o banco inteiro). Nada passa pelo disco do host. Confere o tamanho no bucket antes de
# apagar a cópia local, e só então roda a retenção por origem (host + instância). `--check <nome>` baixa uma cópia por
# pipe ao container, que a abre só para leitura num temporário e conta as linhas. bash 3.2: sem mapfile.
STBK_DIR=backups/agent-studio
STBK_CONTAINER=oute-agent-studio
STBK_PY=/opt/agent-studio/venv/bin/python
STBK_LOCAL=/data/agent-studio/backup
studio_backup_usage() { echo "uso: oute studio backup | oute studio backup --check <nome da cópia no bucket | latest>" >&2; }
studio_backup_bucket() { printf '%s' "${OUTE_STUDIO_BACKUP_BUCKET:-${OUTE_OBSERVABILITY_BUCKET:-oute-observability}}"; }
# nome;bytes de cada cópia no bucket; vazio se a pasta não existe (rclone rc 3)
studio_backup_list() {
  local rc=0
  rclone lsf --files-only --format ps --separator ';' "oci:$(studio_backup_bucket)/$STBK_DIR" 2>/dev/null || rc=$?
  [[ "$rc" == 0 || "$rc" == 3 ]]
}
studio_backup_ready() {
  agent_studio_enabled \
    || die "oute studio backup só roda no host com o agent-studio (OUTE_AGENT_STUDIO=1 no .env, o oute-server)"
  need docker; need rclone
  docker ps -q -f name="^$STBK_CONTAINER\$" -f status=running | grep -q . \
    || die "o container $STBK_CONTAINER não está de pé (oute up)"
  oci_remote_env || die "item oci-storage ausente no vault (rode: oute oci-bootstrap)"
}
# `"chave": valor` de uma linha JSON simples (a resposta do serviço), sem jq
studio_backup_field() { sed -n "s/.*\"$1\": *\"\{0,1\}\([A-Za-z0-9._-]*\).*/\1/p" <<<"$2" | head -n 1; }
studio_backup_rows() {
  local t n out=""
  for t in spans logs metrics; do n="$(studio_backup_field "$t" "$1")"; out="$out${out:+, }$t ${n:-?}"; done
  printf '%s' "$out"
}
studio_backup() {
  local keep="${OUTE_STUDIO_BACKUP_KEEP:-7}"
  [[ "$keep" =~ ^[1-9][0-9]*$ ]] || { echo "oute: OUTE_STUDIO_BACKUP_KEEP precisa ser um inteiro >= 1 (veio '$keep')" >&2; exit 2; }
  # bloco do envio: o padrão do rclone (5 MiB x 10000 partes) limita o arquivo a 48,8 GiB, e o banco não tem retenção;
  # 64 MiB dá 625 GiB (custa ~256 MB de RAM no host durante o envio)
  local chunk="${OUTE_STUDIO_BACKUP_CHUNK:-64Mi}"
  [[ "$chunk" =~ ^[1-9][0-9]*(Mi|Gi)$ ]] || { echo "oute: OUTE_STUDIO_BACKUP_CHUNK precisa ser um tamanho como 64Mi ou 1Gi" >&2; exit 2; }
  studio_backup_ready
  local bucket out rc=0 file bytes name list line tsize
  bucket="$(studio_backup_bucket)"
  echo "cópia do DuckDB no container $STBK_CONTAINER (a ingestão segue gravando)..."
  out="$(docker exec "$STBK_CONTAINER" "$STBK_PY" -m agent_studio.backup)" || rc=$?
  if [[ "$rc" == 3 ]]; then echo "oute: já há uma cópia em andamento no agent-studio; tente depois" >&2; exit 3; fi
  [[ "$rc" == 0 ]] || die "a cópia falhou no agent-studio (rc $rc); nada foi enviado"
  file="$(studio_backup_field file "$out")"; bytes="$(studio_backup_field bytes "$out")"
  [[ "$file" =~ ^agent-studio-[0-9]{8}T[0-9]{6}Z\.duckdb$ && "$bytes" =~ ^[1-9][0-9]*$ ]] \
    || die "resposta do agent-studio fora do formato; nada foi enviado"
  name="$OUTE_HOST-$OUTE_INSTANCE-${file#agent-studio-}"
  # do container direto ao bucket (pipefail: falha de qualquer lado conta)
  docker exec "$STBK_CONTAINER" cat "$STBK_LOCAL/$file" | rclone rcat --s3-chunk-size "$chunk" "oci:$bucket/$STBK_DIR/$name" \
    || die "o envio ao bucket $bucket falhou; a cópia segue no container, em $STBK_LOCAL/$file"
  line=""; list="$(studio_backup_list)" && line="$(grep -F "$name;" <<<"$list" | head -n 1)" || line=""
  tsize="${line##*;}"
  [[ "$line" == "$name;"* && "$tsize" == "$bytes" ]] \
    || die "o tamanho no bucket não bate com o da cópia (${tsize:-ausente} x $bytes bytes); a cópia segue no container, em $STBK_LOCAL/$file"
  docker exec "$STBK_CONTAINER" rm -f "$STBK_LOCAL/$file" || echo "aviso: não apaguei a cópia local $STBK_LOCAL/$file" >&2
  echo "backup: oci:$bucket/$STBK_DIR/$name"
  printf 'cópia:  %d bytes (%d MiB) em %s s\n' "$bytes" "$((bytes / 1048576))" "$(studio_backup_field seconds "$out")"
  echo "linhas: $(studio_backup_rows "$out")"
  # retenção: as $keep mais recentes da MESMA origem; nome de outra origem nunca entra
  local re="^$OUTE_HOST-$OUTE_INSTANCE-[0-9]{8}T[0-9]{6}Z\\.duckdb\$" all n f rrc=0
  list="$(studio_backup_list)" || { echo "oute: não consegui listar $STBK_DIR para a retenção; nada apagado" >&2; return 1; }
  all="$(printf '%s\n' "$list" | cut -d';' -f1 | while IFS= read -r f; do if [[ "$f" =~ $re ]]; then printf '%s\n' "$f"; fi; done | LC_ALL=C sort)"
  n="$(printf '%s\n' "$all" | grep -c .)" || n=0
  if (( n > keep )); then
    for f in $(printf '%s\n' "$all" | head -n "$((n - keep))"); do
      [[ "$f" != "$name" ]] || continue
      if rclone deletefile "oci:$bucket/$STBK_DIR/$f" >/dev/null 2>&1; then echo "retenção: apagado $f"
      else echo "oute: retenção: não consegui apagar $f" >&2; rrc=1; fi
    done
  fi
  echo "retenção: $((n > keep ? keep : n)) de $keep cópia(s) de $OUTE_HOST-$OUTE_INSTANCE no bucket"
  return "$rrc"
}
studio_backup_check() {
  local name="$1" bucket list out rc=0 re f
  [[ "$name" == latest || "$name" =~ ^[a-z0-9_-]+-[0-9]{8}T[0-9]{6}Z\.duckdb$ ]] \
    || die "nome fora do formato (<host>-<instância>-<data UTC>.duckdb): use o nome de uma cópia do bucket, ou latest"
  studio_backup_ready
  bucket="$(studio_backup_bucket)"
  list="$(studio_backup_list)" || die "não consegui listar $STBK_DIR no bucket"
  if [[ "$name" == latest ]]; then  # a mais nova desta origem (o nome tem a data UTC: a ordem do texto é a do tempo)
    re="^$OUTE_HOST-$OUTE_INSTANCE-[0-9]{8}T[0-9]{6}Z\\.duckdb\$"
    name="$(printf '%s\n' "$list" | cut -d';' -f1 | while IFS= read -r f; do if [[ "$f" =~ $re ]]; then printf '%s\n' "$f"; fi; done | LC_ALL=C sort | tail -n 1)"
    [[ -n "$name" ]] || die "nenhuma cópia de $OUTE_HOST-$OUTE_INSTANCE em $STBK_DIR no bucket"
  fi
  grep -qF "$name;" <<<"$list" || die "cópia não encontrada no bucket: $STBK_DIR/$name"
  out="$(rclone cat "oci:$bucket/$STBK_DIR/$name" | docker exec -i "$STBK_CONTAINER" "$STBK_PY" -m agent_studio.backup --check)" || rc=$?
  [[ "$rc" == 0 ]] || die "a cópia $name não abre como banco do agent-studio"
  echo "cópia íntegra: oci:$bucket/$STBK_DIR/$name"
  echo "linhas: $(studio_backup_rows "$out")"
}

# --- oute memory-backup (#369): backup do volume oute-memory pelo próprio `ai-memory backup` (wiki + db + config), rodado
# no container agent (o volume está em /data/ai-memory), gravado em /data/shared/backups/ai-memory/ (o bucket oute-shared,
# pelo mount; sem mount cai no volume local) e conferido no bucket com o rclone do `oute storage`. Retenção por origem
# (host + instância). O tarball tem conversa e o config do cliente: nunca passa por log nem por saída do comando; só tamanho,
# contagem e o nome do arquivo. `--check` restaura num diretório temporário do container (nunca no volume) e abre o banco.
# bash 3.2: sem mapfile, sem ${v,,}.
MEMBK_DIR=backups/ai-memory
MEMBK_CONTAINER=oute-agent
# lê o tarball no stdin (nunca vai ao argv nem à saída); só imprime o resumo. O `ai-memory restore` recusa rodar com
# outro ai-memory vivo no container (hooks, MCP) e o `ai-memory status` fala com o servidor, não com o diretório:
# extrai com o tarfile e abre o SQLite do backup direto, só leitura. (função com heredoc, não $(cat <<…): o bash 3.2
# do macOS erra o parse de heredoc dentro de $( ))
memory_backup_check_py() {
  cat <<'PY'
import os, shutil, sqlite3, sys, tarfile, tempfile
d = tempfile.mkdtemp(prefix="oute-memory-check.")
def fail(msg):
    print("falhou: " + msg)
    sys.exit(1)
try:
    try:
        with tarfile.open(fileobj=sys.stdin.buffer, mode="r|gz") as t:
            t.extractall(d, filter="data")
    except Exception as e:
        fail("tarball ilegível (" + type(e).__name__ + ")")
    db = os.path.join(d, "db", "memory.sqlite")
    if not os.path.isfile(db):
        fail("o tarball não tem db/memory.sqlite")
    try:
        c = sqlite3.connect("file:" + db + "?mode=ro", uri=True)
        res = c.execute("PRAGMA integrity_check").fetchone()[0]
        pages = c.execute("SELECT count(*) FROM pages").fetchone()[0]
    except Exception as e:
        fail("o banco não abre (" + type(e).__name__ + ")")
    if res != "ok":
        fail("o banco não está íntegro (integrity_check)")
    if pages < 1:
        fail("o banco abre, mas não tem nenhuma página")
    wiki = sum(len(f) for _, _, f in os.walk(os.path.join(d, "wiki")))
    print("ok: banco íntegro, %d páginas, %d arquivos no wiki" % (pages, wiki))
finally:
    shutil.rmtree(d, ignore_errors=True)
PY
}
memory_backup_usage() { echo "uso: oute memory-backup | oute memory-backup --check <arquivo local ou nome no bucket>" >&2; }
# nome;bytes de cada arquivo de backups/ai-memory no bucket; vazio se a pasta não existe (rclone rc 3)
memory_backup_list() {
  local bucket="${OUTE_BUCKET:-oute-shared}" rc=0
  rclone lsf --files-only --format ps --separator ';' "oci:$bucket/$MEMBK_DIR" 2>/dev/null || rc=$?
  [[ "$rc" == 0 || "$rc" == 3 ]]
}
memory_backup_container_up() {
  docker ps -q -f name="^$MEMBK_CONTAINER\$" -f status=running | grep -q . \
    || die "o container $MEMBK_CONTAINER não está de pé (oute up)"
}
memory_backup() {
  local keep="${OUTE_MEMORY_BACKUP_KEEP:-8}" warn="${OUTE_MEMORY_WARN_MB:-500}" wait_s="${OUTE_MEMORY_BACKUP_WAIT:-60}"
  [[ "$keep" =~ ^[1-9][0-9]*$ ]] || { echo "oute: OUTE_MEMORY_BACKUP_KEEP precisa ser um inteiro >= 1 (veio '$keep')" >&2; exit 2; }
  [[ "$warn" =~ ^[0-9]+$ ]] || { echo "oute: OUTE_MEMORY_WARN_MB precisa ser um inteiro >= 0 (veio '$warn')" >&2; exit 2; }
  [[ "$wait_s" =~ ^[0-9]+$ ]] || { echo "oute: OUTE_MEMORY_BACKUP_WAIT precisa ser um inteiro >= 0 (veio '$wait_s')" >&2; exit 2; }
  need docker; memory_backup_container_up
  local name list cdir="/data/shared/$MEMBK_DIR" log bucket="${OUTE_BUCKET:-oute-shared}" rc=0 dbsize lsize tsize="" line="" waited=0
  name="$OUTE_HOST-$OUTE_INSTANCE-$(date -u +%Y%m%dT%H%M%SZ).tar.gz"
  log="$(mktemp "${TMPDIR:-/tmp}/oute-memory-backup.XXXXXX")" || die "não criei o arquivo temporário"
  # o log do ai-memory só aparece se o backup falhar (sem conteúdo de conversa, mas nada de saída à toa)
  MEMBK_LOG="$log"; trap 'rm -f "${MEMBK_LOG:?}"' EXIT
  echo "ai-memory backup no container $MEMBK_CONTAINER..."
  docker exec "$MEMBK_CONTAINER" sh -c 'mkdir -p "$1" && { ai-memory backup --to "$2" || { rm -f "$2"; exit 1; }; }' _ "$cdir" "$cdir/$name" \
    >"$log" 2>&1 || rc=$?
  if [[ "$rc" != 0 ]]; then tail -n 5 "$log" >&2; die "ai-memory backup falhou (rc $rc); nada foi gravado"; fi
  dbsize="$(docker exec "$MEMBK_CONTAINER" stat -c %s /data/ai-memory/db/memory.sqlite 2>/dev/null)" || dbsize=""
  lsize="$(docker exec "$MEMBK_CONTAINER" stat -c %s "$cdir/$name" 2>/dev/null)" || lsize=""
  [[ "$lsize" =~ ^[0-9]+$ && "$lsize" -gt 0 ]] || die "o backup não deixou arquivo no container ($MEMBK_DIR/$name)"
  if ! command -v rclone >/dev/null || ! oci_remote_env; then
    echo "oute: sem rclone ou sem credencial do bucket neste host: o backup ficou só local, em $cdir/$name (volume oute-shared do container), e não foi conferido no bucket" >&2
    return 1
  fi
  # chegou ao bucket? o mount sobe o arquivo em segundo plano: espera até OUTE_MEMORY_BACKUP_WAIT s
  while :; do
    # a listagem vai para a variável antes do grep: com pipefail, o grep que sai cedo mataria o rclone com SIGPIPE
    line=""; list="$(memory_backup_list)" && line="$(grep -F "$name;" <<<"$list" | head -n 1)" || line=""
    tsize="${line##*;}"
    [[ "$line" == "$name;"* && "$tsize" == "$lsize" ]] && break
    (( waited >= wait_s )) && break
    sleep 2; waited=$((waited + 2))
  done
  if [[ "$line" != "$name;"* || "$tsize" != "$lsize" ]]; then
    echo "oute: o backup não chegou ao bucket $bucket em ${wait_s}s (rclone mount parado? sem mount?): ficou só local, em $cdir/$name" >&2
    return 1
  fi
  echo "backup: oci:$bucket/$MEMBK_DIR/$name"
  printf 'tarball: %d bytes (%d MiB)\n' "$tsize" "$((tsize / 1048576))"
  if [[ "$dbsize" =~ ^[0-9]+$ ]]; then
    printf 'banco:   %d bytes (%d MiB)\n' "$dbsize" "$((dbsize / 1048576))"
    (( dbsize <= warn * 1048576 )) \
      || echo "aviso: o banco passou de ${warn} MB (OUTE_MEMORY_WARN_MB): hora de olhar o que cresce (compact, retenção de observações)" >&2
  else
    echo "aviso: não consegui ler o tamanho do banco" >&2
  fi
  # retenção: os $keep mais recentes da MESMA origem (host + instância); nome de outra origem nunca entra
  local re="^$OUTE_HOST-$OUTE_INSTANCE-[0-9]{8}T[0-9]{6}Z\\.tar\\.gz\$" all n f rrc=0
  list="$(memory_backup_list)" || { echo "oute: não consegui listar $MEMBK_DIR para a retenção; nada apagado" >&2; return 1; }
  all="$(printf '%s\n' "$list" | cut -d';' -f1 | while IFS= read -r f; do if [[ "$f" =~ $re ]]; then printf '%s\n' "$f"; fi; done | LC_ALL=C sort)"
  n="$(printf '%s\n' "$all" | grep -c .)" || n=0
  if (( n > keep )); then
    for f in $(printf '%s\n' "$all" | head -n "$((n - keep))"); do
      [[ "$f" != "$name" ]] || continue
      if rclone deletefile "oci:$bucket/$MEMBK_DIR/$f" >/dev/null 2>&1; then echo "retenção: apagado $f"
      else echo "oute: retenção: não consegui apagar $f" >&2; rrc=1; fi
    done
  fi
  echo "retenção: $((n > keep ? keep : n)) de $keep backup(s) de $OUTE_HOST-$OUTE_INSTANCE no bucket"
  return "$rrc"
}
# --check <arquivo>: arquivo local ou nome (ou backups/ai-memory/<nome>) no bucket. O tarball vai por stdin ao
# python3 do container, que restaura num tmp do container, confere o banco (abre, íntegro, páginas > 0) e apaga o tmp.
memory_backup_check() {
  local src="$1" key list
  need docker; memory_backup_container_up
  if [[ -f "$src" ]]; then
    cat "$src" | docker exec -i "$MEMBK_CONTAINER" python3 -c "$(memory_backup_check_py)"
    return
  fi
  key="${src#"$MEMBK_DIR"/}"
  [[ "$key" =~ ^[A-Za-z0-9._-]+$ ]] || die "arquivo não encontrado: $src (use um arquivo local ou o nome de um backup no bucket)"
  need rclone; oci_remote_env || die "item oci-storage ausente no vault (rode: oute oci-bootstrap)"
  list="$(memory_backup_list)" || die "não consegui listar $MEMBK_DIR no bucket"
  grep -qF "$key;" <<<"$list" || die "backup não encontrado no bucket: $MEMBK_DIR/$key"
  rclone cat "oci:${OUTE_BUCKET:-oute-shared}/$MEMBK_DIR/$key" | docker exec -i "$MEMBK_CONTAINER" python3 -c "$(memory_backup_check_py)"
}

# --- rede (#230): derivação e validação de OUTE_NET_IP_RANGE
# derive_ip_range <subnet>: extrai a metade alta (/17) de uma subnet /16
# Ex.: 172.19.0.0/16 -> 172.19.128.0/17
derive_ip_range() {
  local subnet="$1" prefix
  [[ "$subnet" =~ / ]] || { echo "oute: subnet sem /, esperado <CIDR>: $subnet" >&2; return 1; }
  prefix="${subnet#*/}"
  [[ "$prefix" == 16 ]] || { echo "oute: subnet /$prefix (esperado /16); com outra máscara, defina OUTE_NET_IP_RANGE explícito" >&2; return 1; }
  # octetos da subnet: a.b.0.0/16 -> a.b.128.0/17 (a terceira octetoa passa de 0 para 128)
  local net="${subnet%/*}" a b c d
  IFS=. read -r a b c d <<<"$net" || return 1
  printf '%s.%s.128.0/17\n' "$a" "$b"
}

# ip_to_int <a.b.c.d>: converte IP para número inteiro (bash 3.2 compat)
ip_to_int() {
  local ip="$1" a b c d
  IFS=. read -r a b c d <<<"$ip" || return 1
  # a * 256^3 + b * 256^2 + c * 256 + d = a*16777216 + b*65536 + c*256 + d
  echo $(( a * 16777216 + b * 65536 + c * 256 + d ))
}

# ip_block_size <prefix>: calcula tamanho do bloco para um prefixo /0-32
# /16 = 2^(32-16) = 65536, /17 = 32768, /24 = 256, /21 = 2048, /18 = 16384, etc.
ip_block_size() {
  local prefix="$1"
  # validar: prefixo deve ser 0-32 (inteiro)
  [[ "$prefix" =~ ^[0-9]+$ && $prefix -ge 0 && $prefix -le 32 ]] || \
    { echo "oute: prefixo /$prefix inválido (esperado 0-32)" >&2; return 1; }
  echo $(( 1 << (32 - prefix) ))
}

# validate_net_ip_range <range> <subnet>: verifica se um range está contido em uma subnet
validate_net_ip_range() {
  local range="$1" subnet="$2"
  local range_net="${range%/*}" range_prefix="${range#*/}" subnet_net="${subnet%/*}" subnet_prefix="${subnet#*/}"
  local range_int subnet_int range_start range_end subnet_start subnet_end range_size subnet_size
  # valida prefixos
  range_size="$(ip_block_size "$range_prefix")" || return 1
  subnet_size="$(ip_block_size "$subnet_prefix")" || return 1
  # converte IPs
  range_int="$(ip_to_int "$range_net")" || return 1
  subnet_int="$(ip_to_int "$subnet_net")" || return 1
  # calcula inicio e fim
  range_start="$range_int"
  range_end=$(( range_start + range_size - 1 ))
  subnet_start="$subnet_int"
  subnet_end=$(( subnet_start + subnet_size - 1 ))
  # valida contenção: range deve estar dentro da subnet
  [[ $range_start -ge $subnet_start && $range_end -le $subnet_end ]] || \
    { echo "oute: OUTE_NET_IP_RANGE $range está fora da subnet $subnet" >&2; return 1; }
}

# validate_agent_ip_not_in_range <range> <agent_ip>: verifica se um IP NÃO está dentro de um range
validate_agent_ip_not_in_range() {
  local range="$1" agent_ip="$2"
  local range_net="${range%/*}" range_prefix="${range#*/}"
  local range_int ip_int range_start range_end range_size
  # valida prefixo
  range_size="$(ip_block_size "$range_prefix")" || return 1
  # converte IPs
  range_int="$(ip_to_int "$range_net")" || return 1
  ip_int="$(ip_to_int "$agent_ip")" || return 1
  # calcula inicio e fim
  range_start="$range_int"
  range_end=$(( range_start + range_size - 1 ))
  # IP não deve estar no range dinâmico
  if [[ $ip_int -ge $range_start && $ip_int -le $range_end ]]; then
    echo "oute: OUTE_AGENT_IP $agent_ip está dentro do range $range (dinâmico)" >&2
    return 1
  fi
  return 0
}

# ensure_net_ip_range: valida e deriva OUTE_NET_IP_RANGE antes do compose up
ensure_net_ip_range() {
  local subnet range agent_ip
  # lê do ambiente, depois do .env (com fallback para padrão)
  subnet="${OUTE_NET_SUBNET:-$(env_get OUTE_NET_SUBNET || true)}"
  range="${OUTE_NET_IP_RANGE:-$(env_get OUTE_NET_IP_RANGE || true)}"
  agent_ip="${OUTE_AGENT_IP:-$(env_get OUTE_AGENT_IP || true)}"
  # padrão: subnet=172.19.0.0/16, range=172.19.128.0/17 (sem mudança, nada a fazer)
  [[ -n "$subnet" ]] || subnet="172.19.0.0/16"
  if [[ -z "$range" ]]; then
    # range vazio e subnet definido: derivar
    range="$(derive_ip_range "$subnet")" || return 1
    export OUTE_NET_IP_RANGE="$range"
  fi
  # validações
  validate_net_ip_range "$range" "$subnet" || return 1
  if [[ -n "$agent_ip" ]]; then
    validate_agent_ip_not_in_range "$range" "$agent_ip" || return 1
  fi
}

# mountpoint(1) não existe no macOS
is_mounted() { mount | grep -q " on $1 "; }

mount_shared() {
  local dir="$OUTE_HOME/shared" bucket="${OUTE_BUCKET:-oute-shared}"
  command -v rclone >/dev/null || { echo "rclone ausente no host; /data/shared fica local"; return 0; }
  # mount morto (rclone morreu sem desmontar): desmonta e monta de novo. Só com o erro de mount desconectado
  # (Linux: "Transport endpoint is not connected"; macOS: "Device not configured"): outro erro do ls (bucket
  # fora do ar) não derruba um mount vivo
  local err=""; is_mounted "$dir" && err="$(LC_ALL=C ls "$dir" 2>&1 >/dev/null || true)"
  case "$err" in
    *"not connected"*|*"Device not configured"*)
      echo "storage: mount de $dir sem resposta (rclone caiu); remontando" >&2
      fusermount -uz "$dir" 2>/dev/null || umount "$dir" 2>/dev/null || umount -f "$dir" 2>/dev/null || true
      is_mounted "$dir" && { echo "não consegui desmontar $dir; /data/shared fica sem storage" >&2; return 0; }
      echo "storage: se o container já estava de pé, ele segue com o mount antigo; rode 'oute restart'" >&2 ;;
  esac
  is_mounted "$dir" && { export OUTE_SHARED_DIR="$dir"; echo "storage: $dir já montado"; return 0; }
  # macOS (#114): o rclone do Homebrew sai sem a tag cmount (não faz `mount`) e sem FUSE-T/macFUSE o mount não
  # tem onde se apoiar. Avisa as duas faltas de uma vez, antes das credenciais, e segue com o volume local.
  if [[ "$(uname)" == Darwin ]]; then
    local falta=0 p fuse=0 oldifs="$IFS"
    # IFS só para esta quebra (OUTE_FUSE_PATHS separado por ':'; os padrões têm espaço)
    IFS=:; for p in ${OUTE_FUSE_PATHS-/Library/Application Support/fuse-t:/usr/local/lib/libfuse-t.dylib:/Library/Filesystems/macfuse.fs}; do
      [[ -e "$p" ]] && fuse=1
    done; IFS="$oldifs"
    if ! rclone version 2>/dev/null | grep -Eq 'go/tags:.*cmount'; then
      echo "storage: o rclone do Homebrew não faz 'mount' no macOS (sem a tag cmount)." >&2
      echo "  correção: brew uninstall rclone e instalar o binário oficial de https://rclone.org/downloads/" >&2
      falta=1
    fi
    if [[ "$fuse" -eq 0 ]]; then
      echo "storage: FUSE-T (ou macFUSE) não está instalado; sem ele o rclone não monta." >&2
      echo "  correção: instalar o FUSE-T (https://github.com/macos-fuse-t/fuse-t/releases)" >&2
      falta=1
    fi
    [[ "$falta" -eq 0 ]] || { echo "/data/shared fica local" >&2; return 0; }
  fi
  oci_remote_env || { echo "OCI_S3_* ausente em $AGENT_ENV_FILE (item oci-storage: oute oci-bootstrap; depois oute secrets refresh); /data/shared fica local"; return 0; }
  local extra=()
  if [[ "$(uname)" == Linux ]]; then
    # docker (root) precisa enxergar o mount FUSE do usuário
    grep -q '^user_allow_other' /etc/fuse.conf 2>/dev/null || { echo "falta 'user_allow_other' em /etc/fuse.conf (ver README); /data/shared fica local" >&2; return 0; }
    extra+=(--allow-other)
  fi
  mkdir -p "$dir" "$OUTE_HOME/rclone-cache"
  # cache longo = poucas requests (franquia Always Free: 50 mil/mês)
  # dono = usuário do container (grava); grupo = usuário do host (também grava, umask 002). FUSE de usuário
  # já é nosuid/nodev e o rclone não cria symlink -> o container não planta nada executável no host (lab#181)
  # ${extra[@]+...}: array vazio + set -u quebra no bash 3.2 do macOS (#3)
  # sessão própria: o --daemon do rclone fica no grupo de processos e na sessão do terminal que rodou o
  # oute up/update, e um Ctrl+C ou SIGHUP nele matava o mount (/data/shared "Transport endpoint is not
  # connected"). setsid(1) não existe no macOS: lá segue como antes.
  # stdio no log (#210): o rclone guarda um dup do stderr de quem chamou (fd 7, sem CLOEXEC) e o daemon herda;
  # se esse stderr fosse um pipe (oute up rodado pelo oute approve, `| tee`), o pipe nunca fechava.
  local detach=(); command -v setsid >/dev/null && detach=(setsid -w)
  ${detach[@]+"${detach[@]}"} rclone mount "oci:$bucket" "$dir" --daemon ${extra[@]+"${extra[@]}"} \
    --uid "$CONTAINER_UID" --gid "$(id -g)" --umask 002 \
    --vfs-cache-mode full --vfs-cache-max-size "${OUTE_SHARED_CACHE:-2G}" --vfs-cache-max-age 24h \
    --dir-cache-time 5m --cache-dir "$OUTE_HOME/rclone-cache" \
    --log-file "$OUTE_HOME/rclone.log" --log-level NOTICE </dev/null >>"$OUTE_HOME/rclone.log" 2>&1 \
    || { echo "rclone mount falhou (ver $OUTE_HOME/rclone.log); /data/shared fica local" >&2; return 0; }
  export OUTE_SHARED_DIR="$dir"
  echo "storage: oci:$bucket montado em $dir"
}

umount_shared() {
  local dir="$OUTE_HOME/shared"
  is_mounted "$dir" || return 0
  fusermount -u "$dir" 2>/dev/null || umount "$dir" 2>/dev/null || true
  echo "storage: $dir desmontado"
}

IMAGE="ghcr.io/renatobardi/oute-agent:${OUTE_VERSION}"

# imagem vem do CI (#2): login no ghcr com token só de leitura (vault: item github, campo GHCR_TOKEN) e pull
oute_pull() {
  # #21: só env ou agent.env, nunca o vault
  [[ -n "${GHCR_TOKEN:-}" ]] || load_agent_env
  local tok="${GHCR_TOKEN:-}"
  [[ -n "$tok" ]] || no_secret GHCR_TOKEN "vault: item github, token clássico com read:packages"
  printf '%s' "$tok" | docker login ghcr.io -u "${GHCR_USER:-renatobardi}" --password-stdin >/dev/null 2>&1 || die "login no ghcr falhou"
  local rc=0; docker pull -q "$IMAGE" || rc=$?
  # token só vive no vault: não deixa credencial em texto puro no ~/.docker/config.json
  docker logout ghcr.io >/dev/null 2>&1 || true
  [[ $rc -eq 0 ]] || die "imagem $IMAGE não existe no ghcr (o CI da tag v$OUTE_VERSION terminou?)"
  prune_local
}

# retenção local (mesma regra do ghcr): só a versão atual + a anterior do agent.
# Sem build local, o build cache é lixo puro (chegou a 5,5 GB) — limpa tudo.
prune_local() {
  local repo="${IMAGE%:*}" old
  old="$(docker images "$repo" --format '{{.Tag}}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+' | sort -rV | tail -n +3)"
  for t in $old; do [[ "$t" == "$OUTE_VERSION" ]] || docker rmi "$repo:$t" >/dev/null 2>&1 || true; done
  [[ "${OUTE_BUILD_LOCAL:-0}" == 1 ]] || docker builder prune -af >/dev/null 2>&1 || true
}

# no up: usa a imagem local; senão puxa do ghcr; build local só se OUTE_BUILD_LOCAL=1
ensure_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 && return 0
  if [[ "${OUTE_BUILD_LOCAL:-0}" == 1 ]]; then "$0" build; else oute_pull; fi
}

# --- reserva de disco da fila do collector (#163, ADR-04): 4 GB por host = 2 filas de 1 GB (bucket #161 e
# agent-studio #155) × 2 GB de disco cada (o bbolt chega a ~1,7× o limite da fila e não encolhe, #137)
QUEUE_VOLUME="${COMPOSE_PROJECT_NAME:-oute-agent}_oute-otel-queue"
QUEUE_RESERVE_KB=$((4 * 1024 * 1024))
kb_gb() { awk -v k="$1" 'BEGIN { printf "%.1f GB", k / 1048576 }'; }
# "<livre_kb> <fila_kb>" do disco onde o Docker guarda os volumes, medido de dentro de um container: no Mac é o
# disco da VM do Docker Desktop, não o do Mac. Volume ainda não criado = fila 0 (df na raiz do container, mesmo
# disco). Sem a imagem local (nunca baixa aqui) ou sem docker: rc 1.
queue_disk() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 || return 1
  local mnt=() out
  docker volume inspect "$QUEUE_VOLUME" >/dev/null 2>&1 && mnt=(-v "$QUEUE_VOLUME:/q:ro")
  out="$(docker run --rm --pull never --network none --user 0:0 --entrypoint sh ${mnt[@]+"${mnt[@]}"} "$IMAGE" -c \
    'if [ -d /q ]; then d=/q; u=$(du -sk /q | cut -f1); else d=/; u=0; fi; df -Pk "$d" | awk -v u="$u" "NR==2 {print \$4, u}"' \
    2>/dev/null)" || return 1
  [[ "$out" =~ ^[0-9]+\ [0-9]+$ ]] || return 1
  printf '%s\n' "$out"
}
# `oute up`: só avisa, nunca bloqueia a subida
queue_reserve_check() {
  local out free used need
  out="$(queue_disk)" || { echo "aviso: não medi o disco livre para a fila do collector (reserva de 4 GB, ADR-04)" >&2; return 0; }
  read -r free used <<<"$out"
  need=$(( QUEUE_RESERVE_KB - used )); (( need > 0 )) || need=0
  (( free >= need )) && return 0
  echo "aviso: disco do Docker com $(kb_gb "$free") livres não comporta a reserva de 4 GB da fila do collector" \
    "(a fila já ocupa $(kb_gb "$used"); faltam $(kb_gb $(( need - free )))). Com o OCI fora, a fila pode encher o disco." \
    "Libere espaço (docker system df) ou aumente o disco (no Mac: Docker Desktop → Resources). Subindo mesmo assim." >&2
}
# `oute status`: linha de disco com o tamanho do volume da fila
queue_status_line() {
  local out free used
  if out="$(queue_disk)"; then
    read -r free used <<<"$out"
    echo "disco do Docker: $(kb_gb "$free") livres · fila do collector ($QUEUE_VOLUME): $(kb_gb "$used") de 4 GB reservados"
  else
    echo "disco do Docker: não medido (sem docker ou sem a imagem $IMAGE local)"
  fi
}

oci_bootstrap() {
  need jq
  export BW_CLIENT_FILE="$OUTE_HOME/bw_client.env"
  # #21: sessão aberta agora (master password), só no env deste processo e do container; trancada ao sair
  vault_open
  docker run --rm -i --add-host "vault.oute.pro:${OUTE_VAULT_HOST_IP:-100.66.254.24}" \
    --user "$(id -u):$(id -g)" -e HOME=/tmp -e BITWARDENCLI_APPDATA_DIR=/bwcli \
    -e BW_SESSION -e DRY_RUN -e OUTE_OCI_BUDGET_EMAIL -e OUTE_OCI_SVC_EMAIL -e OUTE_BUCKET \
    -v "$OUTE_HOME/bwcli:/bwcli" -v "$ROOT/scripts:/opt/oute-scripts:ro" \
    --entrypoint bash "ghcr.io/renatobardi/oute-agent:${OUTE_VERSION}" /opt/oute-scripts/oci-bootstrap.sh "$@"
  # item oci-storage pode ter sido criado agora: agent.env relido com a mesma sessão (sem pedir a senha de novo)
  [[ "${DRY_RUN:-0}" == 1 ]] || { vault_to_agent_env; service_secrets_split; }
}

# --- canal de aprovação (`oute approve`): o agente PROPÕE (oute-propose, dentro do container), o humano
# aprova AQUI, fora do alcance do container. O script é copiado para o host ANTES de ser mostrado, e o que roda
# é exatamente o que foi mostrado (sem TOCTOU). Conteúdo vem do container = não confiável: caracteres de controle
# (ESC, CR…) são neutralizados na exibição para nada ficar escondido.
AGENT_CTR=oute-agent
approve_dir="$OUTE_HOME/approve"
ctr() { docker exec "$AGENT_CTR" "$@"; }        # leitura (sem -i: não disputa o teclado com o read)
ctr_in() { docker exec -i "$AGENT_CTR" "$@"; }  # escrita (stdin -> container)
approve_pending() {
  local id
  for id in $(ctr sh -c 'ls -1 "$HOME"/outbox/*.sh 2>/dev/null' | sed 's|.*/||; s|\.sh$||' | grep -E '^[0-9]{8}-[0-9]{6}-[a-z0-9-]+$' || true); do
    # já decidido, resultado ainda não entregue (#210): nunca mostra (nem roda) de novo
    compgen -G "$approve_dir/runs/$id.*.result" >/dev/null || echo "$id"
  done
}
# evento operacional oute.canal.decided (ADR-04, #124): o oute-emit do container lê o cabeçalho do .out (nunca a
# saída). Sem -i (não disputa o teclado com o read); imagem sem oute-emit ou coletor fora do ar: segue em silêncio
approve_emit() { ctr oute-emit canal "$1" </dev/null >/dev/null 2>&1 || true; }
show_safe() { LC_ALL=C perl -pe 's/[\x00-\x08\x0b-\x1f\x7f]/\xc2\xb7/g; s/\xc2[\x80-\x9f]/\xc2\xb7/g' "$1"; }
# #210: a decisão fica PRIMEIRO no host (runs/<id>.<done|rejected>.result) e só depois vai ao container. O script
# aprovado pode ter recriado o próprio oute-agent (oute down/up/restart): o container some e volta no meio do
# fluxo. Entrega = inbox/<id>.out (rename atômico) + outbox/<id>.sh para done/ ou rejected/; tenta por até $2
# segundos (default OUTE_APPROVE_WAIT=90) e, se não der, o resultado segue no host e a próxima rodada do
# approve/watch entrega (o pedido não volta à fila enquanto isso).
approve_deliver() {
  local f="$1" tries="${2:-${OUTE_APPROVE_WAIT:-90}}" base id dest i=0
  base="${f##*/}"; base="${base%.result}"; dest="${base##*.}"; id="${base%.*}"
  while :; do
    if ctr_in sh -c 'mkdir -p "$HOME/inbox" "$HOME/outbox/$2" && cat > "$HOME/inbox/.tmp.$1" &&
        mv "$HOME/inbox/.tmp.$1" "$HOME/inbox/$1.out" &&
        { [ ! -e "$HOME/outbox/$1.sh" ] || mv "$HOME/outbox/$1.sh" "$HOME/outbox/$2/"; }' _ "$id" "$dest" \
        < "$f" >/dev/null 2>&1; then
      rm -f "$f"; approve_emit "$id"; return 0
    fi
    i=$((i + 1)); (( i < tries )) || break
    sleep 1
  done
  echo "aviso: $AGENT_CTR fora do ar; resultado de $id guardado em $f (o próximo oute approve/watch entrega)" >&2
  return 1
}
# resultados que ficaram no host (container fora quando foram decididos). $1 = segundos de espera pelo container
# (default 1 = uma tentativa, em silêncio, a cada volta do --watch); com espera, avisa e, se o primeiro não sair,
# os demais tentam uma vez só (o container continua fora)
approve_flush() {
  local tries="${1:-1}" f
  for f in "$approve_dir"/runs/*.result; do
    [[ -e "$f" ]] || continue
    if (( tries > 1 )); then approve_deliver "$f" "$tries" || tries=1
    else approve_deliver "$f" 1 2>/dev/null || true; fi
  done
  return 0
}
approve_one() {
  local id="$1" src title as sha ans rc=0 out t0 dur size res tailpid
  mkdir -p "$approve_dir/runs"; chmod 700 "$approve_dir"
  src="$approve_dir/runs/$id.sh"; out="$approve_dir/runs/$id.out"
  ctr sh -c 'head -c 65536 "$HOME/outbox/$1.sh"' _ "$id" > "$src" || { echo "não consegui ler $id" >&2; return 1; }
  title="$(sed -n 's/^# titulo: //p' "$src" | head -1 | LC_ALL=C tr -d '\000-\037\177' | cut -c1-120)"; as="$(sed -n 's/^# como: //p' "$src" | head -1)"
  [[ "$as" == root ]] || as=user
  sha="$( (shasum -a 256 "$src" 2>/dev/null || sha256sum "$src") | cut -c1-12)"
  printf '\n\033[1m━━━ pedido %s ━━━\033[0m\n' "$id"
  printf 'título: %s\n' "$title"
  if [[ "$as" == root ]]; then printf 'roda como: \033[1;31mROOT (sudo)\033[0m no host %s\n' "$OUTE_HOST"
  else printf 'roda como: %s no host %s\n' "$(id -un)" "$OUTE_HOST"; fi
  printf 'sha256: %s   linhas: %s\n\033[2m────────────────────────────────────────\033[0m\n' "$sha" "$(wc -l < "$src" | tr -d ' ')"
  show_safe "$src"
  printf '\033[2m────────────────────────────────────────\033[0m\n'
  read -r -p "executar? [s]im / [N]ão agora / [r]ecusar: " ans <"${OUTE_APPROVE_TTY:-/dev/tty}" || ans=""
  case "$ans" in
    s|S|sim)
      echo "── executando…"
      # set +e: script do agente que falha não pode derrubar o `oute` (pipefail + set -e) antes de devolver o resultado
      set +e
      # #210: saída direto em arquivo, nunca em pipe (| tee): processo que o script deixa em segundo plano (o
      # `oute up` sobe daemons) herda o stdout, o pipe nunca fecha e o tee esperava para sempre. O tail -f só
      # mostra na tela; o fim do script é o fim do bash, não o EOF de quem herdou o descritor.
      : > "$out"; tail -n +1 -f "$out" & tailpid=$!; trap 'kill "$tailpid" 2>/dev/null' EXIT
      t0="$(date +%s)"
      if [[ "$as" == root ]]; then sudo bash "$src" >> "$out" 2>&1; rc=$?
      else bash "$src" >> "$out" 2>&1; rc=$?; fi
      dur=$(( $(date +%s) - t0 )); size="$(wc -c < "$out" | tr -d ' ')"
      sleep 1; kill "$tailpid" 2>/dev/null; wait "$tailpid" 2>/dev/null; trap - EXIT
      set -e
      echo "── fim (código $rc)"
      res="$approve_dir/runs/$id.done.result"
      { printf '# id: %s\n# rc: %s\n# como: %s\n# aprovado: %s por %s@%s\n# sha256: %s\n# duracao: %s s\n# saida: %s bytes\n\n' \
          "$id" "$rc" "$as" "$(date -u +%FT%TZ)" "$(id -un)" "$OUTE_HOST" "$sha" "$dur" "$size"; tail -c 262144 "$out"; } > "$res"
      printf '%s\t%s\t%s\t%s\texec\trc=%s\t%s\n' "$(date -u +%FT%TZ)" "$OUTE_HOST" "$id" "$sha" "$rc" "$title" >> "$approve_dir/approve.log"
      approve_deliver "$res" || true ;;
    r|R)
      res="$approve_dir/runs/$id.rejected.result"
      printf '# id: %s\n# rc: 126\n# recusado: %s por %s@%s\n# sha256: %s\n\nrecusado pelo usuário; nada foi executado.\n' \
          "$id" "$(date -u +%FT%TZ)" "$(id -un)" "$OUTE_HOST" "$sha" > "$res"
      printf '%s\t%s\t%s\t%s\trecusado\t-\t%s\n' "$(date -u +%FT%TZ)" "$OUTE_HOST" "$id" "$sha" "$title" >> "$approve_dir/approve.log"
      approve_deliver "$res" || true
      echo "recusado." ;;
    *) echo "fica pendente." ;;
  esac
}
approve_usage() { echo "uso: oute approve [--watch | <id>]   (id: AAAAMMDD-HHMMSS-slug, como o oute-propose imprime)" >&2; }
approve() {
  # argumentos conferidos antes de tocar o container. #158: `oute approve <id>` decide só aquele pedido (o tray do
  # Mac abre o Terminal nele); id fora do formato do oute-propose = rc 2, sem docker exec nenhum
  local watch=0 one="" id seen=""
  case "$#:${1:-}" in
    0:) ;;
    1:--watch|1:-w) watch=1 ;;
    1:-*) approve_usage; return 2 ;;
    1:*) [[ "$1" =~ ^[0-9]{8}-[0-9]{6}-[a-z0-9-]+$ ]] || { echo "oute: id inválido: $(printf '%s' "$1" | LC_ALL=C tr -d '\000-\037\177' | cut -c1-80)" >&2; approve_usage; return 2; }
         one="$1" ;;
    *) approve_usage; return 2 ;;
  esac
  # #210: resultado guardado no host sai antes da guarda. `oute approve` chamado com o container fora (o script
  # aprovado reiniciou o agent) espera ele voltar por até OUTE_APPROVE_WAIT s e entrega, em vez de recusar de cara
  compgen -G "$approve_dir/runs/*.result" >/dev/null && approve_flush "${OUTE_APPROVE_WAIT:-90}"
  docker ps -q -f name="^${AGENT_CTR}\$" -f status=running | grep -q . || die "container $AGENT_CTR não está rodando"
  if [[ -n "$one" ]]; then
    approve_flush
    grep -qxF "$one" <<<"$(approve_pending)" || { echo "oute: pedido $one não está pendente (já decidido ou não existe)" >&2; return 1; }
    printf '\a'; approve_one "$one"; return 0
  fi
  while :; do
    approve_flush
    local ids; ids="$(approve_pending)"
    for id in $ids; do
      [[ " $seen " == *" $id "* ]] && continue   # 'N' = pula nesta rodada do --watch
      printf '\a'; approve_one "$id"; seen="$seen $id"
    done
    (( watch )) || { [[ -n "$ids" ]] || echo "nenhum pedido pendente."; return 0; }
    [[ -n "$ids" ]] || printf '\r\033[2maguardando pedidos em %s (%s)… Ctrl+C sai\033[0m ' "$AGENT_CTR" "$OUTE_HOST"
    sleep 3
  done
}

# `oute install`: link no PATH -> digitar só `oute` (Mac e oute-server)
install_link() {
  local target="$ROOT/scripts/oute" d dest=""
  for d in "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin; do
    [[ ":$PATH:" == *":$d:"* && -d "$d" && -w "$d" ]] && { dest="$d"; break; }
  done
  if [[ -z "$dest" ]]; then
    dest="$HOME/.local/bin"; mkdir -p "$dest"
    echo "aviso: $dest não está no PATH; adicione ao ~/.zshrc (Mac) ou ~/.bashrc: export PATH=\"\$HOME/.local/bin:\$PATH\"" >&2
  fi
  ln -sfn "$target" "$dest/oute" && echo "instalado: $dest/oute -> $target"
}

# --- tray (#260, ADR-08 §10): app de barra de menu do Mac (pacote SwiftPM em tray/). É do host, não da imagem:
# compila aqui, monta o .app sem ícone no Dock (LSUIElement) e abre no login por um LaunchAgent. Sem App Store nem
# assinatura de desenvolvedor (só a ad-hoc, local). O app só lê o agent-studio; aprovar abre o Terminal no `oute approve`.
TRAY_LABEL="pro.oute.tray"
# o identificador do app é outro que o rótulo do LaunchAgent (#563): a Central de Notificações do macOS guarda o
# ícone por identificador, e o `pro.oute.tray` ficou com o ícone genérico de quando o app não tinha ícone
TRAY_BUNDLE_ID="pro.oute.outetray"
TRAY_APP="$HOME/Applications/OuteTray.app"
TRAY_PLIST="$HOME/Library/LaunchAgents/$TRAY_LABEL.plist"
TRAY_HOSTS="$OUTE_HOME/tray-hosts"
TRAY_ICON="AppIcon.icns"
tray_usage() { echo "uso: oute tray install | oute tray uninstall | oute tray sync   (só no macOS)" >&2; }
# o commit do repo, que o install grava no Info.plist e o tray mostra no menu (#516); vazio fora de um repo git
tray_repo_commit() {
  git -C "$ROOT" rev-parse --short=7 HEAD 2>/dev/null || true
  return 0
}
# o commit gravado no app instalado; vazio se não há app ou se ele é de antes da #516
tray_app_commit() {
  sed -n 's/.*<key>OuteTrayCommit<\/key><string>\([^<]*\)<\/string>.*/\1/p' "$TRAY_APP/Contents/Info.plist" 2>/dev/null | head -1
  return 0
}
# texto para dentro de um plist (XML)
tray_xml() {
  local text="$1"
  # sed, e não ${var//…}: o `&` na troca muda de sentido entre o bash 3.2 do Mac e o 5.2
  printf '%s' "$text" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
  return 0
}
# a tabela que o install grava quando não há uma: este host = local; o oute-server pelo alias ssh de mesmo nome
tray_hosts_default() {
  printf '# tray do oute (#260): <host da telemetria>=local | <alias ssh>. Host fora daqui = aprovar desabilitado.\n'
  printf '%s=local\n' "$OUTE_HOST"
  [[ "$OUTE_HOST" == oute-server ]] || printf 'oute-server=oute-server\n'
  return 0
}
tray_stop() {
  launchctl bootout "gui/$(id -u)/$TRAY_LABEL" 2>/dev/null || true
  return 0
}
tray_install() {
  local bin url env_block="" icon_block="" commit
  need swift
  echo "compilando o tray (swift build -c release)…"
  swift build -c release --package-path "$ROOT/tray" --product OuteTray || die "o tray não compilou"
  bin="$(swift build -c release --package-path "$ROOT/tray" --show-bin-path)/OuteTray"
  [[ -x "$bin" ]] || die "binário do tray não encontrado em $bin"
  echo "parando o tray, se estiver aberto…"
  tray_stop
  echo "montando ${TRAY_APP}…"
  rm -rf "$TRAY_APP"; mkdir -p "$TRAY_APP/Contents/MacOS"
  cp "$bin" "$TRAY_APP/Contents/MacOS/OuteTray"
  # o ícone do app (a sakura do Kubo, #563): o próprio binário desenha e grava o .icns. O macOS mostra esse ícone
  # na notificação de pedido novo. Sem ele o tray funciona igual, com o ícone genérico.
  mkdir -p "$TRAY_APP/Contents/Resources"
  if "$TRAY_APP/Contents/MacOS/OuteTray" --write-icon "$TRAY_APP/Contents/Resources/$TRAY_ICON" && [[ -s "$TRAY_APP/Contents/Resources/$TRAY_ICON" ]]; then
    icon_block="
  <key>CFBundleIconFile</key><string>$TRAY_ICON</string>"
  else
    rm -f "$TRAY_APP/Contents/Resources/$TRAY_ICON"
    echo "aviso: o ícone do tray não foi gravado; o app fica com o ícone genérico" >&2
  fi
  commit="$(tray_repo_commit)"
  cat > "$TRAY_APP/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>$TRAY_BUNDLE_ID</string>
  <key>CFBundleName</key><string>OuteTray</string>
  <key>CFBundleExecutable</key><string>OuteTray</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(tray_xml "$VERSION")</string>
  <key>CFBundleVersion</key><string>$(tray_xml "$VERSION")</string>
  <key>OuteTrayCommit</key><string>$(tray_xml "$commit")</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>LSUIElement</key><true/>$icon_block
</dict>
</plist>
EOF
  # assinatura ad-hoc do pacote inteiro: sem ela o macOS não entrega as notificações de um .app montado à mão
  codesign --force --sign - "$TRAY_APP" >/dev/null 2>&1 || echo "aviso: codesign ad-hoc falhou; as notificações podem não aparecer" >&2
  mkdir -p "$OUTE_HOME"
  if [[ -e "$TRAY_HOSTS" ]]; then echo "mantido: $TRAY_HOSTS"
  else tray_hosts_default > "$TRAY_HOSTS"; echo "criado: $TRAY_HOSTS"; fi
  # o endereço do agent-studio, se o .env troca o padrão, vai no ambiente do app (o token ele lê do agent.env)
  url="${OUTE_AGENT_STUDIO_URL:-$(env_get OUTE_AGENT_STUDIO_URL || true)}"
  [[ -z "$url" ]] || env_block="
  <key>EnvironmentVariables</key><dict><key>OUTE_AGENT_STUDIO_URL</key><string>$(tray_xml "$url")</string></dict>"
  echo "registrando para abrir no login ($TRAY_PLIST)…"
  mkdir -p "$(dirname "$TRAY_PLIST")"
  cat > "$TRAY_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
  <key>Label</key><string>$TRAY_LABEL</string>
  <key>ProgramArguments</key><array><string>$(tray_xml "$TRAY_APP/Contents/MacOS/OuteTray")</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>$env_block
</dict>
</plist>
EOF
  launchctl bootstrap "gui/$(id -u)" "$TRAY_PLIST" || die "launchctl não carregou $TRAY_PLIST"
  [[ -s "$AGENT_ENV_FILE" ]] || echo "aviso: $AGENT_ENV_FILE ausente; o tray fica sem leitura até o oute secrets refresh" >&2
  echo "tray instalado e aberto (barra de menu). Remover: oute tray uninstall"
  return 0
}
tray_uninstall() {
  echo "parando o tray…"
  tray_stop
  rm -f "$TRAY_PLIST"; rm -rf "$TRAY_APP"
  echo "removidos: $TRAY_PLIST e $TRAY_APP"
  # a tabela só sai se ninguém a editou
  if [[ -e "$TRAY_HOSTS" ]]; then
    if [[ "$(cat "$TRAY_HOSTS")" == "$(tray_hosts_default)" ]]; then rm -f "$TRAY_HOSTS"; echo "removido: $TRAY_HOSTS"
    else echo "mantido (editado): $TRAY_HOSTS"; fi
  fi
  return 0
}
# reinstala o tray só se o app instalado está atrás do repo (#516): compara o commit gravado no app com o do repo
tray_sync() {
  local have want
  [[ -d "$TRAY_APP" ]] || { echo "tray não instalado; nada a fazer (instalar: oute tray install)"; return 0; }
  have="$(tray_app_commit)"; want="$(tray_repo_commit)"
  if [[ -n "$want" && "$have" == "$want" ]]; then
    echo "tray em dia ($VERSION, $want)"
    return 0
  fi
  echo "tray atrás do repo (instalado: ${have:-sem commit}; repo: ${want:-sem commit}): reinstalando…"
  tray_install
  return $?
}
# depois do `oute update` (#516): no macOS e com o tray instalado, traz o tray para o commit do repo. Falha aqui é
# aviso: o update já terminou.
tray_after_update() {
  [[ "$(uname -s)" == Darwin && -d "$TRAY_APP" ]] || return 0
  "$0" tray sync || echo "aviso: o tray não foi reinstalado; rode: oute tray install" >&2
  return 0
}
tray_cmd() {
  local sub="${1:-}"
  [[ $# == 1 && ( "$sub" == install || "$sub" == uninstall || "$sub" == sync ) ]] || { tray_usage; exit 2; }
  [[ "$(uname -s)" == Darwin ]] || die "o tray é só no macOS (este host é $(uname -s))"
  "tray_$sub"
  return $?
}

case "${1:-}" in
  "")      # sem argumento: abre o herdr; se a stack não estiver de pé, sobe antes
           docker ps -q -f name='^oute-agent$' -f status=running | grep -q . || "$0" up
           exec "$0" attach ;;
  install) install_link ;;
  update)  # de qualquer diretório: repo (git pull --tags) + imagem da versão nova + restart
           git -C "$ROOT" pull --tags --ff-only || die "git pull falhou em $ROOT (mudanças locais?)"
           exec "$ROOT/scripts/oute" _update2 ;;
  _update2) oute_pull && "$0" down && "$0" up && "$0" version && tray_after_update ;;   # 2ª etapa já com o script novo
  approve) approve "${@:2}" ;;
  tray)    tray_cmd "${@:2}" ;;
  watch)   # atalho: aprovação em modo espera. Com host: roda no host remoto via ssh (ex.: oute watch oute-server)
           if [[ -n "${2:-}" ]]; then exec ssh -t "$2" 'bash -lc "oute approve --watch"'
           else approve --watch; fi ;;
  build)
    docker buildx version >/dev/null 2>&1 || echo "aviso: sem docker-buildx (Ubuntu: apt install docker-buildx; Mac: vem no Docker Desktop/OrbStack)" >&2
    # sem attestation de proveniência: não há registry ainda (#2) e ela só acrescenta um manifesto a cada export
    BUILDX_NO_DEFAULT_ATTESTATIONS=1 "${COMPOSE[@]}" build "${@:2}"
    # retenção (#12) SEM matar o cache usado agora: remove só o que não é usado há OUTE_BUILD_CACHE_TTL (default 72h).
    # (--max-used-space com -a apagava também o cache recente -> rebuild de 7 min; sem -a não apagava nada)
    docker builder prune -af --filter "until=${OUTE_BUILD_CACHE_TTL:-24h}" >/dev/null 2>&1 || true
    docker image prune -f >/dev/null 2>&1 || true
    docker system df --format '{{.Type}}: {{.Size}}' 2>/dev/null | grep -E '^(Images|Build Cache)' | tr '\n' ' '; echo
    df -h / | awk 'NR==2 {print "disco /: " $5 " usado (" $4 " livre)"}'
    ;;
  up)
    refresh=0; up_args=()
    for a in "${@:2}"; do if [[ "$a" == --refresh-secrets ]]; then refresh=1; else up_args+=("$a"); fi; done
    host_secrets "$refresh"; agent_studio_up; llm_proxy_up; ensure_dirs; mount_shared
    legacy_cleanup
    ensure_image
    queue_reserve_check
    ensure_net_ip_range
    "${COMPOSE[@]}" up -d --no-build ${up_args[@]+"${up_args[@]}"}; "$0" status; wait_sshd
    # imagem antiga só fica "solta" depois que o container é recriado -> limpa aqui (retenção, #12)
    docker image prune -f >/dev/null 2>&1 || true
    ;;
  # --profile: down/logs/status enxergam também o agent-studio e o llm-proxy, quando existem (no Mac não há nada dele)
  down)    legacy_cleanup; "${COMPOSE[@]}" --profile "$STUDIO_PROFILE" --profile "$LLM_PROXY_PROFILE" down "${@:2}"; umount_shared ;;
  restart) "$0" down; "$0" up ;;
  logs)    "${COMPOSE[@]}" --profile "$STUDIO_PROFILE" --profile "$LLM_PROXY_PROFILE" logs --tail=100 "${@:2}" ;;
  follow)  "${COMPOSE[@]}" --profile "$STUDIO_PROFILE" --profile "$LLM_PROXY_PROFILE" logs -f "${@:2}" ;;
  status)  "${COMPOSE[@]}" --profile "$STUDIO_PROFILE" --profile "$LLM_PROXY_PROFILE" ps; queue_status_line ;;
  attach)  exec ssh -p "$SSH_PORT" -t "oute@$SSH_HOST" 'herdr attach 2>/dev/null || herdr' ;;
  ssh)     # com comando: -t quando há terminal (CLIs em modo headless podem ler stdin se não for TTY e ficar esperando EOF)
           if [[ $# -gt 1 ]]; then t=(); [[ -t 0 ]] && t=(-t)
             exec ssh ${t[@]+"${t[@]}"} -p "$SSH_PORT" "oute@$SSH_HOST" bash -lc "$(printf '%q ' "${@:2}")"
           else exec ssh -p "$SSH_PORT" "oute@$SSH_HOST"; fi ;;
  shell)   exec docker exec -it oute-agent bash -l ;;
  sync-shared) mount_shared ;;
  oci-bootstrap) oci_bootstrap "${@:2}" ;;
  pull)    oute_pull ;;
  storage)   # acesso direto ao bucket, sem passar pelo mount: oute storage ls | lsl | about | <qualquer subcomando rclone>
    oci_remote_env || die "item oci-storage ausente no vault (rode: oute oci-bootstrap)"
    sub="${2:-ls}"; rclone "$sub" "oci:${OUTE_BUCKET:-oute-shared}${3:+/$3}" "${@:4}" ;;   # DRY_RUN=1 oute oci-bootstrap pra só ver o que faria
  studio)  # #159: replay; #345: rebuild-state
    case "${2:-}" in
      replay) studio_replay "${@:3}" ;;
      rebuild-state) [[ $# == 2 ]] || { echo "uso: oute studio rebuild-state (sem argumentos)" >&2; exit 2; }
                     studio_rebuild_state ;;
      backup) case "${3:-}" in
                "") [[ $# == 2 ]] || { studio_backup_usage; exit 2; }; studio_backup ;;
                --check) [[ $# == 4 && -n "$4" ]] || { studio_backup_usage; exit 2; }; studio_backup_check "$4" ;;
                *) studio_backup_usage; exit 2 ;;
              esac ;;
      *) echo "uso: oute studio replay --from <ISO> --to <ISO> [--signal s] [--host h] [--legacy] | oute studio rebuild-state | oute studio backup [--check <nome|latest>]" >&2; exit 2 ;;
    esac ;;
  memory-backup)  # #369: backup do volume oute-memory no bucket oute-shared; --check <arquivo> restaura num tmp e confere
    case "${2:-}" in
      "") memory_backup ;;
      --check) [[ $# == 3 && -n "$3" ]] || { memory_backup_usage; exit 2; }
               memory_backup_check "$3" ;;
      *) memory_backup_usage; exit 2 ;;
    esac ;;
  lock)    "$ROOT/scripts/oute-secrets.sh" lock ;;
  secrets)   # #21: relê o vault (pede a master password), regrava agent.env e services.env (#256) e tranca a sessão
    [[ "${2:-}" == refresh ]] || { echo "uso: oute secrets refresh" >&2; exit 2; }
    host_secrets 1
    docker ps -q -f name='^oute-agent$' -f status=running | grep -q . && echo "o container lê agent.env ao subir: oute restart"
    exit 0 ;;
  version)
    echo "repo:    $VERSION ($(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo '?'))"
    img="$(docker inspect -f '{{index .Config.Labels "org.opencontainers.image.version"}}' oute-agent 2>/dev/null || true)"
    echo "running: ${img:-não está rodando}"
    echo "origem:  host=$OUTE_HOST instance=$OUTE_INSTANCE"
    ;;
  help|guide)  # guia completo (host + container); o mesmo arquivo vai na imagem
    if [[ -t 1 ]] && command -v less >/dev/null; then less -FRX "$ROOT/docker/comandos.md"; else cat "$ROOT/docker/comandos.md"; fi ;;
  *)
    [[ "$1" == -h || "$1" == --help ]] || echo "oute: comando desconhecido: $1" >&2
    echo "(guia completo com receitas e comandos do container: oute help)"
    cat <<'EOF'
uso: oute [cmd]     (sem cmd: sobe a stack se preciso e abre o herdr)
  help         guia completo: receitas, comandos do host e do container
  install      link no PATH para chamar só `oute` de qualquer lugar
  update       de qualquer diretório: git pull --tags no repo + pull da imagem + down + up + version
  approve [--watch]  revisa e executa (ou recusa) os scripts que os agentes propuseram com oute-propose
  approve <id>       decide só aquele pedido (id do oute-propose); não pendente = rc 1, id inválido = rc 2
  tray install|uninstall|sync  só no macOS: compila o tray (barra de menu, lê o agent-studio), monta o .app e abre no login; uninstall desfaz;
               sync reinstala só se o app instalado está atrás do repo (o update já chama)
  watch [host]       = approve --watch; com host (ex.: oute-server), abre a espera naquele host via ssh
  pull         baixa a imagem da versão atual do ghcr (feita pelo CI na tag)
  build        constrói a imagem localmente (fallback; normal é o CI) (arm64; mantém cache usado nas últimas 72h)
  up [--refresh-secrets]  sobe agent + ai-memory + otel-collector com os segredos de ~/.oute/agent.env (agent) e
               ~/.oute/services.env (só os serviços, nunca o agent; pasta oute-services do vault, #256)
               (+ llm-proxy nos dois hosts quando o services.env tem OPENROUTER_MEMORY_API_KEY: proxy do LLM do ai-memory, #459)
               (+ agent-studio no host com OUTE_AGENT_STUDIO=1 no .env e o item agent-studio no vault, ADR-08;
                nos outros, o collector manda ao agent-studio.oute.pro pela tailnet com a credencial de ingestão, #190)
               (senha do Vaultwarden só sem agent.env ou com --refresh-secrets)
  secrets refresh  relê o Vaultwarden (pede a master password), regrava agent.env e services.env e tranca a sessão
  down|restart
  attach       ssh -> herdr
  ssh [cmd]    ssh direto no container
  shell        docker exec bash
  logs [svc] | follow [svc]
  status       serviços + disco do Docker e tamanho da fila do collector (reserva de 4 GB)
  sync-shared  monta bucket OCI em ~/.oute/shared via rclone (credencial: item oci-storage do vault)
  storage [ls|lsl|about] [path]  lista o bucket direto no OCI (confere o que o mount enviou)
  studio replay --from <ISO> --to <ISO> [--signal s] [--host h] [--legacy]  só no oute-server: reenvia o bucket de telemetria ao agent-studio (ADR-08 §7)
  studio rebuild-state  só no oute-server: remonta o estado do SurrealDB a partir do DuckDB, com o agent-studio parado (ADR-08 §7)
  studio backup [--check <nome|latest>]  só no oute-server: cópia consistente do DuckDB do agent-studio em backups/agent-studio/ do bucket de telemetria, com retenção; --check abre uma cópia do bucket e conta as linhas (#570)
  memory-backup [--check <arquivo>]  backup do volume oute-memory (ai-memory backup) em backups/ai-memory/ do oute-shared, com retenção; --check restaura num tmp e confere
  oci-bootstrap  provisiona compartment/buckets/IAM/budget no OCI e grava a chave S3 no vault [DRY_RUN=1] (pede a senha)
  lock         tranca o Vaultwarden (bw lock) e apaga a sessão em cache das versões antigas
  version      versão do repo e da imagem em execução
EOF
    ;;
esac
