#!/usr/bin/env bash
# oute — CLI do host (Mac ou LXC) para operar o runtime
#   oute up | down | build | attach | shell | logs | sync-shared | status
set -euo pipefail

# resolve symlinks (oute instalado em ~/.local/bin etc. aponta pra cá); sem readlink -f (macOS antigo)
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do _dir="$(cd "$(dirname "$_src")" && pwd)"; _src="$(readlink "$_src")"; [[ "$_src" == /* ]] || _src="$_dir/$_src"; done
ROOT="$(cd "$(dirname "$_src")/.." && pwd)"; unset _src _dir
VERSION="$(tr -d '[:space:]' < "$ROOT/VERSION")"
export OUTE_VERSION="$VERSION"
# --project-directory: .env e paths relativos resolvem na raiz do repo, não em docker/
COMPOSE=(docker compose --project-directory "$ROOT" -f "$ROOT/docker/compose.yaml")
export OUTE_HOME="${OUTE_HOME:-$HOME/.oute}"
SSH_PORT="${OUTE_SSH_PORT:-2222}"
SSH_HOST="${OUTE_SSH_HOST:-localhost}"

die() { printf 'oute: %s\n' "$*" >&2; exit 1; }

# --- origem da telemetria = máquina + instância (#22). A instância só precisa ser única DENTRO da máquina.
# valor do .env sem carregá-lo inteiro (o compose lê o .env; aqui só o que o script precisa decidir)
env_get() { sed -n "s/^[[:space:]]*$1=//p" "$ROOT/.env" 2>/dev/null | sed "s/[[:space:]]*#.*//; s/^[\"']//; s/[\"']\$//" | tail -1; }
# nome seguro para Langfuse environment / partição do bucket: minúsculo, [a-z0-9_-], até 40
slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' | sed 's/^-*//; s/-*$//' | cut -c1-40; }
# máquina: OUTE_HOST > OUTE_HOSTNAME (nome antigo, mesmo papel) > hostname da máquina
OUTE_HOST="$(slug "${OUTE_HOST:-$(env_get OUTE_HOST)}")"
[[ -n "$OUTE_HOST" ]] || OUTE_HOST="$(slug "${OUTE_HOSTNAME:-$(env_get OUTE_HOSTNAME)}")"
[[ -n "$OUTE_HOST" ]] || OUTE_HOST="$(slug "$(hostname -s 2>/dev/null || hostname)")"
OUTE_INSTANCE="$(slug "${OUTE_INSTANCE:-$(env_get OUTE_INSTANCE)}")"; OUTE_INSTANCE="${OUTE_INSTANCE:-oute-agent}"
export OUTE_HOST OUTE_INSTANCE
need() { command -v "$1" >/dev/null || die "precisa de '$1' no host"; }

# sem bw nativo no host (ex.: sem node), usa o bw da própria imagem
bw() {
  if type -P bw >/dev/null 2>&1; then command bw "$@"; return; fi
  mkdir -p "$OUTE_HOME/bwcli"
  # imagem LOCAL: a da versão atual se já existir, senão a mais nova que houver. Nunca a que ainda não foi
  # baixada — o `oute pull` precisa do bw (token do ghcr no vault) justamente para baixá-la (ovo e galinha).
  local img="ghcr.io/renatobardi/oute-agent:${OUTE_VERSION}"
  docker image inspect "$img" >/dev/null 2>&1 || img="$(docker images ghcr.io/renatobardi/oute-agent --format '{{.Repository}}:{{.Tag}}' | sort -t: -k2 -rV | head -1)"
  [[ -n "$img" ]] || { echo "oute: nenhuma imagem oute-agent local para rodar o bw (instale o bw no host ou rode OUTE_BUILD_LOCAL=1 oute build)" >&2; return 1; }
  # roda com o uid do HOST (não o 10001 da imagem, lab#181): o estado do bw em $OUTE_HOME/bwcli é do usuário do host
  docker run --rm -i --pull never --add-host "vault.oute.pro:${OUTE_VAULT_HOST_IP:-100.66.254.24}" \
    --user "$(id -u):$(id -g)" -e HOME=/tmp -e BITWARDENCLI_APPDATA_DIR=/bwcli \
    -e BW_SESSION -e BW_CLIENTID -e BW_CLIENTSECRET -e BW_PASSWORD \
    -v "$OUTE_HOME/bwcli:/bwcli" \
    "$img" bw "$@"
}
export -f bw

# --- segredos do host (#21): ~/.oute/agent.env é o cache. O vault só é aberto quando o segredo muda
# (`oute up --refresh-secrets` / `oute secrets refresh`) ou em comando admin, com a master password, e a
# sessão é trancada logo depois (nada de sessão do Vaultwarden em disco).
AGENT_ENV_FILE="$OUTE_HOME/agent.env"

# fallback de quem precisa de um segredo e não o tem no ambiente: só o agent.env, nunca o vault
load_agent_env() {
  [[ -s "$AGENT_ENV_FILE" ]] || return 0
  # shellcheck disable=SC1090
  . "$AGENT_ENV_FILE"
}
no_secret() { die "$1 ausente em $AGENT_ENV_FILE; rode: oute secrets refresh${2:+ ($2)}"; }

# 1 leitura do vault (pasta oute-agent, pede a master password) -> agent.env. oute-secrets tranca a sessão
# ao sair; com BW_SESSION já aberta pelo chamador (oci-bootstrap), usa essa e não tranca.
vault_to_agent_env() {
  need jq
  [[ -f "$OUTE_HOME/bw_client.env" ]] || die "crie $OUTE_HOME/bw_client.env com BW_CLIENTID/BW_CLIENTSECRET (chmod 600)"
  export BW_CLIENT_FILE="$OUTE_HOME/bw_client.env"
  echo "lendo o Vaultwarden (pasta ${OUTE_VAULT_FOLDER:-oute-agent})…" >&2
  local envs; envs="$("$ROOT/scripts/oute-secrets.sh" export)" || die "não consegui ler o vault"
  eval "$envs"
  # #6: o container dos agentes NÃO recebe acesso ao cofre (sem BW_SESSION, estado do bw ou API key).
  # Recebe só os VALORES da pasta oute-agent, num arquivo 0600 montado como docker secret (read-only).
  # Em disco (não tmpfs) para o container voltar sozinho depois de reboot do host.
  # 1 linha por variável (%q escapa quebras de linha de PEM/JSON) -> o entrypoint valida linha a linha
  local n; ( umask 077
    for n in $(grep -oE '^export [A-Za-z_][A-Za-z0-9_]*' <<<"$envs" | cut -d' ' -f2 | grep -v '^BW_' | sort -u); do
      printf 'export %s=%q\n' "$n" "${!n}"
    done > "$AGENT_ENV_FILE.tmp" && mv "$AGENT_ENV_FILE.tmp" "$AGENT_ENV_FILE" )
  echo "agent.env regravado ($AGENT_ENV_FILE)" >&2
}

# só o mínimo que o compose precisa antes do agent subir; $1=1 força a releitura do vault
host_secrets() {
  # resto das versões <= 0.7.x: sessão em cache em disco
  if [[ -e "$OUTE_HOME/bw_session" ]]; then
    "$ROOT/scripts/oute-secrets.sh" lock >/dev/null 2>&1 || true
    rm -f "$OUTE_HOME/bw_session"
  fi
  if [[ "${1:-0}" == 1 || ! -s "$AGENT_ENV_FILE" ]]; then vault_to_agent_env; else load_agent_env; fi
  export OUTE_AGENT_ENV_FILE="$AGENT_ENV_FILE"
  export AI_MEMORY_AUTH_TOKEN="${AI_MEMORY_AUTH_TOKEN:-}"
  export OCI_S3_ACCESS_KEY="${OCI_S3_ACCESS_KEY:-}" OCI_S3_SECRET_KEY="${OCI_S3_SECRET_KEY:-}" \
         OCI_S3_ENDPOINT="${OCI_S3_ENDPOINT:-}" OCI_S3_REGION="${OCI_S3_REGION:-}"
  # Langfuse (item "langfuse": LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY, LANGFUSE_HOST opcional) liga o pipeline de metadados
  if [[ -n "${LANGFUSE_PUBLIC_KEY:-}" && -n "${LANGFUSE_SECRET_KEY:-}" ]]; then
    OUTE_LANGFUSE_AUTH="$(printf '%s:%s' "$LANGFUSE_PUBLIC_KEY" "$LANGFUSE_SECRET_KEY" | base64 | tr -d '\n')"
    export OUTE_LANGFUSE_AUTH OUTE_OTEL_LANGFUSE=langfuse LANGFUSE_HOST="${LANGFUSE_HOST:-https://cloud.langfuse.com}"
  else
    export OUTE_OTEL_LANGFUSE=none
  fi
}

# --- agent-studio (ADR-08, #185): só no host que o liga com OUTE_AGENT_STUDIO=1 no .env (o oute-server; no Mac
# fica desligado). Item agent-studio da pasta oute-agent do vault, via agent.env: campos AGENT_STUDIO_TOKEN (token da
# ingestão e da API) e AGENT_STUDIO_SURREAL_PASS (root do SurrealDB, #187).
STUDIO_PROFILE=agent-studio
# destino do collector (#190): no host com o agent-studio, a rede docker; nos outros (Mac), o vhost só na tailnet
# (lab#244), com o mesmo token. OUTE_AGENT_STUDIO_URL no .env troca o vhost.
STUDIO_LOCAL_URL=http://agent-studio:8430
STUDIO_REMOTE_URL=https://agent-studio.oute.pro
agent_studio_enabled() { [[ "${OUTE_AGENT_STUDIO:-$(env_get OUTE_AGENT_STUDIO)}" == 1 ]]; }
# `oute up`: liga o profile do compose quando o host tem o agent-studio e o token existe; sem o item, avisa e sobe
# o resto (nunca bloqueia a subida). Junto, o pipeline do collector ao agent-studio (config/otel/agent-studio.yaml,
# #189): pela rede docker no host com o agent-studio, pelo vhost nos outros (#190). Sem o token, none.yaml e o
# collector não muda (a fila não enche de 401).
agent_studio_up() {
  export OUTE_OTEL_STUDIO=none AGENT_STUDIO_URL="$STUDIO_LOCAL_URL"
  if ! agent_studio_enabled; then
    if [[ -z "${AGENT_STUDIO_TOKEN:-}" ]]; then
      echo "aviso: AGENT_STUDIO_TOKEN não está em $AGENT_ENV_FILE (item agent-studio da pasta oute-agent do vault)." \
        "O collector não manda ao agent-studio do oute-server; crie o item e rode: oute up --refresh-secrets" >&2
      return 0
    fi
    AGENT_STUDIO_URL="${OUTE_AGENT_STUDIO_URL:-$(env_get OUTE_AGENT_STUDIO_URL || true)}"
    export AGENT_STUDIO_TOKEN AGENT_STUDIO_URL="${AGENT_STUDIO_URL:-$STUDIO_REMOTE_URL}" OUTE_OTEL_STUDIO=agent-studio
    return 0
  fi
  local v falta=""
  for v in AGENT_STUDIO_TOKEN AGENT_STUDIO_SURREAL_PASS; do [[ -n "${!v:-}" ]] || falta="$falta${falta:+ }$v"; done
  if [[ -n "$falta" ]]; then
    echo "aviso: OUTE_AGENT_STUDIO=1, mas $falta não está em $AGENT_ENV_FILE (item agent-studio da pasta" \
      "oute-agent do vault). O agent-studio não sobe; crie o item e rode: oute up --refresh-secrets" >&2
    return 0
  fi
  export AGENT_STUDIO_TOKEN AGENT_STUDIO_SURREAL_PASS OUTE_OTEL_STUDIO=agent-studio
  COMPOSE_PROFILES="${COMPOSE_PROFILES:+$COMPOSE_PROFILES,}$STUDIO_PROFILE"
  export COMPOSE_PROFILES
}

# --- restos do roteador de modelos, que saiu do stack na #218 (ADR-02, Histórico). Chamado em todo `up` e `down`;
# idempotente: host sem os restos não muda. Os padrões levam [-] para o nome antigo não voltar a aparecer no repo.
legacy_cleanup() {
  # entrada diária (04:00) que as versões <= 0.7.30 punham no crontab do host. Só regrava se a entrada existe;
  # crontab que ficaria vazio é removido (como estava antes da entrada)
  if command -v crontab >/dev/null; then
    local cur new
    cur="$(crontab -l 2>/dev/null || true)"
    if grep -q 'oute router[-]sync' <<<"$cur"; then
      new="$(grep -v 'oute router[-]sync' <<<"$cur" || true)"
      if [[ -n "$new" ]]; then printf '%s\n' "$new" | crontab -; else crontab -r; fi
      echo "crontab: entrada diária do roteador removida (#218)" >&2
    fi
  fi
  # container do serviço que saiu do compose: ficaria órfão, de pé e preso à rede (o `down` não removeria a rede)
  if docker ps -aq -f 'name=^oute-jev[-]router$' 2>/dev/null | grep -q .; then
    docker rm -f "$(docker ps -aq -f 'name=^oute-jev[-]router$')" >/dev/null 2>&1 \
      && echo "container do roteador removido (#218)" >&2 \
      || echo "aviso: não consegui remover o container do roteador (#218); remova à mão com docker rm -f" >&2
  fi
  # pasta dos gerados do roteador no checkout (#271): saiu do repo e do .gitignore, os gerados ficaram não rastreados
  # e sujam a árvore. Só sai inteira se nada nela está no índice (rastreado, modificado ou staged); fora de um
  # checkout git não há como saber, então fica
  local rel="config/lite""llm"
  if [[ -d "$ROOT/$rel" ]] && command -v git >/dev/null && git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    if [[ -n "$(git -C "$ROOT" ls-files -- "$rel" 2>/dev/null)" ]]; then
      echo "aviso: $rel tem arquivo rastreado; não removi a pasta do roteador (#271)" >&2
    elif rm -rf "${ROOT:?}/$rel"; then
      echo "checkout: pasta $rel do roteador removida (#271)" >&2
    else
      echo "aviso: não consegui remover $rel do checkout (#271); remova à mão" >&2
    fi
  fi
  return 0
}

# sshd só sobe no fim do entrypoint (segredos, configs); espera o banner SSH pra `attach` logo depois não falhar
wait_sshd() {
  local i banner
  for i in $(seq 1 60); do
    # sem timeout(1) (não existe no macOS, #3): read -t limita a espera pelo banner
    banner="$(bash -c "exec 3<>/dev/tcp/$SSH_HOST/$SSH_PORT && read -r -t 2 -n 7 b <&3 && printf %s \"\$b\"" 2>/dev/null || true)"
    [[ "$banner" == SSH-2.0 ]] && { echo "sshd pronto (${i}s)"; return 0; }
    sleep 1
  done
  echo "sshd não respondeu em 60s; veja: oute logs agent" >&2; return 1
}

# uid/gid do usuário do container (fixo na imagem, lab#181)
CONTAINER_UID=10001

ensure_dirs() {
  mkdir -p "$OUTE_HOME/shared"
  # lab#181: o container só recebe um caminho do host se for o mount rclone (mount_shared exporta).
  # Sem mount: volume docker "oute-shared" (compose), nada gravável pelo container na home do host.
  # (export explícito: a env do shell vence o .env, que em hosts antigos ainda tem OUTE_SHARED_DIR=~/.oute/shared)
  export OUTE_SHARED_DIR=oute-shared
  # chave pública do host para o sshd do container: se não existir, o Docker cria um DIRETÓRIO vazio no lugar
  # e o entrypoint entra em loop de restart (visto no Mac, #3)
  local pub="${OUTE_SSH_AUTHORIZED_KEYS:-$(sed -n 's/^[[:space:]]*OUTE_SSH_AUTHORIZED_KEYS=//p' "$ROOT/.env" 2>/dev/null | sed 's/[[:space:]]*#.*//' | tail -1)}"
  pub="${pub:-$HOME/.ssh/id_ed25519.pub}"; pub="${pub/#\~/$HOME}"
  [[ -f "$pub" ]] || die "chave pública $pub não existe (ou virou diretório vazio criado pelo Docker: rmdir). Gere com ssh-keygen -t ed25519 ou aponte OUTE_SSH_AUTHORIZED_KEYS no .env"
  # .env antigo: variáveis que não são mais usadas
  local v; for v in OUTE_UID OUTE_SHARED_DIR; do
    grep -qE "^[[:space:]]*$v=" "$ROOT/.env" 2>/dev/null \
      && echo "aviso: $v no .env é ignorado desde a 0.7.3 (lab#181); pode remover a linha" >&2
  done
  return 0
}

# --- storage comum: bucket OCI via rclone (ADR-03, #1)
# remote "oci" definido só por env (credenciais do item oci-storage, via agent.env) -> nenhum rclone.conf com segredo
oci_remote_env() {
  local v; for v in OCI_S3_ACCESS_KEY OCI_S3_SECRET_KEY OCI_S3_ENDPOINT OCI_S3_REGION; do
    [[ -n "${!v:-}" ]] || { load_agent_env; break; }
  done
  [[ -n "${OCI_S3_ACCESS_KEY:-}" ]] || return 1
  export RCLONE_CONFIG=/dev/null   # remote só por env; evita o NOTICE "rclone.conf not found"
  export RCLONE_CONFIG_OCI_TYPE=s3 RCLONE_CONFIG_OCI_PROVIDER=Other \
    RCLONE_CONFIG_OCI_ACCESS_KEY_ID="$OCI_S3_ACCESS_KEY" RCLONE_CONFIG_OCI_SECRET_ACCESS_KEY="$OCI_S3_SECRET_KEY" \
    RCLONE_CONFIG_OCI_ENDPOINT="$OCI_S3_ENDPOINT" RCLONE_CONFIG_OCI_REGION="$OCI_S3_REGION" \
    RCLONE_CONFIG_OCI_FORCE_PATH_STYLE=true RCLONE_CONFIG_OCI_NO_CHECK_BUCKET=true
}

# mountpoint(1) não existe no macOS
is_mounted() { mount | grep -q " on $1 "; }

mount_shared() {
  local dir="$OUTE_HOME/shared" bucket="${OUTE_BUCKET:-oute-shared}"
  command -v rclone >/dev/null || { echo "rclone ausente no host; /data/shared fica local"; return 0; }
  # mount morto (rclone morreu sem desmontar): desmonta e monta de novo. Só com o erro de mount desconectado
  # (Linux: "Transport endpoint is not connected"; macOS: "Device not configured"): outro erro do ls (bucket
  # fora do ar) não derruba um mount vivo
  local err=""; is_mounted "$dir" && err="$(LC_ALL=C ls "$dir" 2>&1 >/dev/null || true)"
  case "$err" in
    *"not connected"*|*"Device not configured"*)
      echo "storage: mount de $dir sem resposta (rclone caiu); remontando" >&2
      fusermount -uz "$dir" 2>/dev/null || umount "$dir" 2>/dev/null || umount -f "$dir" 2>/dev/null || true
      is_mounted "$dir" && { echo "não consegui desmontar $dir; /data/shared fica sem storage" >&2; return 0; }
      echo "storage: se o container já estava de pé, ele segue com o mount antigo; rode 'oute restart'" >&2 ;;
  esac
  is_mounted "$dir" && { export OUTE_SHARED_DIR="$dir"; echo "storage: $dir já montado"; return 0; }
  oci_remote_env || { echo "OCI_S3_* ausente em $AGENT_ENV_FILE (item oci-storage: oute oci-bootstrap; depois oute secrets refresh); /data/shared fica local"; return 0; }
  local extra=()
  if [[ "$(uname)" == Linux ]]; then
    # docker (root) precisa enxergar o mount FUSE do usuário
    grep -q '^user_allow_other' /etc/fuse.conf 2>/dev/null || { echo "falta 'user_allow_other' em /etc/fuse.conf (ver README); /data/shared fica local" >&2; return 0; }
    extra+=(--allow-other)
  fi
  mkdir -p "$dir" "$OUTE_HOME/rclone-cache"
  # cache longo = poucas requests (franquia Always Free: 50 mil/mês)
  # dono = usuário do container (grava); grupo = usuário do host (também grava, umask 002). FUSE de usuário
  # já é nosuid/nodev e o rclone não cria symlink -> o container não planta nada executável no host (lab#181)
  # ${extra[@]+...}: array vazio + set -u quebra no bash 3.2 do macOS (#3)
  # sessão própria: o --daemon do rclone fica no grupo de processos e na sessão do terminal que rodou o
  # oute up/update, e um Ctrl+C ou SIGHUP nele matava o mount (/data/shared "Transport endpoint is not
  # connected"). setsid(1) não existe no macOS: lá segue como antes.
  # stdio no log (#210): o rclone guarda um dup do stderr de quem chamou (fd 7, sem CLOEXEC) e o daemon herda;
  # se esse stderr fosse um pipe (oute up rodado pelo oute approve, `| tee`), o pipe nunca fechava.
  local detach=(); command -v setsid >/dev/null && detach=(setsid -w)
  ${detach[@]+"${detach[@]}"} rclone mount "oci:$bucket" "$dir" --daemon ${extra[@]+"${extra[@]}"} \
    --uid "$CONTAINER_UID" --gid "$(id -g)" --umask 002 \
    --vfs-cache-mode full --vfs-cache-max-size "${OUTE_SHARED_CACHE:-2G}" --vfs-cache-max-age 24h \
    --dir-cache-time 5m --cache-dir "$OUTE_HOME/rclone-cache" \
    --log-file "$OUTE_HOME/rclone.log" --log-level NOTICE </dev/null >>"$OUTE_HOME/rclone.log" 2>&1 \
    || { echo "rclone mount falhou (ver $OUTE_HOME/rclone.log); /data/shared fica local" >&2; return 0; }
  export OUTE_SHARED_DIR="$dir"
  echo "storage: oci:$bucket montado em $dir"
}

umount_shared() {
  local dir="$OUTE_HOME/shared"
  is_mounted "$dir" || return 0
  fusermount -u "$dir" 2>/dev/null || umount "$dir" 2>/dev/null || true
  echo "storage: $dir desmontado"
}

IMAGE="ghcr.io/renatobardi/oute-agent:${OUTE_VERSION}"

# imagem vem do CI (#2): login no ghcr com token só de leitura (vault: item github, campo GHCR_TOKEN) e pull
oute_pull() {
  # #21: só env ou agent.env, nunca o vault
  [[ -n "${GHCR_TOKEN:-}" ]] || load_agent_env
  local tok="${GHCR_TOKEN:-}"
  [[ -n "$tok" ]] || no_secret GHCR_TOKEN "vault: item github, token clássico com read:packages"
  printf '%s' "$tok" | docker login ghcr.io -u "${GHCR_USER:-renatobardi}" --password-stdin >/dev/null 2>&1 || die "login no ghcr falhou"
  local rc=0; docker pull -q "$IMAGE" || rc=$?
  # token só vive no vault: não deixa credencial em texto puro no ~/.docker/config.json
  docker logout ghcr.io >/dev/null 2>&1 || true
  [[ $rc -eq 0 ]] || die "imagem $IMAGE não existe no ghcr (o CI da tag v$OUTE_VERSION terminou?)"
  prune_local
}

# retenção local (mesma regra do ghcr): só a versão atual + a anterior do agent.
# Sem build local, o build cache é lixo puro (chegou a 5,5 GB) — limpa tudo.
prune_local() {
  local repo="${IMAGE%:*}" old
  old="$(docker images "$repo" --format '{{.Tag}}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+' | sort -rV | tail -n +3)"
  for t in $old; do [[ "$t" == "$OUTE_VERSION" ]] || docker rmi "$repo:$t" >/dev/null 2>&1 || true; done
  [[ "${OUTE_BUILD_LOCAL:-0}" == 1 ]] || docker builder prune -af >/dev/null 2>&1 || true
}

# no up: usa a imagem local; senão puxa do ghcr; build local só se OUTE_BUILD_LOCAL=1
ensure_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 && return 0
  if [[ "${OUTE_BUILD_LOCAL:-0}" == 1 ]]; then "$0" build; else oute_pull; fi
}

# --- reserva de disco da fila do collector (#163, ADR-04): 4 GB por host = 2 filas de 1 GB (bucket #161 e
# agent-studio #155) × 2 GB de disco cada (o bbolt chega a ~1,7× o limite da fila e não encolhe, #137)
QUEUE_VOLUME="${COMPOSE_PROJECT_NAME:-oute-agent}_oute-otel-queue"
QUEUE_RESERVE_KB=$((4 * 1024 * 1024))
kb_gb() { awk -v k="$1" 'BEGIN { printf "%.1f GB", k / 1048576 }'; }
# "<livre_kb> <fila_kb>" do disco onde o Docker guarda os volumes, medido de dentro de um container: no Mac é o
# disco da VM do Docker Desktop, não o do Mac. Volume ainda não criado = fila 0 (df na raiz do container, mesmo
# disco). Sem a imagem local (nunca baixa aqui) ou sem docker: rc 1.
queue_disk() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 || return 1
  local mnt=() out
  docker volume inspect "$QUEUE_VOLUME" >/dev/null 2>&1 && mnt=(-v "$QUEUE_VOLUME:/q:ro")
  out="$(docker run --rm --pull never --network none --user 0:0 --entrypoint sh ${mnt[@]+"${mnt[@]}"} "$IMAGE" -c \
    'if [ -d /q ]; then d=/q; u=$(du -sk /q | cut -f1); else d=/; u=0; fi; df -Pk "$d" | awk -v u="$u" "NR==2 {print \$4, u}"' \
    2>/dev/null)" || return 1
  [[ "$out" =~ ^[0-9]+\ [0-9]+$ ]] || return 1
  printf '%s\n' "$out"
}
# `oute up`: só avisa, nunca bloqueia a subida
queue_reserve_check() {
  local out free used need
  out="$(queue_disk)" || { echo "aviso: não medi o disco livre para a fila do collector (reserva de 4 GB, ADR-04)" >&2; return 0; }
  read -r free used <<<"$out"
  need=$(( QUEUE_RESERVE_KB - used )); (( need > 0 )) || need=0
  (( free >= need )) && return 0
  echo "aviso: disco do Docker com $(kb_gb "$free") livres não comporta a reserva de 4 GB da fila do collector" \
    "(a fila já ocupa $(kb_gb "$used"); faltam $(kb_gb $(( need - free )))). Com o OCI fora, a fila pode encher o disco." \
    "Libere espaço (docker system df) ou aumente o disco (no Mac: Docker Desktop → Resources). Subindo mesmo assim." >&2
}
# `oute status`: linha de disco com o tamanho do volume da fila
queue_status_line() {
  local out free used
  if out="$(queue_disk)"; then
    read -r free used <<<"$out"
    echo "disco do Docker: $(kb_gb "$free") livres · fila do collector ($QUEUE_VOLUME): $(kb_gb "$used") de 4 GB reservados"
  else
    echo "disco do Docker: não medido (sem docker ou sem a imagem $IMAGE local)"
  fi
}

oci_bootstrap() {
  need jq
  export BW_CLIENT_FILE="$OUTE_HOME/bw_client.env"
  # #21: sessão aberta agora (master password), só no env deste processo e do container; trancada ao sair
  BW_SESSION="$("$ROOT/scripts/oute-secrets.sh" session)" || die "não consegui abrir o vault"
  export BW_SESSION
  trap 'bw lock >/dev/null 2>&1 || true' EXIT
  docker run --rm -i --add-host "vault.oute.pro:${OUTE_VAULT_HOST_IP:-100.66.254.24}" \
    --user "$(id -u):$(id -g)" -e HOME=/tmp -e BITWARDENCLI_APPDATA_DIR=/bwcli \
    -e BW_SESSION -e DRY_RUN -e OUTE_OCI_BUDGET_EMAIL -e OUTE_OCI_SVC_EMAIL -e OUTE_BUCKET \
    -v "$OUTE_HOME/bwcli:/bwcli" -v "$ROOT/scripts:/opt/oute-scripts:ro" \
    --entrypoint bash "ghcr.io/renatobardi/oute-agent:${OUTE_VERSION}" /opt/oute-scripts/oci-bootstrap.sh "$@"
  # item oci-storage pode ter sido criado agora: agent.env relido com a mesma sessão (sem pedir a senha de novo)
  [[ "${DRY_RUN:-0}" == 1 ]] || vault_to_agent_env
}

# --- canal de aprovação (`oute approve`): o agente PROPÕE (oute-propose, dentro do container), o humano
# aprova AQUI, fora do alcance do container. O script é copiado para o host ANTES de ser mostrado, e o que roda
# é exatamente o que foi mostrado (sem TOCTOU). Conteúdo vem do container = não confiável: caracteres de controle
# (ESC, CR…) são neutralizados na exibição para nada ficar escondido.
AGENT_CTR=oute-agent
approve_dir="$OUTE_HOME/approve"
ctr() { docker exec "$AGENT_CTR" "$@"; }        # leitura (sem -i: não disputa o teclado com o read)
ctr_in() { docker exec -i "$AGENT_CTR" "$@"; }  # escrita (stdin -> container)
approve_pending() {
  local id
  for id in $(ctr sh -c 'ls -1 "$HOME"/outbox/*.sh 2>/dev/null' | sed 's|.*/||; s|\.sh$||' | grep -E '^[0-9]{8}-[0-9]{6}-[a-z0-9-]+$' || true); do
    # já decidido, resultado ainda não entregue (#210): nunca mostra (nem roda) de novo
    compgen -G "$approve_dir/runs/$id.*.result" >/dev/null || echo "$id"
  done
}
# evento operacional oute.canal.decided (ADR-04, #124): o oute-emit do container lê o cabeçalho do .out (nunca a
# saída). Sem -i (não disputa o teclado com o read); imagem sem oute-emit ou coletor fora do ar: segue em silêncio
approve_emit() { ctr oute-emit canal "$1" </dev/null >/dev/null 2>&1 || true; }
show_safe() { LC_ALL=C perl -pe 's/[\x00-\x08\x0b-\x1f\x7f]/\xc2\xb7/g; s/\xc2[\x80-\x9f]/\xc2\xb7/g' "$1"; }
# #210: a decisão fica PRIMEIRO no host (runs/<id>.<done|rejected>.result) e só depois vai ao container. O script
# aprovado pode ter recriado o próprio oute-agent (oute down/up/restart): o container some e volta no meio do
# fluxo. Entrega = inbox/<id>.out (rename atômico) + outbox/<id>.sh para done/ ou rejected/; tenta por até $2
# segundos (default OUTE_APPROVE_WAIT=90) e, se não der, o resultado segue no host e a próxima rodada do
# approve/watch entrega (o pedido não volta à fila enquanto isso).
approve_deliver() {
  local f="$1" tries="${2:-${OUTE_APPROVE_WAIT:-90}}" base id dest i=0
  base="${f##*/}"; base="${base%.result}"; dest="${base##*.}"; id="${base%.*}"
  while :; do
    if ctr_in sh -c 'mkdir -p "$HOME/inbox" "$HOME/outbox/$2" && cat > "$HOME/inbox/.tmp.$1" &&
        mv "$HOME/inbox/.tmp.$1" "$HOME/inbox/$1.out" &&
        { [ ! -e "$HOME/outbox/$1.sh" ] || mv "$HOME/outbox/$1.sh" "$HOME/outbox/$2/"; }' _ "$id" "$dest" \
        < "$f" >/dev/null 2>&1; then
      rm -f "$f"; approve_emit "$id"; return 0
    fi
    i=$((i + 1)); (( i < tries )) || break
    sleep 1
  done
  echo "aviso: $AGENT_CTR fora do ar; resultado de $id guardado em $f (o próximo oute approve/watch entrega)" >&2
  return 1
}
# resultados que ficaram no host (container fora quando foram decididos). $1 = segundos de espera pelo container
# (default 1 = uma tentativa, em silêncio, a cada volta do --watch); com espera, avisa e, se o primeiro não sair,
# os demais tentam uma vez só (o container continua fora)
approve_flush() {
  local tries="${1:-1}" f
  for f in "$approve_dir"/runs/*.result; do
    [[ -e "$f" ]] || continue
    if (( tries > 1 )); then approve_deliver "$f" "$tries" || tries=1
    else approve_deliver "$f" 1 2>/dev/null || true; fi
  done
  return 0
}
approve_one() {
  local id="$1" src title as sha ans rc=0 out t0 dur size res tailpid
  mkdir -p "$approve_dir/runs"; chmod 700 "$approve_dir"
  src="$approve_dir/runs/$id.sh"; out="$approve_dir/runs/$id.out"
  ctr sh -c 'head -c 65536 "$HOME/outbox/$1.sh"' _ "$id" > "$src" || { echo "não consegui ler $id" >&2; return 1; }
  title="$(sed -n 's/^# titulo: //p' "$src" | head -1 | LC_ALL=C tr -d '\000-\037\177' | cut -c1-120)"; as="$(sed -n 's/^# como: //p' "$src" | head -1)"
  [[ "$as" == root ]] || as=user
  sha="$( (shasum -a 256 "$src" 2>/dev/null || sha256sum "$src") | cut -c1-12)"
  printf '\n\033[1m━━━ pedido %s ━━━\033[0m\n' "$id"
  printf 'título: %s\n' "$title"
  if [[ "$as" == root ]]; then printf 'roda como: \033[1;31mROOT (sudo)\033[0m no host %s\n' "$OUTE_HOST"
  else printf 'roda como: %s no host %s\n' "$(id -un)" "$OUTE_HOST"; fi
  printf 'sha256: %s   linhas: %s\n\033[2m────────────────────────────────────────\033[0m\n' "$sha" "$(wc -l < "$src" | tr -d ' ')"
  show_safe "$src"
  printf '\033[2m────────────────────────────────────────\033[0m\n'
  read -r -p "executar? [s]im / [N]ão agora / [r]ecusar: " ans <"${OUTE_APPROVE_TTY:-/dev/tty}" || ans=""
  case "$ans" in
    s|S|sim)
      echo "── executando…"
      # set +e: script do agente que falha não pode derrubar o `oute` (pipefail + set -e) antes de devolver o resultado
      set +e
      # #210: saída direto em arquivo, nunca em pipe (| tee): processo que o script deixa em segundo plano (o
      # `oute up` sobe daemons) herda o stdout, o pipe nunca fecha e o tee esperava para sempre. O tail -f só
      # mostra na tela; o fim do script é o fim do bash, não o EOF de quem herdou o descritor.
      : > "$out"; tail -n +1 -f "$out" & tailpid=$!; trap 'kill "$tailpid" 2>/dev/null' EXIT
      t0="$(date +%s)"
      if [[ "$as" == root ]]; then sudo bash "$src" >> "$out" 2>&1; rc=$?
      else bash "$src" >> "$out" 2>&1; rc=$?; fi
      dur=$(( $(date +%s) - t0 )); size="$(wc -c < "$out" | tr -d ' ')"
      sleep 1; kill "$tailpid" 2>/dev/null; wait "$tailpid" 2>/dev/null; trap - EXIT
      set -e
      echo "── fim (código $rc)"
      res="$approve_dir/runs/$id.done.result"
      { printf '# id: %s\n# rc: %s\n# como: %s\n# aprovado: %s por %s@%s\n# sha256: %s\n# duracao: %s s\n# saida: %s bytes\n\n' \
          "$id" "$rc" "$as" "$(date -u +%FT%TZ)" "$(id -un)" "$OUTE_HOST" "$sha" "$dur" "$size"; tail -c 262144 "$out"; } > "$res"
      printf '%s\t%s\t%s\t%s\texec\trc=%s\t%s\n' "$(date -u +%FT%TZ)" "$OUTE_HOST" "$id" "$sha" "$rc" "$title" >> "$approve_dir/approve.log"
      approve_deliver "$res" || true ;;
    r|R)
      res="$approve_dir/runs/$id.rejected.result"
      printf '# id: %s\n# rc: 126\n# recusado: %s por %s@%s\n# sha256: %s\n\nrecusado pelo usuário; nada foi executado.\n' \
          "$id" "$(date -u +%FT%TZ)" "$(id -un)" "$OUTE_HOST" "$sha" > "$res"
      printf '%s\t%s\t%s\t%s\trecusado\t-\t%s\n' "$(date -u +%FT%TZ)" "$OUTE_HOST" "$id" "$sha" "$title" >> "$approve_dir/approve.log"
      approve_deliver "$res" || true
      echo "recusado." ;;
    *) echo "fica pendente." ;;
  esac
}
approve_usage() { echo "uso: oute approve [--watch | <id>]   (id: AAAAMMDD-HHMMSS-slug, como o oute-propose imprime)" >&2; }
approve() {
  # argumentos conferidos antes de tocar o container. #158: `oute approve <id>` decide só aquele pedido (o tray do
  # Mac abre o Terminal nele); id fora do formato do oute-propose = rc 2, sem docker exec nenhum
  local watch=0 one="" id seen=""
  case "$#:${1:-}" in
    0:) ;;
    1:--watch|1:-w) watch=1 ;;
    1:-*) approve_usage; return 2 ;;
    1:*) [[ "$1" =~ ^[0-9]{8}-[0-9]{6}-[a-z0-9-]+$ ]] || { echo "oute: id inválido: $(printf '%s' "$1" | LC_ALL=C tr -d '\000-\037\177' | cut -c1-80)" >&2; approve_usage; return 2; }
         one="$1" ;;
    *) approve_usage; return 2 ;;
  esac
  # #210: resultado guardado no host sai antes da guarda. `oute approve` chamado com o container fora (o script
  # aprovado reiniciou o agent) espera ele voltar por até OUTE_APPROVE_WAIT s e entrega, em vez de recusar de cara
  compgen -G "$approve_dir/runs/*.result" >/dev/null && approve_flush "${OUTE_APPROVE_WAIT:-90}"
  docker ps -q -f name="^${AGENT_CTR}\$" -f status=running | grep -q . || die "container $AGENT_CTR não está rodando"
  if [[ -n "$one" ]]; then
    approve_flush
    grep -qxF "$one" <<<"$(approve_pending)" || { echo "oute: pedido $one não está pendente (já decidido ou não existe)" >&2; return 1; }
    printf '\a'; approve_one "$one"; return 0
  fi
  while :; do
    approve_flush
    local ids; ids="$(approve_pending)"
    for id in $ids; do
      [[ " $seen " == *" $id "* ]] && continue   # 'N' = pula nesta rodada do --watch
      printf '\a'; approve_one "$id"; seen="$seen $id"
    done
    (( watch )) || { [[ -n "$ids" ]] || echo "nenhum pedido pendente."; return 0; }
    [[ -n "$ids" ]] || printf '\r\033[2maguardando pedidos em %s (%s)… Ctrl+C sai\033[0m ' "$AGENT_CTR" "$OUTE_HOST"
    sleep 3
  done
}

# `oute install`: link no PATH -> digitar só `oute` (Mac e oute-server)
install_link() {
  local target="$ROOT/scripts/oute" d dest=""
  for d in "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin; do
    [[ ":$PATH:" == *":$d:"* && -d "$d" && -w "$d" ]] && { dest="$d"; break; }
  done
  if [[ -z "$dest" ]]; then
    dest="$HOME/.local/bin"; mkdir -p "$dest"
    echo "aviso: $dest não está no PATH; adicione ao ~/.zshrc (Mac) ou ~/.bashrc: export PATH=\"\$HOME/.local/bin:\$PATH\"" >&2
  fi
  ln -sfn "$target" "$dest/oute" && echo "instalado: $dest/oute -> $target"
}

case "${1:-}" in
  "")      # sem argumento: abre o herdr; se a stack não estiver de pé, sobe antes
           docker ps -q -f name='^oute-agent$' -f status=running | grep -q . || "$0" up
           exec "$0" attach ;;
  install) install_link ;;
  update)  # de qualquer diretório: repo (git pull --tags) + imagem da versão nova + restart
           git -C "$ROOT" pull --tags --ff-only || die "git pull falhou em $ROOT (mudanças locais?)"
           exec "$ROOT/scripts/oute" _update2 ;;
  _update2) oute_pull && "$0" down && "$0" up && "$0" version ;;   # 2ª etapa já com o script novo
  approve) approve "${@:2}" ;;
  watch)   # atalho: aprovação em modo espera. Com host: roda no host remoto via ssh (ex.: oute watch oute-server)
           if [[ -n "${2:-}" ]]; then exec ssh -t "$2" 'bash -lc "oute approve --watch"'
           else approve --watch; fi ;;
  build)
    docker buildx version >/dev/null 2>&1 || echo "aviso: sem docker-buildx (Ubuntu: apt install docker-buildx; Mac: vem no Docker Desktop/OrbStack)" >&2
    # sem attestation de proveniência: não há registry ainda (#2) e ela só acrescenta um manifesto a cada export
    BUILDX_NO_DEFAULT_ATTESTATIONS=1 "${COMPOSE[@]}" build "${@:2}"
    # retenção (#12) SEM matar o cache usado agora: remove só o que não é usado há OUTE_BUILD_CACHE_TTL (default 72h).
    # (--max-used-space com -a apagava também o cache recente -> rebuild de 7 min; sem -a não apagava nada)
    docker builder prune -af --filter "until=${OUTE_BUILD_CACHE_TTL:-24h}" >/dev/null 2>&1 || true
    docker image prune -f >/dev/null 2>&1 || true
    docker system df --format '{{.Type}}: {{.Size}}' 2>/dev/null | grep -E '^(Images|Build Cache)' | tr '\n' ' '; echo
    df -h / | awk 'NR==2 {print "disco /: " $5 " usado (" $4 " livre)"}'
    ;;
  up)
    refresh=0; up_args=()
    for a in "${@:2}"; do if [[ "$a" == --refresh-secrets ]]; then refresh=1; else up_args+=("$a"); fi; done
    host_secrets "$refresh"; agent_studio_up; ensure_dirs; mount_shared
    legacy_cleanup
    ensure_image
    queue_reserve_check
    "${COMPOSE[@]}" up -d --no-build ${up_args[@]+"${up_args[@]}"}; "$0" status; wait_sshd
    # imagem antiga só fica "solta" depois que o container é recriado -> limpa aqui (retenção, #12)
    docker image prune -f >/dev/null 2>&1 || true
    ;;
  # --profile: down/logs/status enxergam também o agent-studio, quando ele existe (no Mac não há nada dele)
  down)    legacy_cleanup; "${COMPOSE[@]}" --profile "$STUDIO_PROFILE" down "${@:2}"; umount_shared ;;
  restart) "$0" down; "$0" up ;;
  logs)    "${COMPOSE[@]}" --profile "$STUDIO_PROFILE" logs --tail=100 "${@:2}" ;;
  follow)  "${COMPOSE[@]}" --profile "$STUDIO_PROFILE" logs -f "${@:2}" ;;
  status)  "${COMPOSE[@]}" --profile "$STUDIO_PROFILE" ps; queue_status_line ;;
  attach)  exec ssh -p "$SSH_PORT" -t "oute@$SSH_HOST" 'herdr attach 2>/dev/null || herdr' ;;
  ssh)     # com comando: -t quando há terminal (CLIs em modo headless podem ler stdin se não for TTY e ficar esperando EOF)
           if [[ $# -gt 1 ]]; then t=(); [[ -t 0 ]] && t=(-t)
             exec ssh ${t[@]+"${t[@]}"} -p "$SSH_PORT" "oute@$SSH_HOST" bash -lc "$(printf '%q ' "${@:2}")"
           else exec ssh -p "$SSH_PORT" "oute@$SSH_HOST"; fi ;;
  shell)   exec docker exec -it oute-agent bash -l ;;
  sync-shared) mount_shared ;;
  oci-bootstrap) oci_bootstrap "${@:2}" ;;
  pull)    oute_pull ;;
  storage)   # acesso direto ao bucket, sem passar pelo mount: oute storage ls | lsl | about | <qualquer subcomando rclone>
    oci_remote_env || die "item oci-storage ausente no vault (rode: oute oci-bootstrap)"
    sub="${2:-ls}"; rclone "$sub" "oci:${OUTE_BUCKET:-oute-shared}${3:+/$3}" "${@:4}" ;;   # DRY_RUN=1 oute oci-bootstrap pra só ver o que faria
  lock)    "$ROOT/scripts/oute-secrets.sh" lock ;;
  secrets)   # #21: relê o vault (pede a master password), regrava agent.env e tranca a sessão
    [[ "${2:-}" == refresh ]] || { echo "uso: oute secrets refresh" >&2; exit 2; }
    host_secrets 1
    docker ps -q -f name='^oute-agent$' -f status=running | grep -q . && echo "o container lê agent.env ao subir: oute restart"
    exit 0 ;;
  version)
    echo "repo:    $VERSION ($(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo '?'))"
    img="$(docker inspect -f '{{index .Config.Labels "org.opencontainers.image.version"}}' oute-agent 2>/dev/null || true)"
    echo "running: ${img:-não está rodando}"
    echo "origem:  host=$OUTE_HOST instance=$OUTE_INSTANCE"
    ;;
  help|guide)  # guia completo (host + container); o mesmo arquivo vai na imagem
    if [[ -t 1 ]] && command -v less >/dev/null; then less -FRX "$ROOT/docker/comandos.md"; else cat "$ROOT/docker/comandos.md"; fi ;;
  *)
    [[ "$1" == -h || "$1" == --help ]] || echo "oute: comando desconhecido: $1" >&2
    echo "(guia completo com receitas e comandos do container: oute help)"
    cat <<'EOF'
uso: oute [cmd]     (sem cmd: sobe a stack se preciso e abre o herdr)
  help         guia completo: receitas, comandos do host e do container
  install      link no PATH para chamar só `oute` de qualquer lugar
  update       de qualquer diretório: git pull --tags no repo + pull da imagem + down + up + version
  approve [--watch]  revisa e executa (ou recusa) os scripts que os agentes propuseram com oute-propose
  approve <id>       decide só aquele pedido (id do oute-propose); não pendente = rc 1, id inválido = rc 2
  watch [host]       = approve --watch; com host (ex.: oute-server), abre a espera naquele host via ssh
  pull         baixa a imagem da versão atual do ghcr (feita pelo CI na tag)
  build        constrói a imagem localmente (fallback; normal é o CI) (arm64; mantém cache usado nas últimas 72h)
  up [--refresh-secrets]  sobe agent + ai-memory + otel-collector com os segredos de ~/.oute/agent.env
               (+ agent-studio no host com OUTE_AGENT_STUDIO=1 no .env e o item agent-studio no vault, ADR-08;
                nos outros, o collector manda ao agent-studio.oute.pro pela tailnet com o mesmo token, #190)
               (senha do Vaultwarden só sem agent.env ou com --refresh-secrets)
  secrets refresh  relê o Vaultwarden (pede a master password), regrava ~/.oute/agent.env e tranca a sessão
  down|restart
  attach       ssh -> herdr
  ssh [cmd]    ssh direto no container
  shell        docker exec bash
  logs [svc] | follow [svc]
  status       serviços + disco do Docker e tamanho da fila do collector (reserva de 4 GB)
  sync-shared  monta bucket OCI em ~/.oute/shared via rclone (credencial: item oci-storage do vault)
  storage [ls|lsl|about] [path]  lista o bucket direto no OCI (confere o que o mount enviou)
  oci-bootstrap  provisiona compartment/buckets/IAM/budget no OCI e grava a chave S3 no vault [DRY_RUN=1] (pede a senha)
  lock         tranca o Vaultwarden (bw lock) e apaga a sessão em cache das versões antigas
  version      versão do repo e da imagem em execução
EOF
    ;;
esac
