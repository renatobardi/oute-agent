#!/usr/bin/env bash
# oute — CLI do host (Mac ou LXC) para operar o runtime
#   oute up | down | build | attach | shell | logs | sync-shared | status
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="$(tr -d '[:space:]' < "$ROOT/VERSION")"
export OUTE_VERSION="$VERSION"
# --project-directory: .env e paths relativos resolvem na raiz do repo, não em docker/
COMPOSE=(docker compose --project-directory "$ROOT" -f "$ROOT/docker/compose.yaml")
export OUTE_HOME="${OUTE_HOME:-$HOME/.oute}"
SSH_PORT="${OUTE_SSH_PORT:-2222}"
SSH_HOST="${OUTE_SSH_HOST:-localhost}"

die() { printf 'oute: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "precisa de '$1' no host"; }

# sem bw nativo no host (ex.: sem node), usa o bw da própria imagem
bw() {
  if type -P bw >/dev/null 2>&1; then command bw "$@"; return; fi
  mkdir -p "$OUTE_HOME/bwcli"
  docker run --rm -i --add-host "vault.oute.pro:${OUTE_VAULT_HOST_IP:-100.66.254.24}" \
    -e BW_SESSION -e BW_CLIENTID -e BW_CLIENTSECRET -e BW_PASSWORD \
    -v "$OUTE_HOME/bwcli:/home/oute/.config/Bitwarden CLI" \
    "ghcr.io/renatobardi/oute-agent:${OUTE_VERSION}" bw "$@"
}
export -f bw

# --- segredos do host: só o mínimo que o compose precisa antes do agent subir
host_secrets() {
  need jq
  [[ -f "$OUTE_HOME/bw_client.env" ]] || die "crie $OUTE_HOME/bw_client.env com BW_CLIENTID/BW_CLIENTSECRET (chmod 600)"
  # oute-secrets reutiliza a sessão em cache ($OUTE_HOME/bw_session) e só pede a master password se precisar
  export BW_CLIENT_FILE="$OUTE_HOME/bw_client.env"
  OPENROUTER_API_KEY="$("$ROOT/scripts/oute-secrets.sh" get OPENROUTER_API_KEY)" || die "OPENROUTER_API_KEY ausente no vault"
  export OPENROUTER_API_KEY
  # token do ai-memory (item "ai-memory", field AI_MEMORY_AUTH_TOKEN); vazio = sem auth (rede interna)
  AI_MEMORY_AUTH_TOKEN="$("$ROOT/scripts/oute-secrets.sh" get AI_MEMORY_AUTH_TOKEN 2>/dev/null || true)"
  export AI_MEMORY_AUTH_TOKEN
  # sessão desbloqueada vai pro container (mesmo estado do bw via volume bwcli) -> sem 2º prompt
  BW_SESSION="$(<"$OUTE_HOME/bw_session")"; export BW_SESSION
  export OUTE_BW_CLIENT_FILE="$OUTE_HOME/bw_client.env"
}

router_sync() {
  [[ -n "${OPENROUTER_API_KEY:-}" ]] || {
    export BW_CLIENT_FILE="$OUTE_HOME/bw_client.env"
    OPENROUTER_API_KEY="$("$ROOT/scripts/oute-secrets.sh" get OPENROUTER_API_KEY)" || die "OPENROUTER_API_KEY ausente no vault"
    export OPENROUTER_API_KEY
  }
  docker run --rm -e OPENROUTER_API_KEY -v "$ROOT:/w" -w /w --user "$(id -u):$(id -g)" \
    --entrypoint python3 ghcr.io/berriai/litellm:main-latest scripts/router_sync.py "$@"
}

# gerados pelo router-sync; sem eles o compose montaria diretórios vazios
router_files_ok() {
  local f; for f in router.yaml config.yaml candidates.json; do [[ -s "$ROOT/config/litellm/$f" ]] || return 1; done
}

ensure_dirs() {
  mkdir -p "$OUTE_HOME/shared"
  export OUTE_SHARED_DIR="$OUTE_HOME/shared"
}

# --- rclone mount do bucket OCI (opcional; pula se rclone/remote ausente)
mount_shared() {
  command -v rclone >/dev/null || { echo "rclone ausente; /data/shared fica local"; return; }
  rclone listremotes 2>/dev/null | grep -q '^oci:' || { echo "remote 'oci' não configurado; /data/shared fica local"; return; }
  mountpoint -q "$OUTE_HOME/shared" 2>/dev/null && return
  rclone mount "oci:${OUTE_BUCKET:-oute-shared}" "$OUTE_HOME/shared" \
    --vfs-cache-mode full --dir-cache-time 30s --daemon
  echo "montado oci:${OUTE_BUCKET:-oute-shared} em $OUTE_HOME/shared"
}

case "${1:-}" in
  build)   "${COMPOSE[@]}" build ;;
  up)
    host_secrets; ensure_dirs; mount_shared
    # catálogo do router sempre fresco; se o OpenRouter falhar, segue com o último gerado
    router_sync || { router_files_ok && echo "router-sync falhou; usando catálogo anterior" >&2 || die "router-sync falhou e não há catálogo gerado"; }
    "${COMPOSE[@]}" up -d "${@:2}"; "$0" status
    ;;
  down)    "${COMPOSE[@]}" down "${@:2}" ;;
  restart) "$0" down; "$0" up ;;
  logs)    "${COMPOSE[@]}" logs --tail=100 "${@:2}" ;;
  follow)  "${COMPOSE[@]}" logs -f "${@:2}" ;;
  status)  "${COMPOSE[@]}" ps ;;
  attach)  exec ssh -p "$SSH_PORT" -t "oute@$SSH_HOST" 'herdr attach 2>/dev/null || herdr' ;;
  ssh)     if [[ $# -gt 1 ]]; then exec ssh -p "$SSH_PORT" "oute@$SSH_HOST" bash -lc "$(printf '%q ' "${@:2}")"; else exec ssh -p "$SSH_PORT" "oute@$SSH_HOST"; fi ;;
  shell)   exec docker exec -it oute-agent bash -l ;;
  sync-shared) mount_shared ;;
  lock)    "$ROOT/scripts/oute-secrets.sh" lock ;;
  router-sync)
    # consulta OpenRouter (modelos elegíveis pela key/guardrail) e regenera config do router a partir de policy.yaml
    router_sync "${@:2}"
    if [[ " ${*:2} " != *" --dry-run "* ]] && docker ps -q -f name=oute-jev-router | grep -q .; then
      "${COMPOSE[@]}" restart jev-router agent >/dev/null && echo "jev-router e agent reiniciados"
    fi
    ;;
  schedule)
    # router-sync diário às 04:00 (hora do host); idempotente
    line="0 4 * * * cd $ROOT && ./scripts/oute router-sync >> $OUTE_HOME/router-sync.log 2>&1"
    ( crontab -l 2>/dev/null | grep -v 'oute router-sync'; echo "$line" ) | crontab -
    echo "agendado: $line"
    ;;
  version)
    echo "repo:    $VERSION ($(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo '?'))"
    img="$(docker inspect -f '{{index .Config.Labels "org.opencontainers.image.version"}}' oute-agent 2>/dev/null || true)"
    echo "running: ${img:-não está rodando}"
    ;;
  *)
    cat <<EOF
uso: oute <cmd>
  build        constrói a imagem (arm64)
  up           sobe agent + jev-router + ai-memory (pede master password do Vaultwarden)
  down|restart
  attach       ssh -> herdr
  ssh [cmd]    ssh direto no container
  shell        docker exec bash
  logs [svc]
  status
  sync-shared  monta bucket OCI em ~/.oute/shared via rclone
  lock         apaga a sessão do Vaultwarden em cache (próximo up pede a master password)
  router-sync  consulta OpenRouter e regenera router.yaml/config.yaml a partir de policy.yaml [--dry-run]
               (roda sozinho em todo `up`)
  schedule     agenda router-sync diário (crontab do host, 04:00)
  version      versão do repo e da imagem em execução
EOF
    ;;
esac
