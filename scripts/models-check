#!/usr/bin/env python3
"""models-check — confere a tabela do seletor (config/select/models.toml, ADR-02) contra os CLIs instalados (#220).

  scripts/models-check [--table <arquivo>]

Sem nenhuma chamada a modelo: só lê arquivos locais (e os labels do repo, pelo `gh`).
  - Claude: o id tem que estar no binário instalado (o `claude` do PATH, sem o shim, ou a reserva da imagem;
    $OUTE_MODELS_CLAUDE_BIN aponta outro arquivo).
  - Codex: `slug` e esforço em ${CODEX_HOME:-~/.codex}/models_cache.json (`supported_reasoning_levels`). Cache
    ausente, ilegível ou com mais de 7 dias = `desconhecido`, com aviso (o Codex o renova ao abrir).
  - Revisor das etapas (#507): `[[reviewer]]` só com agent = "claude" (a linha com "codex" é recusada, código 2), o modelo conferido como os demais, o autor na tabela, o revisor diferente do
    autor e o autor do dispatcher (fase plan) com revisor.
  - Assinaturas (#598): `[[subscription]]` com nomes únicos e `[select] reserve_mode` = `mais-livre` ou `ordem` (senão, código 2);
    uma assinatura padrão só e uma coluna de modelo dessa assinatura em toda linha (senão, FALTA). Só `claude` e `codex`
    têm conferência dos ids, e a `zai` (#677, abaixo); o id de outra assinatura sai `desconhecido`, com aviso.
  - `chain` (#677, a cadeia da linha, em `[default]`, `[[line]]` e `[[exception]]`): lista de nomes de `[[subscription]]`, sem repetir
    (nome fora da tabela ou repetido = FALTA; lista vazia ou que não é de texto = código 2), e toda assinatura da cadeia com
    coluna de modelo na linha.
  - Zai (#677): com $OUTE_ZAI_API_KEY, o id da coluna `zai` tem que estar em `GET https://api.z.ai/api/anthropic/v1/models`
    ($OUTE_MODELS_ZAI_URL troca o endereço, só https://); a chave vai só no cabeçalho. Sem a chave, ou com a API fora do ar,
    `desconhecido` (código 3), nunca FALTA.
  - Estrutura: toda fase do ADR-07 e a faixa `ctx` têm linha, só elas são chave, toda fase de `unless_phases` de uma
    exceção é do ADR-07 (#409), e toda exceção usa um label que existe no repo (`gh label list`; sem resposta do `gh` = `desconhecido`).

Uma linha por conferência, no stdout: `ok <o quê> (<onde>)`, `FALTA <o quê> (<onde>)` ou `desconhecido …`.
Avisos em stderr. Código de saída: 0 tudo ok; 1 algum FALTA; 3 nenhum FALTA, mas algo `desconhecido` (não foi
conferido); 2 argumento inválido ou tabela ilegível.
"""
import datetime
import json
import mmap
import os
import re
import subprocess
import sys
import tomllib
import urllib.error
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
PHASES = ("strat", "intent", "spec", "arch", "design", "plan", "build", "qa", "ship", "ops", "learn", "iter", "ctx")
CACHE_MAX_DAYS = 7
ID_CHARS = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-"
SHIM = "oute-agent-shim"
USAGE = "uso: models-check [--table <arquivo>]"

status = {"FALTA": 0, "desconhecido": 0}


def die(msg):
    print(f"models-check: {msg}", file=sys.stderr)
    sys.exit(2)


def warn(msg):
    print(f"models-check: aviso: {msg}", file=sys.stderr)


def report(state, what, where):
    if state in status:
        status[state] += 1
    print(f"{state} {what} ({where})")


RESERVE_MODES = ("mais-livre", "ordem")
SUB_NAME_RE = re.compile(r"[a-z][a-z0-9-]*")


def load_subscriptions(t, path):
    """([assinatura], modo das reservas) de `[[subscription]]` e `[select]`; die (código 2) se estão fora do formato"""
    subs, mode = t.get("subscription"), (t.get("select") or {}).get("reserve_mode", "mais-livre")
    if not isinstance(subs, list) or not subs or not all(
            isinstance(x, dict) and isinstance(x.get("name"), str) and SUB_NAME_RE.fullmatch(x["name"]) for x in subs):
        die(f"tabela sem [[subscription]] com name válido ({path})")
    names = [x["name"] for x in subs]
    if len(set(names)) != len(names):
        die(f"[[subscription]] com nome repetido ({path})")
    if mode not in RESERVE_MODES:
        die(f"[select] reserve_mode desconhecido: {mode!r} (use {' ou '.join(RESERVE_MODES)}) ({path})")
    return subs, mode


def load_table(path):
    """linhas da tabela, na ordem: [(nome, linha)] do padrão, das fases e das exceções; e as assinaturas"""
    try:
        with open(path, "rb") as f:
            t = tomllib.load(f)
    except (OSError, ValueError) as e:   # tomllib.TOMLDecodeError é ValueError
        die(f"tabela ilegível ({path}: {e})")
    lines, exceptions, reviewers = t.get("line", []), t.get("exception", []), t.get("reviewer", [])
    if (not isinstance(t.get("default"), dict) or not isinstance(lines, list) or not isinstance(exceptions, list)
            or not isinstance(reviewers, list)):
        die(f"tabela sem [default], ou com [[line]]/[[exception]] fora do formato ({path})")
    subs, mode = load_subscriptions(t, path)
    rows = [("[default]", t["default"])]
    rows += [(f"[[line]] {i}", ln) for i, ln in enumerate(lines, 1)]
    rows += [(f"[[exception]] {i}", ex) for i, ex in enumerate(exceptions, 1)]
    for name, row in rows:
        if not isinstance(row, dict) or not isinstance(row.get("effort"), str) or not row["effort"]:
            die(f"{name} sem effort ({path})")
    for i, ln in enumerate(lines, 1):
        if not isinstance(ln.get("phases"), list) or not all(isinstance(p, str) for p in ln["phases"]):
            die(f"[[line]] {i} sem phases ({path})")
    for name, row in rows:
        ch = row.get("chain")
        if ch is not None and (not isinstance(ch, list) or not ch or not all(isinstance(x, str) and x for x in ch)):
            die(f"{name} com chain fora do formato (lista de nomes de assinatura) ({path})")
    for i, ex in enumerate(exceptions, 1):
        if not isinstance(ex.get("label"), str) or not ex["label"]:
            die(f"[[exception]] {i} sem label ({path})")
        if not isinstance(ex.get("unless_phases", []), list) or not all(isinstance(p, str) for p in ex.get("unless_phases", [])):
            die(f"[[exception]] {i} com unless_phases inválido ({path})")
    for i, rv in enumerate(reviewers, 1):   # #507: o par autor × revisor das etapas da rodada
        if isinstance(rv, dict) and rv.get("agent") == "codex":
            die(f"[[reviewer]] {i}: agent = \"codex\" não vale por enquanto (o codex herdaria o ~/.codex, sem isolamento conferido, #507); use claude ({path})")
        if (not isinstance(rv, dict) or rv.get("agent") != "claude"
                or not all(isinstance(rv.get(k), str) and rv[k] for k in ("model", "effort"))
                or not isinstance(rv.get("writers"), list) or not rv["writers"]
                or not all(isinstance(w, str) and w for w in rv["writers"])):
            die(f"[[reviewer]] {i} sem writers, agent (claude), model ou effort ({path})")
    return rows, lines, exceptions, reviewers, subs, mode


def column(rows, name):
    """os ids da coluna de uma assinatura nas linhas que a têm (string não vazia), sem repetir"""
    return list(dict.fromkeys(r[name] for _, r in rows if isinstance(r.get(name), str) and r[name]))


def claude_bin():
    """binário instalado do claude: o do PATH que não é o shim, senão a reserva da imagem; None se não há"""
    explicit = os.environ.get("OUTE_MODELS_CLAUDE_BIN")
    if explicit:
        return explicit if os.path.isfile(explicit) else None
    dirs = os.environ.get("PATH", "").split(os.pathsep)
    dirs.append(os.environ.get("OUTE_AGENTS_FALLBACK", "/opt/oute/agents/bin"))
    for d in dirs:
        p = os.path.realpath(os.path.join(d or ".", "claude"))
        if os.path.isfile(p) and os.path.basename(p) != SHIM:
            return p
    return None


def in_binary(mm, model):
    """o id aparece inteiro no binário (não como parte de um id mais longo)"""
    needle, at = model.encode(), 0
    while (at := mm.find(needle, at)) != -1:
        end = at + len(needle)
        if (at == 0 or mm[at - 1] not in ID_CHARS) and (end == len(mm) or mm[end] not in ID_CHARS):
            return True
        at += 1
    return False


def check_claude(models):
    path = claude_bin()
    try:
        if path is None:
            raise OSError("binário do claude não encontrado")
        with open(path, "rb") as f, mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as mm:
            for m in models:
                report("ok" if in_binary(mm, m.removesuffix("[1m]")) else "FALTA", m, "claude")
    except (OSError, ValueError) as e:   # ValueError: arquivo vazio não mapeia
        warn(f"Claude não conferido ({path or 'claude'}: {e})")
        for m in models:
            report("desconhecido", m, "claude")


def codex_cache():
    """{slug: [esforços]} do cache de modelos do Codex; None (com aviso) se ausente, ilegível ou velho"""
    path = os.path.join(os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex"), "models_cache.json")
    try:
        with open(path, encoding="utf-8") as f:
            cache = json.load(f)
        try:
            fetched = datetime.datetime.fromisoformat(re.sub(r"(\.\d{6})\d*", r"\1", cache["fetched_at"]))
        except (KeyError, TypeError, ValueError):   # sem a data no arquivo, vale a do próprio arquivo
            fetched = datetime.datetime.fromtimestamp(os.path.getmtime(path), datetime.timezone.utc)
        if fetched.tzinfo is None:
            fetched = fetched.replace(tzinfo=datetime.timezone.utc)
        age = (datetime.datetime.now(datetime.timezone.utc) - fetched).days
        if age > CACHE_MAX_DAYS:
            warn(f"cache de modelos do Codex com {age} dias, mais de {CACHE_MAX_DAYS} ({path}); "
                 "o Codex o renova ao abrir")
            return None
        return {m["slug"]: [lv["effort"] for lv in m.get("supported_reasoning_levels", [])] for m in cache["models"]}
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as e:
        warn(f"cache de modelos do Codex ausente ou ilegível ({path}: {e}); o Codex o cria ao abrir")
        return None


def check_codex(pairs):
    cache = codex_cache()
    for model in dict.fromkeys(m for m, _ in pairs):
        if cache is None:
            report("desconhecido", model, "codex")
        else:
            report("ok" if model in cache else "FALTA", model, "codex")
    for model, effort in pairs:
        if cache is None:
            report("desconhecido", f"{model} esforço {effort}", "codex")
        elif model in cache:   # id que falta já saiu acima
            report("ok" if effort in cache[model] else "FALTA", f"{model} esforço {effort}", "codex")


def repo_labels():
    """labels do repo pelo `gh`; None (com aviso) se o gh não respondeu"""
    try:
        r = subprocess.run(["gh", "label", "list", "--limit", "1000", "--json", "name"], cwd=ROOT,
                           capture_output=True, text=True, timeout=20, stdin=subprocess.DEVNULL)
        if r.returncode != 0:
            raise ValueError(f"código {r.returncode}")
        return {x["name"] for x in json.loads(r.stdout)}
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError) as e:
        warn(f"o gh não listou os labels do repo ({e}); exceções não conferidas")
        return None


def check_reviewers(lines, reviewers):
    """#507: o revisor de cada etapa é de outro modelo que o autor, o autor é um modelo da tabela, e o autor do
    dispatcher (fase plan, que escreve as etapas) tem revisor"""
    known = {m for ln in lines for k, m in ln.items() if k not in ("phases", "effort") and isinstance(m, str)}
    for i, rv in enumerate(reviewers, 1):
        for w in rv["writers"]:
            report("ok" if w in known else "FALTA", f"autor {w} do revisor {i} é um modelo da tabela", "tabela")
            report("FALTA" if w == rv["model"] else "ok", f"revisor {rv['model']} é de outro modelo que o autor {w}", "tabela")
    plan = next((ln for ln in lines if "plan" in ln["phases"]), None)
    if plan:
        for w in dict.fromkeys(m for k, m in plan.items() if k not in ("phases", "effort") and isinstance(m, str)):
            have = any(w in rv["writers"] for rv in reviewers)
            report("ok" if have else "FALTA", f"revisor do autor {w} (dispatcher, fase plan)", "tabela")


def check_subscriptions(rows, subs):
    """#598: uma assinatura padrão só; toda assinatura com o modelo em toda linha da tabela"""
    defaults = [x["name"] for x in subs if x.get("default") is True]
    report("ok" if len(defaults) == 1 else "FALTA", f"uma assinatura padrão só ({', '.join(defaults) or 'nenhuma'})", "tabela")
    for x in subs:
        for rname, row in rows:
            have = isinstance(row.get(x["name"]), str) and bool(row[x["name"]])
            report("ok" if have else "FALTA", f"modelo da assinatura {x['name']} em {rname}", "tabela")


def check_chains(rows, subs):
    """#677: a cadeia de cada linha só tem nomes da tabela, sem repetir, e cada um com coluna de modelo na linha"""
    names = [x["name"] for x in subs]
    for rname, row in rows:
        ch = row.get("chain")
        if ch is None:
            continue
        for n in dict.fromkeys(ch):
            report("ok" if n in names else "FALTA", f"assinatura {n} da chain de {rname} é da tabela", "tabela")
            have = isinstance(row.get(n), str) and bool(row[n])
            report("ok" if have else "FALTA", f"modelo da assinatura {n} da chain de {rname}", "tabela")
        report("ok" if len(set(ch)) == len(ch) else "FALTA", f"chain de {rname} sem assinatura repetida", "tabela")


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k):   # redirecionamento levaria o Authorization a outro host
        return None


def zai_models(key):
    """{ids} de GET /v1/models da Z.ai; None (com aviso, sem a chave nem o corpo) em qualquer falha"""
    url = os.environ.get("OUTE_MODELS_ZAI_URL", "https://api.z.ai/api/anthropic/v1/models")
    if not url.startswith("https://"):
        die("OUTE_MODELS_ZAI_URL só pode ser https://")
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {key}", "Accept": "application/json"})
    try:
        with urllib.request.build_opener(NoRedirect).open(req, timeout=10) as r:
            data = json.loads(r.read(1 << 20))["data"]
        return {m["id"] for m in data if isinstance(m, dict) and isinstance(m.get("id"), str)}
    except urllib.error.HTTPError as e:
        warn(f"a API da Z.ai respondeu HTTP {e.code}; ids da zai não conferidos")
    except (OSError, ValueError, KeyError, TypeError) as e:
        warn(f"a API da Z.ai não respondeu com a lista de modelos ({type(e).__name__}); ids da zai não conferidos")
    return None


def check_zai(models):
    key = os.environ.get("OUTE_ZAI_API_KEY", "").strip()
    if not key:
        warn("sem OUTE_ZAI_API_KEY: ids da zai não conferidos na API da Z.ai")
    ids = zai_models(key) if key else None
    for m in models:
        report("desconhecido" if ids is None else "ok" if m in ids else "FALTA", m, "zai")
    return 0


def check_structure(lines, exceptions):
    keys = [p for ln in lines for p in ln["phases"]]
    for p in PHASES:
        report("ok" if p in keys else "FALTA", f"linha da fase {p}", "tabela")
    for p in dict.fromkeys(keys):
        if p not in PHASES:
            report("FALTA", f"fase {p}", "ADR-07")
    for ex in exceptions:   # #409: fase citada na ressalva da exceção tem que ser do ADR-07
        for p in ex.get("unless_phases", []):
            report("ok" if p in PHASES else "FALTA", f"fase {p} em unless_phases de {ex['label']}", "tabela")
    if exceptions:
        labels = repo_labels()
        for ex in exceptions:
            state = "desconhecido" if labels is None else "ok" if ex["label"] in labels else "FALTA"
            report(state, f"label {ex['label']}", "repo")


def main(argv):
    table = os.path.join(ROOT, "config", "select", "models.toml")
    it = iter(argv)
    for a in it:
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if a != "--table":
            die(f"opção desconhecida: {a}\n{USAGE}")
        table = next(it, None)
        if table is None:
            die(f"--table sem valor\n{USAGE}")
    rows, lines, exceptions, reviewers, subs, _ = load_table(table)
    check_subscriptions(rows, subs)
    names = [x["name"] for x in subs]
    if "claude" in names:
        check_claude(list(dict.fromkeys(column(rows, "claude") + [rv["model"] for rv in reviewers])))
    if "codex" in names:
        check_codex(list(dict.fromkeys((r["codex"], r["effort"]) for _, r in rows
                                       if isinstance(r.get("codex"), str) and r["codex"])))
    if "zai" in names:
        check_zai(column(rows, "zai"))
    check_chains(rows, subs)
    for name in names:
        if name not in ("claude", "codex", "zai"):
            warn(f"assinatura {name}: sem conferência dos ids (só claude e codex têm); fica `desconhecido`")
            for m in column(rows, name):
                report("desconhecido", m, name)
    check_reviewers(lines, reviewers)
    check_structure(lines, exceptions)
    if status["FALTA"]:
        return 1
    return 3 if status["desconhecido"] else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
