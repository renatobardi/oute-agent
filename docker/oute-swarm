#!/usr/bin/env bash
# oute-swarm — várias sessões de agente em paralelo, uma por issue, coordenadas por uma sessão do Claude.
#
#   oute-swarm <repo> [--max N] [--label L]         abre o dispatcher (worktree própria) com o prompt padrão.
#              [--agent claude|codex]               --agent: agente das sessões da rodada (sem ele: claude)
#   oute-swarm spawn <n>-<slug> "<instrução>"       (usado pelo dispatcher) abre uma aba do herdr com
#              [--agent claude|codex] [--force]     oute-task + agente na worktree da issue. --agent: sobrepõe o da
#              [--model <id>] [--repo <repo>]       rodada. --model: modelo da sessão (sem ele: o da fase da issue,
#              [--kaizen]                           pelo oute-select). --repo: outro repo (padrão: o da rodada);
#                                                   --kaizen: sessão kaizen, fora do --max
#   oute-swarm tell <n>-<slug> "<mensagem>"         repassa uma decisão/instrução do Bardi à sessão parada (digita,
#              [--force]                            confere o campo e só então Enter). --force (só o Bardi): sessão ocupada
#              [--wait [--timeout <s>]]             --wait: espera a sessão parar (relê a cada 5 s, OUTE_SWARM_TELL_POLL) e
#                                                   envia; sem --force; timeout padrão 600 s, recusa final com código 3
#   oute-swarm close <n>-<slug>|--all [--yes]      fecha a(s) aba(s) do herdr da rodada (encerra o agente). Sem --yes: só mostra
#   oute-swarm list                                 abas abertas por este dispatcher + worktrees de tarefa
#
# Repo: nome em /workspace (ex.: lab) ou caminho. Default --max 3; --label filtra issues por label.
# --max = abas abertas ao mesmo tempo na rodada (kaizen fora): aba fechada com `oute-swarm close` libera a vaga.
# Rodada de spawn/tell/close/watch: OUTE_SWARM_ID; sem ele, na worktree do dispatcher (sessao/swarm-<id>), a dele (com
# aviso); fora dela, spawn grava em "avulso" e tell/close/watch usam a rodada mais recente.
# Triagem, espera do ok do Bardi, acompanhamento e limpeza estão no prompt (/usr/local/lib/oute/swarm.md).
# O dispatcher nunca faz merge sem pedido explícito; ações no host só pelo canal de aprovação.
set -euo pipefail
LIB="${OUTE_LIB:-/usr/local/lib/oute}"
STATE_ROOT="${HOME}/.oute/swarm"
die() { printf 'oute-swarm: %s\n' "$*" >&2; exit 1; }
slugify() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' | tr -s '-' | sed 's/^-//; s/-$//' | cut -c1-40; }
# log da rodada = linha do tempo completa; cada linha gravada vira também um evento operacional (ADR-04, #124):
# oute-emit best-effort (timeout curto, sempre 0, sem stdout); sem ele na imagem, só o log
slog() {
  printf '%s\n' "$2" >> "$1/log" || true
  if command -v oute-emit >/dev/null 2>&1; then oute-emit swarm "$(basename "$1")" "$2" >/dev/null 2>&1 || true; fi
}
# snapshot da cota das assinaturas no spawn e no close (#347): o oute-emit lê o `oute-quota --json` e emite as métricas.
# Em segundo plano e sem saída: a leitura (até ~6 s) nunca atrasa nem derruba o comando; sem oute-quota ou oute-emit, nada
quota_snapshot() {
  command -v oute-quota >/dev/null 2>&1 && command -v oute-emit >/dev/null 2>&1 || return 0
  ( oute-emit quota "$1" </dev/null >/dev/null 2>&1 & ) >/dev/null 2>&1 || true
}
main_root() { local c; c="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1; dirname "$c"; }

# rodada da worktree de dispatcher em que o comando roda (#239): branch sessao/swarm-<id> ou pasta <repo>-swarm-<id>,
# desde que exista ~/.oute/swarm/swarm-<id>/meta. Fora de uma, exit 1.
coord_round() {
  local b top c cands=()
  b="$(git -C "$PWD" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  top="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ "$b" =~ ^sessao/(swarm-[A-Za-z0-9-]+)$ ]] && cands+=("${BASH_REMATCH[1]}")
  [[ "${top##*/}" =~ -(swarm-[0-9]{4}-[0-9]{4})$ ]] && cands+=("${BASH_REMATCH[1]}")
  for c in ${cands[@]+"${cands[@]}"}; do
    if [[ -f "$STATE_ROOT/$c/meta" ]]; then printf '%s' "$c"; return 0; fi
  done
  return 1
}

# rodada do comando, a mesma para spawn, tell, close e watch: a do OUTE_SWARM_ID; sem a variável (ex.: a sessão da
# dispatcher reiniciou), a da worktree de dispatcher, com aviso em stderr. Fora das duas, exit 1 e cada comando
# decide (spawn: avulso; tell, close e watch: a mais recente).
round_id() {
  local r
  if [[ -n "${OUTE_SWARM_ID:-}" ]]; then printf '%s' "$OUTE_SWARM_ID"; return 0; fi
  r="$(coord_round)" || return 1
  echo "oute-swarm: OUTE_SWARM_ID ausente; assumindo a rodada $r (worktree do dispatcher)" >&2
  printf '%s' "$r"
}

# agente de sessão aceito pelo spawn e pela abertura (--agent); $2 = de onde veio, para a mensagem
check_agent() {
  case "$1" in
    claude|codex) ;;
    pi) die "Pi saiu do stack (#217), use claude ou codex${2:+ ($2)}" ;;
    *) die "agente inválido: $1${2:+ ($2)}; use claude ou codex" ;;
  esac
}

resolve_repo() {
  local r="$1"
  [[ "$r" == */* ]] || r="/workspace/$r"
  [[ -d "$r" ]] || die "repo não encontrado: $r"
  main_root "$r" || die "$r não é um repositório git"
}

cmd_start() {
  [[ $# -ge 1 ]] || die "uso: oute-swarm <repo> [--max N] [--label L] [--agent claude|codex]"
  local repo max=3 label="" workers="" main name id prompt wtext
  repo="$1"; shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --max) max="${2:?}"; shift 2 ;;
      --label) label="${2:?}"; shift 2 ;;
      --agent) workers="${2:?}"; shift 2 ;;
      *) die "opção desconhecida: $1" ;;
    esac
  done
  [[ "$max" =~ ^[1-9][0-9]?$ ]] || die "--max inválido: $max"
  (( max <= 5 )) || die "--max acima de 5 não é permitido (quota e revisão humana)"
  [[ -z "$workers" ]] || check_agent "$workers"
  [[ -n "${HERDR_ENV:-}" ]] || die "rode dentro do herdr (o dispatcher abre abas nele)"
  command -v gh >/dev/null || die "gh não encontrado"
  main="$(resolve_repo "$repo")"; name="$(basename "$main")"
  id="swarm-$(date +%m%d-%H%M)"
  mkdir -p "$STATE_ROOT/$id"
  # agent = o do dispatcher (oute.agent dos eventos da rodada); workers = o das sessões, só com --agent (#212): sem ele,
  # a rodada não tem padrão e o seletor decide em cada spawn (#219)
  printf 'repo=%s\nmax=%s\nlabel=%s\nstarted=%s\nagent=claude\n%s' "$main" "$max" "$label" "$(date -u +%FT%TZ)" \
    "${workers:+workers=$workers$'\n'}" > "$STATE_ROOT/$id/meta"
  [[ -f "$LIB/swarm.md" ]] || die "prompt ausente: $LIB/swarm.md"
  if [[ -n "$workers" ]]; then wtext="\`$workers\` (escolhido pelo Bardi na abertura, \`--agent $workers\`)"
  else wtext="seletor (a rodada abriu sem \`--agent\`: \`claude\`, com o modelo da fase de cada issue)"; fi
  prompt="$(sed -e "s|{{REPO}}|$name|g" -e "s|{{REPO_PATH}}|$main|g" -e "s|{{MAX}}|$max|g" \
                -e "s|{{LABEL}}|${label:-(nenhum)}|g" -e "s|{{ID}}|$id|g" -e "s|{{WORKERS}}|$wtext|g" \
                -e "s|{{SELECT_AGENT}}|${workers:+ --agent $workers}|g" "$LIB/swarm.md")"
  slog "$STATE_ROOT/$id" "$(sed -n 's/^started=//p' "$STATE_ROOT/$id/meta") abertura $id (repo $name, max $max${label:+, label $label}${workers:+, agente $workers})"
  echo "dispatcher $id · repo $name · max $max${label:+ · label $label}${workers:+ · agente $workers}" >&2
  OUTE_SWARM_ID="$id" OUTE_SWARM_MAX="$max" OUTE_SWARM_REPO="$main" \
    exec oute-task --phase plan -r "$main" "$id" claude "$prompt"   # dispatcher: fase plan fixa (ADR-02, #219)
}

cmd_spawn() {
  local agent="" force=0 kaizen=0 repo="" task="" instr="" main slug n state pane tab out label cmd pfile count round max rrepo old old_ok now new why t
  local model="" sel="" sfile="" sargs=() src=0 s_agent s_model s_effort s_phase s_origin s_reserve
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent) agent="${2:?}"; shift 2 ;;
      --model) model="${2:?}"; shift 2 ;;
      --force) force=1; shift ;;
      --repo) repo="${2:?}"; shift 2 ;;
      --kaizen) kaizen=1; shift ;;
      -*) die "opção desconhecida: $1" ;;
      *) if [[ -z "$task" ]]; then task="$1"; elif [[ -z "$instr" ]]; then instr="$1"; else die "argumento a mais: $1"; fi; shift ;;
    esac
  done
  [[ -n "$task" && -n "$instr" ]] || die 'uso: oute-swarm spawn <n>-<slug> "<instrução>" [--agent claude|codex] [--model <id>]'
  [[ -z "$agent" ]] || check_agent "$agent"
  [[ -n "${HERDR_ENV:-}" && -n "${HERDR_WORKSPACE_ID:-}" ]] || die "rode dentro do herdr"
  slug="$(slugify "$task")"; [[ "$slug" =~ ^[0-9]+-[a-z0-9-]+$ ]] || die "tarefa deve ser <n>-<slug> (ex.: 185-backup-alert), veio: $task"
  n="${slug%%-*}"
  # rodada assumida pela worktree (sem OUTE_SWARM_ID): o max e o repo vêm do meta dela, não do ambiente
  round="$(round_id || true)"; max="${OUTE_SWARM_MAX:-}"; rrepo="${OUTE_SWARM_REPO:-}"
  if [[ -z "$round" ]]; then round=avulso
  elif [[ -z "${OUTE_SWARM_ID:-}" ]]; then
    max="$(sed -n 's/^max=//p' "$STATE_ROOT/$round/meta" | head -1)"; rrepo="$(sed -n 's/^repo=//p' "$STATE_ROOT/$round/meta" | head -1)"
    [[ "$max" =~ ^[1-9][0-9]?$ ]] || die "meta da rodada $round sem max válido ($STATE_ROOT/$round/meta); rode com OUTE_SWARM_ID=$round OUTE_SWARM_MAX=<n>"
  fi
  # sem --agent: o agente da rodada (workers= do meta, lido do arquivo também com OUTE_SWARM_ID, #212); rodada sem ele
  # ou spawn avulso: o seletor decide (#219, abaixo)
  if [[ -z "$agent" && "$round" != avulso ]]; then
    agent="$(sed -n 's/^workers=//p' "$STATE_ROOT/$round/meta" 2>/dev/null | head -1)"
    [[ -z "$agent" ]] || check_agent "$agent" "workers= do meta da rodada $round"
  fi
  if [[ -n "$repo" ]]; then main="$(resolve_repo "$repo")"
  else main="${rrepo:-$(main_root "$PWD" || true)}"; [[ -n "$main" ]] || die "repo não identificado (rode na worktree do dispatcher)"; fi
  [[ "$main" != *[[:space:]]* ]] || die "caminho de repo com espaço não suportado: $main"
  state="$STATE_ROOT/$round"; mkdir -p "$state"; touch "$state/spawned" "$state/closed"; rm -f "$state/fechada"
  if grep -qs "^$slug " "$state/spawned"; then die "$slug já foi aberta nesta rodada"; fi
  # o limite conta as abas abertas agora (spawned menos closed); sessão kaizen (7º campo) não conta
  count="$(awk -v cf="$state/closed" 'BEGIN {while ((getline l < cf) > 0) c[l] = 1} $7 != "kaizen" && !($1 in c)' "$state/spawned" | wc -l)"
  if (( ! force && ! kaizen )) && [[ -n "$max" ]] && (( count >= max )); then
    die "limite da rodada atingido ($count/$max abertas); feche uma aba com oute-swarm close ou peça ao Bardi para liberar e use --force"
  fi
  # seletor (ADR-02, #219): o --agent (do spawn ou da rodada) e o --model são a escolha explícita; o resto vem da issue
  # (label kaizen/docs, depois aidlc:<fase>; sem label de fase, o Jev classifica a instrução, que vai pelo stdin, #257;
  # senão Sonnet). Resolvido aqui, uma vez, e entregue ao oute-task em
  # <slug>.select: o agente gravado no spawned é o que de fato abre. Sem oute-select, ou com ele falhando, a sessão
  # abre como antes (o agente pedido, ou claude, com o modelo dele); só argumento inválido (código 2) recusa o spawn
  if command -v oute-select >/dev/null 2>&1; then
    [[ -z "$agent" ]] || sargs+=(--agent "$agent")
    [[ -z "$model" ]] || sargs+=(--model "$model")
    sel="$(printf '%s' "$instr" | oute-select --json --repo "$main" --issue "$n" --text-file - ${sargs[@]+"${sargs[@]}"})" || src=$?
    (( src != 2 )) || die "seletor recusou a sessão $slug (acima)"
    IFS='|' read -r s_agent s_model s_effort s_phase s_origin s_reserve < <(jq -r '[.agent, .model, .effort, .phase, .origin, .reserve] | map(. // "" | tostring) | join("|")' <<<"$sel" 2>/dev/null) || true
    if (( src != 0 )) || [[ ! "${s_agent:-}" =~ ^(claude|codex)$ ]]; then
      echo "oute-swarm: aviso: o seletor de modelo não respondeu; $slug abre com o modelo padrão do agente" >&2; sel=""
    else agent="$s_agent"; fi
  elif [[ -n "$model" ]]; then die "--model precisa do oute-select, que não está no PATH"
  fi
  agent="${agent:-claude}"
  pfile="$state/$slug.prompt"
  [[ -z "$sel" ]] || { sfile="$state/$slug.select"; printf '%s\n' "$sel" > "$sfile"; }
  {
    printf '%s\n\n' "$instr"
    sed -e "s|{{N}}|$n|g" -e "s|{{SLUG}}|$slug|g" -e "s|{{ID}}|$round|g" "$LIB/swarm-worker.md"
  } > "$pfile"
  label="#$n ${slug#*-}"
  # abas que já têm esse label (issue reaberta, rodada antiga com aba aberta): o spawn não fecha nenhuma delas (#289)
  old_ok=1; old="$(tabs_by_label "$label")" || old_ok=0
  # só o stdout é o JSON; o stderr do herdr vai direto para o stderr do spawn
  out="$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$main" --label "$label" --no-focus)" \
    || die "herdr tab create falhou: $out"
  # ids lidos do JSON (o id do workspace não é sempre w<dígitos>: o herdr também gera wA, #276)
  pane="$(jq -r '.result.root_pane.pane_id // empty | strings' <<<"$out" 2>/dev/null || true)"
  tab="$(jq -r '.result.tab.tab_id // empty | strings' <<<"$out" 2>/dev/null || true)"
  if [[ -z "$pane" ]]; then
    # sem o pane o agente não abre e a linha não entra no spawned: fecha a aba para não ficar órfã. Pelo id da
    # saída; sem ele, só a aba desse label que não existia antes do `tab create`. Com nenhuma candidata, mais de
    # uma ou sem as listas, não fecha nada: o spawn nunca fecha aba que não criou (#289)
    why=""
    if [[ -z "$tab" ]]; then
      if (( old_ok )) && now="$(tabs_by_label "$label")"; then
        new=(); while IFS= read -r t; do
          [[ -z "$t" ]] || grep -qxF -- "$t" <<<"$old" || new+=("$t")
        done <<<"$now"
        case ${#new[@]} in
          1) tab="${new[0]}" ;;
          0) why="nenhuma aba nova com esse label" ;;
          *) why="${#new[@]} abas novas com esse label" ;;
        esac
      else why="herdr tab list falhou"; fi
    fi
    if [[ -n "$tab" ]]; then
      if herdr tab close "$tab" >/dev/null 2>&1; then
        die "não achei o pane da aba nova na saída do herdr (aba $tab fechada): $out"
      fi
      why="herdr tab close falhou em $tab"
    fi
    die "não achei o pane da aba nova na saída do herdr e não fechei a aba \"$label\" ($why; feche à mão): $out"
  fi
  # OUTE_SWARM_ROUND: a rodada na sessão do worker (oute.swarm.round dos eventos oute.task.* e das conversas, #128);
  # spawn fora de rodada abre sessão avulsa
  printf -v cmd 'OUTE_SWARM_WORKER=1 %s%soute-task -r %q %q %q "$(cat %q)"' \
    "$([[ "$round" == avulso ]] || printf 'OUTE_SWARM_ROUND=%q ' "$round")" \
    "$([[ -z "$sfile" ]] || printf 'OUTE_SELECT_FILE=%q ' "$sfile")" "$main" "$slug" "$agent" "$pfile"
  herdr pane run "$pane" "$cmd" >/dev/null || die "herdr pane run falhou em $pane"
  # slug pane agente início aba repo tipo (linhas antigas param na aba: repo = o da rodada)
  printf '%s %s %s %s %s %s %s\n' "$slug" "$pane" "$agent" "$(date -u +%FT%TZ)" "${tab:--}" "$main" \
    "$( (( kaizen )) && echo kaizen || echo -)" >> "$state/spawned"
  slog "$state" "$(date -u +%FT%TZ) spawn $slug $agent$( (( kaizen )) && echo ' kaizen')"
  quota_snapshot spawn
  echo "aberta: #$n → pane $pane · worktree $(basename "$main")-$slug · agente $agent$([[ -z "$sel" || -z "$s_model" ]] || printf ' · modelo %s (fase %s, %s)' "$s_model" "${s_phase:--}" "${s_origin:--}")$([[ ! "${s_reserve:-}" =~ ^(indisponivel|cota)$ ]] || printf ' · reserva: %s' "$s_reserve")$( (( kaizen )) && echo ' · kaizen (fora do --max)')"
}

# id atual da aba pelo label "#<n> <resto>" (ids mudam quando o herdr restaura a sessão, ex.: depois de oute update)
tab_by_label() {
  herdr tab list 2>/dev/null | jq -r --arg l "$1" '.. | objects | select((.label? // .name? // "") == $l) | (.tab_id? // .id? // empty)' 2>/dev/null | head -1
}

# ids de todas as abas com o label, um por linha; falha se o `herdr tab list` falhar ou não vier em JSON
tabs_by_label() {
  local tabs
  tabs="$(herdr tab list 2>/dev/null)" && jq -e .result >/dev/null 2>&1 <<<"$tabs" || return 1
  jq -r --arg l "$1" '[.. | objects | select((.label? // .name? // "") == $l) | (.tab_id? // .id? // empty)] | unique[]' <<<"$tabs" 2>/dev/null
}

# o id (ex.: o gravado no spawn) ainda existe em `herdr tab list`?
tab_exists() {
  herdr tab list 2>/dev/null | jq -e --arg t "$1" 'any(.. | objects; (.tab_id? // "") == $t)' >/dev/null 2>&1
}

# abas fechadas da rodada ficam em $state/closed (spawned é histórico e não muda)
is_closed() { grep -qsxF -- "$2" "$1/closed"; }
mark_closed() { is_closed "$1" "$2" || { printf '%s\n' "$2" >> "$1/closed"; slog "$1" "$(date -u +%FT%TZ) close $2"; }; }

# rodada: a do dispatcher (round_id) ou, fora dela, a mais recente
round_dir() {
  local d
  if d="$(round_id)"; then d="$STATE_ROOT/$d"
  else d="$(ls -dt "$STATE_ROOT"/*/ 2>/dev/null | head -1)"; d="${d%/}"; fi
  [[ -n "$d" && -f "$d/spawned" ]] || die "nenhuma aba registrada (${d:-$STATE_ROOT})"
  printf '%s' "$d"
}

# texto do campo de entrada do agente no pane (sem a sugestão esmaecida), numa linha; exit 1 se não achar o campo.
# claude: entre as duas últimas linhas horizontais (─; a de cima pode trazer rótulo, ex.: "── ⠦ Working ──"),
# sem o marcador ❯/>. codex: bloco do último "›", que também marca a opção de listas/diálogos (confiar na pasta, hooks,
# command center): aí não há campo (exit 1), porque digitar ali escolhe opções.
field_text() {
  local raw
  raw="$(herdr pane read "$1" --source visible --format ansi 2>/dev/null)" || return 1
  # 1) tira os códigos ANSI e o texto esmaecido (SGR 2: sugestão/placeholder) até o reset (0/22), mesmo com outros
  #    códigos no meio (o placeholder do codex vem ESC[2m ESC[48;2;…m texto ESC[0m); 38/48/58;2;r;g;b não são SGR 2
  # 2) braille (U+2800–28FF): animação do composer vazio do codex e spinners; NBSP (depois do ❯) vira espaço
  printf '%s\n' "$raw" | LC_ALL=C awk '{
      out = ""; s = $0
      while ((i = index(s, "\033[")) > 0) {
        if (!dim) out = out substr(s, 1, i - 1)
        s = substr(s, i + 2)
        if (!match(s, /^[0-9;?]*[@-~]/)) { s = ""; break }
        seq = substr(s, 1, RLENGTH); s = substr(s, RLENGTH + 1)
        if (seq !~ /m$/) continue
        n = split(substr(seq, 1, length(seq) - 1), p, ";"); if (n == 0) dim = 0
        for (k = 1; k <= n; k++) {
          if (p[k] == "" || p[k] + 0 == 0 || p[k] + 0 == 22) dim = 0
          else if (p[k] + 0 == 2) dim = 1
          else if (p[k] ~ /^(38|48|58)$/) k += (p[k + 1] == 5 ? 2 : (p[k + 1] == 2 ? 4 : 0))
        }
      }
      if (!dim) out = out s
      print out
    }' | LC_ALL=C sed -e $'s/\r$//' -e $'s/\xe2[\xa0-\xa3][\x80-\xbf]//g' -e $'s/\xc2\xa0/ /g' | awk -v mode="$2" '
    function isrule(s,  t) { t = s; gsub(/─|━|═|╭|╮|╰|╯|├|┤| /, "", t); if (length(s) >= 10 && t == "") return 1
                             t = s; gsub(/^ +| +$/, "", t); return length(t) >= 10 && t ~ /^(──|━━|══)/ && t ~ /(──|━━|══)$/ }
    function clean(s) { gsub(/│/, "", s); sub(/^ *(❯|›|>)( |$)/, "", s); gsub(/^ +| +$/, "", s); return s }
    { l[NR] = $0 }
    END {
      if (mode == "codex") {
        for (i = NR; i >= 1; i--) if (l[i] ~ /^ *(│ *)?›( |$)/) break
        if (i < 1) exit 1
        # lista/diálogo: opção numerada ou dica de teclas de seleção abaixo do "›"
        if (clean(l[i]) ~ /^[0-9]+\. /) exit 1
        for (j = i + 1; j <= NR; j++) if (l[j] ~ /enter (continue|confirm|review|open|select|submit)|esc (back|skip|close|cancel)|↑\/↓/) exit 1
        out = clean(l[i])
        for (j = i + 1; j <= NR && l[j] !~ /^ *$/ && !isrule(l[j]); j++) out = out " " clean(l[j])
      } else {
        for (b = NR; b >= 1 && !isrule(l[b]); b--) ;
        for (a = b - 1; a >= 1 && !isrule(l[a]); a--) ;
        if (a < 1) exit 1
        out = ""
        for (j = a + 1; j < b; j++) out = out " " clean(l[j])
      }
      gsub(/  +/, " ", out); gsub(/^ | $/, "", out); print out
    }'
}

cmd_tell() {
  local force=0 wait=0 timeout="" want="" msg="" have=0 state line slug spane tab label panes pane="" agents st agent text got try
  local rc=1 start poll waited=0 tag=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1 ;;
      --wait) wait=1 ;;
      --timeout) [[ $# -ge 2 ]] || die "--timeout precisa de um valor (segundos)"; timeout="$2"; shift ;;
      -*) die "opção desconhecida: $1" ;;
      *) if (( have == 0 )); then want="$1"; elif (( have == 1 )); then msg="$1"; else die "argumento a mais: $1"; fi; have=$((have + 1)) ;;
    esac; shift
  done
  (( have == 2 )) || die 'uso: oute-swarm tell <n>-<slug> "<mensagem>" [--force | --wait [--timeout <s>]]'
  # erros de uso: antes de qualquer linha no log
  (( ! (wait && force) )) || die "--wait e --force não combinam: --force manda já, --wait espera a sessão parar"
  [[ -z "$timeout" ]] || (( wait )) || die "--timeout só vale com --wait"
  [[ -z "$timeout" || "$timeout" =~ ^[0-9]+$ ]] || die "--timeout precisa de um número inteiro de segundos: $timeout"
  timeout="${timeout:-600}"
  poll="${OUTE_SWARM_TELL_POLL:-5}"
  [[ -n "${HERDR_ENV:-}" ]] || die "rode dentro do herdr"
  want="$(slugify "$want")"
  # quebra de linha no send-text viraria Enter sem conferência: a mensagem vai numa linha só, sem controles
  msg="$(printf '%s' "$msg" | tr '\n\r\t' '   ' | tr -d '[:cntrl:]' | tr -s ' ')"; msg="${msg# }"; msg="${msg% }"
  [[ -n "$msg" ]] || die "mensagem vazia"
  state="$(round_dir)"
  line="$(awk -v s="$want" '$1==s' "$state/spawned" | tail -1)"; [[ -n "$line" ]] || die "$want não é desta rodada ($(basename "$state"))"
  read -r slug spane _ _ tab _ <<<"$line"
  label="#${slug%%-*} ${slug#*-}"
  # a partir daqui toda recusa fica no log da rodada; a mensagem vai depois de um TAB (ela nunca tem TAB)
  # rc: código de saída da recusa (3 = timeout da espera do --wait, como o oute-inbox)
  refuse() { slog "$state" "$(date -u +%FT%TZ) tell $slug recusado: ${1//[$'\n\t']/ }"$'\t'"$msg"; printf 'oute-swarm: %s; %s\n' "$1" "${2:-nada enviado}" >&2; exit "$rc"; }
  # a espera do --wait não grava nada: cada volta relê aba, pane e agente e recusa na hora pelas mensagens de sempre
  start=$SECONDS
  while :; do
  ! is_closed "$state" "$slug" || refuse "aba $label já fechada (oute-swarm close)"
  # `pane list` não tem --tab (herdr 0.9.1); cada pane traz tab_id, então filtra no jq
  pane=""
  panes="$(herdr pane list 2>&1)" || refuse "herdr pane list falhou: $panes"
  jq -e . >/dev/null 2>&1 <<<"$panes" || refuse "herdr pane list devolveu algo que não é JSON: $panes"
  tab="$(tab_by_label "$label" || true)"
  if [[ -n "$tab" ]]; then
    # pane da aba, preferindo o que tem agente (ids mudam no restore; o gravado no spawn é só fallback)
    pane="$(jq -r --arg t "$tab" '[.. | objects | select(.pane_id? != null and .tab_id? == $t)] | (map(select((.agent? // "") != "")) + .)[0].pane_id // empty' <<<"$panes" 2>/dev/null || true)"
  fi
  # o id gravado no spawn só vale se ainda existir (senão é stale)
  if [[ -z "$pane" && -n "$spane" ]] && jq -e --arg p "$spane" 'any(.. | objects; (.pane_id? // "") == $p)' >/dev/null 2>&1 <<<"$panes"; then
    pane="$spane"
  fi
  [[ -n "$pane" ]] || refuse "pane da aba $label não encontrado (fechada?)"
  # 1) só com a sessão parada: idle/done (pronta) ou blocked (pergunta/aprovação na tela); working/unknown = ocupada
  agents="$(herdr agent list 2>&1)" || refuse "herdr agent list falhou: $agents"
  read -r agent st < <(jq -r --arg p "$pane" '[.. | objects | select(.pane_id? == $p and has("agent_status"))][0] | "\(.agent // "-") \(.agent_status // "-")"' <<<"$agents" 2>/dev/null || echo "- -")
  [[ "$agent" != - && "$agent" != null ]] || refuse "nenhum agente no pane $pane de $label"
  case "$st" in
    idle|done|blocked) ;;
    *) if (( wait )); then
         waited=$(( SECONDS - start ))
         if (( waited >= timeout )); then rc=3; refuse "sessão $label ocupada ($st) depois de $waited s de espera"; fi
         sleep "$poll"; continue
       fi
       (( force )) || refuse "sessão $label ocupada ($st); tente depois (o Bardi pode usar --force)"
       echo "aviso: sessão $label em '$st'; seguindo por --force" >&2 ;;
  esac
  break
  done
  (( ! wait )) || { waited=$(( SECONDS - start )); tag=" (--wait, ${waited}s)"; }
  # 2) digita, confere o campo e só então Enter. Não bateu: limpa (ctrl+c, só com a sessão pronta) e tenta uma vez
  text="[dispatcher $(basename "$state"), repassando o Bardi] $msg"
  # acima de 800 caracteres o Claude Code mostra "[Pasted text #n]" e o campo não dá para conferir
  (( ${#text} <= 800 )) || refuse "mensagem longa demais (${#text} caracteres com o prefixo; máx. 800); resuma"
  # sem campo na tela (diálogo/lista; o herdr dá idle no codex nesses casos) nada é digitado: teclas ali escolhem opções
  field_text "$pane" "$agent" >/dev/null || refuse "campo de entrada de $label não encontrado na tela (diálogo ou lista aberta?)"
  for try in 1 2; do
    herdr pane send-text "$pane" "$text" >/dev/null || refuse "send-text falhou em $pane"
    sleep 0.5
    got="$(field_text "$pane" "$agent")" || got="(campo de entrada não encontrado na tela)"
    if [[ "$(tr -d '[:space:]' <<<"$got")" == "$(tr -d '[:space:]' <<<"$text")" ]]; then
      herdr pane send-keys "$pane" enter >/dev/null || refuse "send-keys enter falhou em $pane" "texto digitado, sem Enter"
      slog "$state" "$(date -u +%FT%TZ) tell $slug ok$( (( force )) && echo " (--force, $st)")$tag"$'\t'"$msg"
      echo "enviado a $label ($pane)"
      return 0
    fi
    (( try == 1 )) || break
    [[ "$st" == idle || "$st" == done ]] || break   # ctrl+c/esc com a sessão trabalhando ou num diálogo interromperia/responderia
    herdr pane send-keys "$pane" ctrl+c >/dev/null 2>&1 || break
    sleep 0.5
    [[ -z "$(field_text "$pane" "$agent" 2>/dev/null)" ]] || break   # não limpou: não empilha outro ctrl+c
  done
  printf 'oute-swarm: campo de %s ficou assim (esperado a mensagem exata):\n%s\n' "$label" "$got" >&2
  refuse "o campo de entrada não contém exatamente a mensagem" "sem Enter; confira o pane $pane"
}

cmd_close() {
  local yes=0 all=0 want="" slug pane agent ts tab label id closed=0 pending=0 found=0 failed=0 state
  while [[ $# -gt 0 ]]; do
    case "$1" in --yes) yes=1 ;; --all) all=1 ;; -*) die "opção desconhecida: $1" ;; *) want="$(slugify "$1")" ;; esac; shift
  done
  (( all )) || [[ -n "$want" ]] || die "uso: oute-swarm close <n>-<slug>|--all [--yes]"
  [[ -n "${HERDR_ENV:-}" ]] || die "rode dentro do herdr"
  state="$(round_dir)"
  echo "rodada $(basename "$state")"
  while read -r slug pane agent ts tab _; do
    [[ -n "$slug" ]] || continue
    (( all )) || [[ "$slug" == "$want" ]] || continue
    found=1
    label="#${slug%%-*} ${slug#*-}"
    if is_closed "$state" "$slug"; then (( all )) || echo "já fechada: $label"; continue; fi
    # label primeiro; o id gravado no spawn só vale se ainda existir (senão é stale)
    id="$(tab_by_label "$label")"
    if [[ -z "$id" && "${tab:--}" != - ]] && tab_exists "$tab"; then id="$tab"; fi
    if [[ -z "$id" ]]; then
      echo "já fechada: $label"
      (( ! yes )) || mark_closed "$state" "$slug"
      continue
    fi
    pending=1
    if (( yes )); then
      if herdr tab close "$id" >/dev/null 2>&1; then echo "fechada: $label ($id)"; closed=1; mark_closed "$state" "$slug"
      else echo "falhou fechar $label ($id); feche manualmente" >&2; failed=1; fi
    else echo "fechar: $label ($id)"; fi
  done < "$state/spawned"
  (( all || found )) || die "$want não é desta rodada ($(basename "$state"))"
  # rodada fechada: o `oute-swarm watch` vê a marca e sai sozinho
  if (( all && yes && ! failed )); then
    date -u +%FT%TZ > "$state/fechada"; slog "$state" "$(cat "$state/fechada") rodada fechada"
  fi
  if (( ! pending )); then (( ! all )) || echo "nada a fechar"; return 0; fi
  (( ! closed )) || quota_snapshot close
  (( yes )) || echo "(simulação — rode com --yes para fechar)"
  (( ! closed )) || echo "depois: oute-task clean  (e cancele os handoffs órfãos)"
}

# ---- watch: monitor do dispatcher (#45) ----
# Cada passada monta um retrato normalizado da rodada (chave<TAB>valor) e compara com o anterior; só imprime linha
# para mudança real. O retrato fica em $state/watch.state: a 1ª passada da rodada só grava a linha de base (silêncio)
# e um watch reiniciado (monitor expirou) compara com o último retrato, sem perder o que mudou no intervalo.
# Falha de herdr/gh numa passada não vira evento: o estado anterior daquela fonte é mantido (e sai um aviso só).
# CI de head substituído (#266): o `gh pr list` só traz os checks do head atual. Quando o head de um PR muda entre duas
# passadas, o head anterior entra em observação (oldhead|<pr>|<sha>) e os checks dele são lidos pelo commit até todos
# concluírem (ou o PR fechar). Check que falhou nele sai uma vez, com o head curto (oldci|<pr>|<sha7>|<check>, que fica
# no retrato para não repetir); verde não gera linha, e cancelado também não (o push novo cancela o run anterior).
W_OLDQ='query($owner:String!,$name:String!,$oid:GitObjectID!){repository(owner:$owner,name:$name){object(oid:$oid){
  ... on Commit{statusCheckRollup{contexts(first:100){nodes{__typename
    ... on CheckRun{name conclusion startedAt completedAt} ... on StatusContext{context state startedAt: createdAt}}}}}}}}'
W_INBOX="${OUTE_INBOX:-$HOME/inbox}" W_OUTBOX="${OUTE_OUTBOX:-$HOME/outbox}"
declare -A W_PREV=() W_CUR=() W_IID=()

# evento: no stdout (monitor do dispatcher) e no log da rodada, com data/hora UTC (linha do tempo da retrospectiva)
w_ev() {
  [[ -n "$2" ]] || return 0
  printf '%s [%s] %s\n' "$(date +%H:%M)" "$1" "$2"
  slog "$W_STATE" "$(date -u +%FT%TZ) watch [$1] $2"
}
w_keep() { local k; for k in "${!W_PREV[@]}"; do [[ "$k" == "$1"* ]] && W_CUR[$k]="${W_PREV[$k]}"; done; return 0; }
w_label() { printf '#%s %s' "${1%%-*}" "${1#*-}"; }
# PR/issue de outro repo que o da rodada vêm como <repo>#<n> (sem colisão de número); os da rodada, só <n>
w_pfx() { [[ "$1" == "$2" ]] || printf '%s#' "$(basename "$1")"; }
w_ref() { if [[ "$1" == *"#"* ]]; then printf '%s' "$1"; else printf '#%s' "$1"; fi; }
w_hdr() { sed -n "s/^# $2: //p;/^\$/q" "$1" 2>/dev/null | head -1 || true; }

w_snapshot() {
  local state="$1" main="$2" since="$3" slug _p _a _ts tab repo label tabs kind num n st mg url name res all ns f id rc
  local gh_ok=1 oid old cur k pend
  local -A prst=() prrepo=()
  W_CUR=(); W_IID=()
  # abas e sessões: relidas do estado da rodada a cada passada (spawn/close depois de iniciado entram sozinhos)
  if tabs="$(herdr tab list 2>/dev/null)" && jq -e .result >/dev/null 2>&1 <<<"$tabs"; then
    while read -r slug _p _a _ts tab repo _; do
      [[ -n "$slug" ]] || continue
      W_IID[$slug]="$(w_pfx "${repo:-$main}" "$main")${slug%%-*}"
      if is_closed "$state" "$slug"; then W_CUR["tab|$slug"]=closed; continue; fi
      label="$(w_label "$slug")"
      # a aba pelo id gravado no spawn (se ainda tem o label) ou pelo label (ids mudam no restore do herdr)
      st="$(jq -r --arg l "$label" --arg t "${tab:--}" '[.. | objects | select(.tab_id? != null and (.label? // "") == $l)]
             | (map(select(.tab_id == $t)) + .)[0] // empty | .agent_status // "unknown"' <<<"$tabs" 2>/dev/null || true)"
      if [[ -z "$st" ]]; then W_CUR["tab|$slug"]=closed; continue; fi
      W_CUR["tab|$slug"]=open
      case "$st" in working|idle|done|blocked) ;; *) st=none ;; esac
      W_CUR["agent|$slug"]="$st"
    done < <(cat "$state/spawned" 2>/dev/null)
  else
    w_keep "tab|"; w_keep "agent|"; W_CUR["falha|herdr"]=1
  fi
  # PRs da rodada: criados depois do início, branch <tipo>/<n>-… (ou sessao/<n>-…) de uma issue aberta nela, em cada
  # repo das sessões (6º campo do spawned; sem ele, o da rodada). Um repo que falha mantém o estado anterior de todos.
  all=""
  while read -r repo; do
    [[ -n "$repo" ]] || continue
    ns="$(awk -v m="$main" -v r="$repo" '($6 == "" ? m : $6) == r {split($1, a, "-"); print a[1]}' "$state/spawned" \
          | jq -Rsc 'split("\n") | map(select(. != ""))')" || { gh_ok=0; break; }
    if res="$(cd "$repo" && gh pr list --state all --limit 100 --json number,headRefName,headRefOid,state,mergeable,createdAt,url,statusCheckRollup 2>/dev/null)" \
       && res="$(jq -r --arg since "$since" --argjson ns "$ns" --arg pf "$(w_pfx "$repo" "$main")" '
          def r: (.conclusion // "" | if . == "" then null else . end) // (.state // "") | ascii_upcase
                 | if test("^(SUCCESS|NEUTRAL|SKIPPED)$") then "pass"
                   elif test("^(FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STARTUP_FAILURE|STALE)$") then "fail"
                   else "pending" end;
          .[] | select((.createdAt // "") >= $since) | . as $p
          | ($p.headRefName | split("/") | last | capture("^(?<n>[0-9]+)-").n) as $n
          | select(any($ns[]; . == $n))
          | "pr\t\($pf)\($p.number)\t\($pf)\($n)\t\($p.state)\t\($p.mergeable // "UNKNOWN")\t\($p.url)\t\($p.headRefOid // "")",
            ([$p.statusCheckRollup[]? | {name: ((.name // .context // "?") | gsub("[\t\n|]"; " ")),
                                           t: (.completedAt // .startedAt // ""), r: r}]
             | group_by(.name)[] | max_by(.t) | "ci\t\($pf)\($p.number)\t\(.name)\t\(.r)")' <<<"$res" 2>/dev/null)"; then
      all+="${res:+$res$'\n'}"
      while IFS=$'\t' read -r kind num _; do [[ "$kind" != pr ]] || prrepo[$num]="$repo"; done <<<"$res"
    else
      gh_ok=0; break
    fi
  done < <(awk -v m="$main" '{print ($6 == "" ? m : $6)}' "$state/spawned" 2>/dev/null | sort -u)
  if (( gh_ok )); then
    w_keep "oldhead|"; w_keep "oldci|"
    while IFS=$'\t' read -r kind num n st mg url oid; do
      case "$kind" in
        pr)
          W_CUR["pr|$num|$n"]="$st"; W_CUR["url|$num"]="$url"; prst[$num]="$st"
          old="${W_PREV[head|$num]:-}"
          if [[ -n "$oid" ]]; then
            W_CUR["head|$num"]="$oid"
            if [[ -n "$old" && "$old" != "$oid" ]]; then
              W_CUR["oldhead|$num|$old"]=1
              # falha já emitida enquanto esse head era o atual: marcada como vista, para não sair de novo
              for k in "${!W_PREV[@]}"; do
                if [[ "$k" == "ci|$num|"* && "${W_PREV[$k]}" == fail ]]; then W_CUR["oldci|$num|${old:0:7}|${k#"ci|$num|"}"]=seen; fi
              done
            fi
          fi
          case "$mg" in
            CONFLICTING) W_CUR["merge|$num"]=conflict ;;
            MERGEABLE) W_CUR["merge|$num"]=ok ;;
            *) [[ -z "${W_PREV[merge|$num]:-}" ]] || W_CUR["merge|$num"]="${W_PREV[merge|$num]}" ;;   # UNKNOWN: recalculando
          esac ;;
        ci) name="$n"; W_CUR["ci|$num|$name"]="$st" ;;
      esac
    done <<<"$all"
    # heads substituídos em observação: uma leitura por passada, até todos os checks dele concluírem ou o PR fechar
    for k in "${!W_CUR[@]}"; do
      [[ "$k" == "oldhead|"* ]] || continue
      num="${k#oldhead|}"; old="${num##*|}"; num="${num%|*}"; cur="${W_CUR[head|$num]:-}"
      if [[ -z "${prrepo[$num]:-}" ]]; then unset "W_CUR[$k]"; continue; fi   # PR saiu da lista da rodada
      if res="$(cd "${prrepo[$num]}" && gh api graphql -F owner='{owner}' -F name='{repo}' -f oid="$old" -f query="$W_OLDQ" 2>/dev/null)" \
         && res="$(jq -r '
            def r: (.conclusion // .state // "") | ascii_upcase
                   | if test("^(FAILURE|ERROR|TIMED_OUT|ACTION_REQUIRED|STARTUP_FAILURE)$") then "fail"
                     elif . == "" or test("^(PENDING|EXPECTED|QUEUED|IN_PROGRESS)$") then "pending"
                     else "done" end;
            if (.data.repository | type) != "object" then error("resposta sem repository") else . end
            | [.data.repository.object.statusCheckRollup.contexts.nodes[]?
               | {name: ((.name // .context // "?") | gsub("[\t\n|]"; " ")), t: (.completedAt // .startedAt // ""), r: r}]
            | group_by(.name)[] | max_by(.t) | "\(.r)\t\(.name)"' <<<"$res" 2>/dev/null)"; then
        pend=0
        while IFS=$'\t' read -r st name; do
          case "$st" in
            pending) pend=1 ;;
            fail) [[ -n "${W_CUR[oldci|$num|${old:0:7}|$name]:-}" ]] || W_CUR["oldci|$num|${old:0:7}|$name"]="fail ${cur:0:7}" ;;
          esac
        done <<<"$res"
        (( pend )) && [[ "${prst[$num]}" == OPEN ]] || unset "W_CUR[$k]"
      else
        W_CUR["falha|gh"]=1   # fica em observação e é lido de novo na próxima passada
      fi
    done
  else
    w_keep "pr|"; w_keep "url|"; w_keep "merge|"; w_keep "ci|"; w_keep "head|"; w_keep "oldhead|"; w_keep "oldci|"; W_CUR["falha|gh"]=1
  fi
  # canal de aprovação (de todos os agentes): pedido pendente em ~/outbox e resultado em ~/inbox
  for f in "$W_OUTBOX"/*.sh; do
    [[ -f "$f" ]] || continue
    id="$(basename "$f" .sh)"; W_CUR["ask|$id"]=pending
  done
  for f in "$W_INBOX"/*.out; do
    [[ -f "$f" ]] || continue
    rc="$(w_hdr "$f" rc)"; W_CUR["res|$(basename "$f" .out)"]="${rc:-?}"
  done
}

w_diff() {
  local k new old kind a b slug num pr f t
  while IFS= read -r k; do
    [[ -n "$k" ]] || continue
    new="${W_CUR[$k]:-}" old="${W_PREV[$k]:-}"
    [[ "$new" != "$old" ]] || continue
    IFS='|' read -r kind a b <<<"$k"
    case "$kind" in
      tab)
        case "$old>$new" in
          ">open") w_ev aba "$(w_label "$a"): aberta" ;;
          "closed>open") w_ev aba "$(w_label "$a"): reaberta" ;;
          "open>closed") w_ev aba "$(w_label "$a"): fechada$(is_closed "$W_STATE" "$a" || echo ' (sumiu do herdr, sem oute-swarm close)')" ;;
        esac ;;
      agent)
        [[ -n "$new" ]] || continue   # aba fechada: a sessão sai junto (o evento é o da aba)
        slug="$a" pr=""
        for t in "${!W_CUR[@]}"; do
          [[ "$t" == "pr|"*"|${W_IID[$slug]:-${slug%%-*}}" ]] || continue
          num="${t#pr|}"; num="${num%%|*}"; pr="${pr:+$pr, }PR $(w_ref "$num") ${W_CUR[$t],,}"
        done
        case "$new" in
          idle|done|blocked) w_ev sessao "$(w_label "$slug"): $new (${pr:-sem PR})" ;;
          working) if [[ "$old" =~ ^(idle|done|blocked)$ ]]; then w_ev sessao "$(w_label "$slug"): working (voltou a trabalhar)"; fi ;;
          none) if [[ "$old" =~ ^(working|idle|done|blocked)$ ]]; then w_ev sessao "$(w_label "$slug"): sem agente na aba (o agente saiu?)"; fi ;;
        esac ;;
      pr)
        [[ -n "$new" ]] || continue
        case "$new" in
          OPEN) w_ev pr "PR $(w_ref "$a") aberto (issue $(w_ref "$b")) ${W_CUR[url|$a]:-}" ;;
          MERGED) w_ev pr "PR $(w_ref "$a") mergeado (issue $(w_ref "$b"))" ;;
          CLOSED) w_ev pr "PR $(w_ref "$a") fechado sem merge (issue $(w_ref "$b"))" ;;
          *) w_ev pr "PR $(w_ref "$a"): $new (issue $(w_ref "$b"))" ;;
        esac ;;
      ci)
        [[ "$new" == pass || "$new" == fail ]] || continue
        w_ev ci "PR $(w_ref "$a") · $b: $new" ;;
      oldci)
        [[ -z "$old" && "$new" == "fail "* ]] || continue
        w_ev ci "PR $(w_ref "$a") · ${b#*|}: fail (head ${b%%|*}, já substituído por ${new#fail })" ;;
      merge)
        case "$old>$new" in
          *">conflict") w_ev conflito "PR $(w_ref "$a") em conflito com a base (mergeable=CONFLICTING)" ;;
          "conflict>ok") w_ev conflito "PR $(w_ref "$a") sem conflito de novo" ;;
        esac ;;
      ask)
        [[ "$new" == pending ]] || continue
        f="$W_OUTBOX/$a.sh"
        w_ev canal "pedido pendente $a: $(w_hdr "$f" titulo) (agente $(w_hdr "$f" agente), $(w_hdr "$f" como)) — aprovação no host: oute watch" ;;
      res)
        [[ -n "$new" && "$new" != 0 ]] || continue
        if [[ "$new" == 126 ]] && grep -qs '^# recusado:' "$W_INBOX/$a.out"; then w_ev canal "pedido $a recusado no host"
        else w_ev canal "resultado $a: rc=$new (oute-inbox $a)"; fi ;;
      falha)
        if [[ -n "$new" ]]; then w_ev aviso "$a falhou nesta passada; mantendo o último estado conhecido"
        else w_ev aviso "$a respondendo de novo"; fi ;;
    esac
  done < <(printf '%s\n' "${!W_CUR[@]}" "${!W_PREV[@]}" | sort -u \
             | awk -F'|' 'BEGIN { split("falha tab agent pr ci oldci merge ask res", o, " "); for (i in o) p[o[i]] = i }
                          { print (p[$1] ? p[$1] : 9) "\t" $0 }' | sort -s -n -k1,1 | cut -f2-)
}

cmd_watch() {
  local interval=60 round="" main since sfile tmp k v first=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --interval) interval="${2:?}"; shift 2 ;;
      --round) round="${2:?}"; shift 2 ;;
      *) die "uso: oute-swarm watch [--interval s] [--round <rodada>]" ;;
    esac
  done
  [[ "$interval" =~ ^[0-9]+$ ]] && (( interval >= 10 )) || die "--interval inválido: $interval (mínimo 10 s)"
  [[ -n "$round" ]] || round="$(round_id || true)"
  if [[ -n "$round" ]]; then W_STATE="$STATE_ROOT/$round"
  else W_STATE="$(ls -dt "$STATE_ROOT"/*/ 2>/dev/null | head -1)"; W_STATE="${W_STATE%/}"; fi
  [[ -n "$W_STATE" && -f "$W_STATE/meta" ]] || die "rodada não encontrada: ${W_STATE:-$STATE_ROOT}"
  main="$(sed -n 's/^repo=//p' "$W_STATE/meta")"; since="$(sed -n 's/^started=//p' "$W_STATE/meta")"
  [[ -d "$main" ]] || die "repo da rodada não encontrado: $main"
  command -v herdr >/dev/null && command -v gh >/dev/null && command -v jq >/dev/null || die "precisa de herdr, gh e jq"
  sfile="$W_STATE/watch.state"
  # um watch por rodada: o mais novo assume, e o antigo (monitor que expirou sem matar o processo) sai na próxima passada
  printf '%s\n' "$$" > "$W_STATE/watch.pid"
  if [[ -s "$sfile" ]]; then
    while IFS=$'\t' read -r k v; do [[ -n "$k" ]] && W_PREV[$k]="$v"; done < "$sfile"
    first=0
  fi
  echo "oute-swarm watch: rodada $(basename "$W_STATE") · a cada ${interval}s · $( (( first )) && echo 'linha de base nesta passada' || echo 'comparando com o último estado salvo')" >&2
  while :; do
    [[ "$(cat "$W_STATE/watch.pid" 2>/dev/null)" == "$$" ]] || { echo "oute-swarm watch: outro watch assumiu a rodada; saindo" >&2; exit 0; }
    if [[ -f "$W_STATE/fechada" ]]; then
      w_ev rodada "$(basename "$W_STATE") fechada (oute-swarm close --all); watch encerrado"
      rm -f "$W_STATE/watch.pid"; exit 0
    fi
    w_snapshot "$W_STATE" "$main" "$since"
    (( first )) || w_diff
    first=0
    tmp="$(mktemp "$W_STATE/.watch.XXXXXX")"
    for k in "${!W_CUR[@]}"; do printf '%s\t%s\n' "$k" "${W_CUR[$k]}"; done | sort > "$tmp"
    mv "$tmp" "$sfile"
    W_PREV=(); for k in "${!W_CUR[@]}"; do W_PREV[$k]="${W_CUR[$k]}"; done
    sleep "$interval"
  done
}

cmd_list() {
  local d line
  for d in "$STATE_ROOT"/*/; do
    [[ -f "$d/spawned" ]] || continue
    echo "== $(basename "$d")"
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      if is_closed "${d%/}" "${line%% *}"; then echo "  $line (fechada)"; else echo "  $line"; fi
    done < "$d/spawned"
  done
  echo "== worktrees"; oute-task list
}

case "${1:-}" in
  ""|-h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
  spawn) shift; cmd_spawn "$@" ;;
  tell) shift; cmd_tell "$@" ;;
  close) shift; cmd_close "$@" ;;
  watch) shift; cmd_watch "$@" ;;
  list) cmd_list ;;
  *) cmd_start "$@" ;;
esac
