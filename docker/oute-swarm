#!/usr/bin/env bash
# oute-swarm — várias sessões de agente em paralelo, uma por issue, coordenadas por uma sessão do Claude.
#
#   oute-swarm <repo> [--max N] [--label L]         abre a coordenadora (worktree própria) com o prompt padrão
#   oute-swarm spawn <n>-<slug> "<instrução>"       (usado pela coordenadora) abre uma aba do herdr com
#              [--agent claude|codex|pi] [--force]  oute-task + agente na worktree da issue. --repo: outro repo
#              [--repo <repo>] [--kaizen]           (padrão: o da rodada); --kaizen: sessão kaizen, fora do --max
#   oute-swarm tell <n>-<slug> "<mensagem>"         repassa uma decisão/instrução do Bardi à sessão parada (digita,
#              [--force]                            confere o campo e só então Enter). --force (só o Bardi): sessão ocupada
#   oute-swarm close <n>-<slug>|--all [--yes]      fecha a(s) aba(s) do herdr da rodada (encerra o agente). Sem --yes: só mostra
#   oute-swarm list                                 abas abertas por esta coordenadora + worktrees de tarefa
#
# Repo: nome em /workspace (ex.: lab) ou caminho. Default --max 3; --label filtra issues por label.
# Triagem, espera do ok do Bardi, acompanhamento e limpeza estão no prompt (/usr/local/lib/oute/swarm.md).
# A coordenadora nunca faz merge sem pedido explícito; ações no host só pelo canal de aprovação.
set -euo pipefail
LIB="${OUTE_LIB:-/usr/local/lib/oute}"
STATE_ROOT="${HOME}/.oute/swarm"
die() { printf 'oute-swarm: %s\n' "$*" >&2; exit 1; }
slugify() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' | tr -s '-' | sed 's/^-//; s/-$//' | cut -c1-40; }
main_root() { local c; c="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1; dirname "$c"; }

resolve_repo() {
  local r="$1"
  [[ "$r" == */* ]] || r="/workspace/$r"
  [[ -d "$r" ]] || die "repo não encontrado: $r"
  main_root "$r" || die "$r não é um repositório git"
}

cmd_start() {
  [[ $# -ge 1 ]] || die "uso: oute-swarm <repo> [--max N] [--label L]"
  local repo max=3 label="" main name id prompt
  repo="$1"; shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --max) max="${2:?}"; shift 2 ;;
      --label) label="${2:?}"; shift 2 ;;
      *) die "opção desconhecida: $1" ;;
    esac
  done
  [[ "$max" =~ ^[1-9][0-9]?$ ]] || die "--max inválido: $max"
  (( max <= 5 )) || die "--max acima de 5 não é permitido (quota e revisão humana)"
  [[ -n "${HERDR_ENV:-}" ]] || die "rode dentro do herdr (a coordenadora abre abas nele)"
  command -v gh >/dev/null || die "gh não encontrado"
  main="$(resolve_repo "$repo")"; name="$(basename "$main")"
  id="swarm-$(date +%m%d-%H%M)"
  mkdir -p "$STATE_ROOT/$id"
  printf 'repo=%s\nmax=%s\nlabel=%s\nstarted=%s\n' "$main" "$max" "$label" "$(date -u +%FT%TZ)" > "$STATE_ROOT/$id/meta"
  [[ -f "$LIB/swarm.md" ]] || die "prompt ausente: $LIB/swarm.md"
  prompt="$(sed -e "s|{{REPO}}|$name|g" -e "s|{{REPO_PATH}}|$main|g" -e "s|{{MAX}}|$max|g" \
                -e "s|{{LABEL}}|${label:-(nenhum)}|g" -e "s|{{ID}}|$id|g" "$LIB/swarm.md")"
  echo "coordenadora $id · repo $name · max $max${label:+ · label $label}" >&2
  OUTE_SWARM_ID="$id" OUTE_SWARM_MAX="$max" OUTE_SWARM_REPO="$main" \
    exec oute-task -r "$main" "$id" claude "$prompt"
}

cmd_spawn() {
  local agent=claude force=0 kaizen=0 repo="" task="" instr="" main slug n state pane tab out cmd pfile count
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent) agent="${2:?}"; shift 2 ;;
      --force) force=1; shift ;;
      --repo) repo="${2:?}"; shift 2 ;;
      --kaizen) kaizen=1; shift ;;
      -*) die "opção desconhecida: $1" ;;
      *) if [[ -z "$task" ]]; then task="$1"; elif [[ -z "$instr" ]]; then instr="$1"; else die "argumento a mais: $1"; fi; shift ;;
    esac
  done
  [[ -n "$task" && -n "$instr" ]] || die 'uso: oute-swarm spawn <n>-<slug> "<instrução>" [--agent claude|codex|pi]'
  case "$agent" in claude|codex|pi) ;; *) die "agente inválido: $agent" ;; esac
  [[ -n "${HERDR_ENV:-}" && -n "${HERDR_WORKSPACE_ID:-}" ]] || die "rode dentro do herdr"
  slug="$(slugify "$task")"; [[ "$slug" =~ ^[0-9]+-[a-z0-9-]+$ ]] || die "tarefa deve ser <n>-<slug> (ex.: 185-backup-alert), veio: $task"
  n="${slug%%-*}"
  if [[ -n "$repo" ]]; then main="$(resolve_repo "$repo")"
  else main="${OUTE_SWARM_REPO:-$(main_root "$PWD" || true)}"; [[ -n "$main" ]] || die "repo não identificado (rode na worktree da coordenadora)"; fi
  [[ "$main" != *[[:space:]]* ]] || die "caminho de repo com espaço não suportado: $main"
  state="$STATE_ROOT/${OUTE_SWARM_ID:-avulso}"; mkdir -p "$state"; touch "$state/spawned"; rm -f "$state/fechada"
  if grep -qs "^$slug " "$state/spawned"; then die "$slug já foi aberta nesta rodada"; fi
  # sessão kaizen (7º campo) não conta no limite
  count="$(awk '$7 != "kaizen"' "$state/spawned" | wc -l)"
  if (( ! force && ! kaizen )) && [[ -n "${OUTE_SWARM_MAX:-}" ]] && (( count >= OUTE_SWARM_MAX )); then
    die "limite da rodada atingido ($count/$OUTE_SWARM_MAX); peça ao Bardi para liberar e use --force"
  fi
  pfile="$state/$slug.prompt"
  {
    printf '%s\n\n' "$instr"
    sed -e "s|{{N}}|$n|g" -e "s|{{SLUG}}|$slug|g" -e "s|{{ID}}|${OUTE_SWARM_ID:-avulso}|g" "$LIB/swarm-worker.md"
  } > "$pfile"
  out="$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$main" --label "#$n ${slug#*-}" --no-focus 2>&1)" \
    || die "herdr tab create falhou: $out"
  # o id do pane tem o formato w<N>:p<id>; o do tab é w<N>:t<id>
  pane="$(printf '%s' "$out" | grep -oE 'w[0-9]+:p[A-Za-z0-9]+' | head -1 || true)"
  tab="$(printf '%s' "$out" | grep -oE 'w[0-9]+:t[A-Za-z0-9]+' | head -1 || true)"
  [[ -n "$pane" ]] || die "não achei o pane da aba nova na saída do herdr: $out"
  printf -v cmd 'OUTE_SWARM_WORKER=1 oute-task -r %q %q %q "$(cat %q)"' "$main" "$slug" "$agent" "$pfile"
  herdr pane run "$pane" "$cmd" >/dev/null || die "herdr pane run falhou em $pane"
  # slug pane agente início aba repo tipo (linhas antigas param na aba: repo = o da rodada)
  printf '%s %s %s %s %s %s %s\n' "$slug" "$pane" "$agent" "$(date -u +%FT%TZ)" "${tab:--}" "$main" \
    "$( (( kaizen )) && echo kaizen || echo -)" >> "$state/spawned"
  echo "aberta: #$n → pane $pane · worktree $(basename "$main")-$slug · agente $agent$( (( kaizen )) && echo ' · kaizen (fora do --max)')"
}

# id atual da aba pelo label "#<n> <resto>" (ids mudam quando o herdr restaura a sessão, ex.: depois de oute update)
tab_by_label() {
  herdr tab list 2>/dev/null | jq -r --arg l "$1" '.. | objects | select((.label? // .name? // "") == $l) | (.tab_id? // .id? // empty)' 2>/dev/null | head -1
}

# o id (ex.: o gravado no spawn) ainda existe em `herdr tab list`?
tab_exists() {
  herdr tab list 2>/dev/null | jq -e --arg t "$1" 'any(.. | objects; (.tab_id? // "") == $t)' >/dev/null 2>&1
}

# abas fechadas da rodada ficam em $state/closed (spawned é histórico e não muda)
is_closed() { grep -qsxF -- "$2" "$1/closed"; }
mark_closed() { is_closed "$1" "$2" || printf '%s\n' "$2" >> "$1/closed"; }

# rodada: a da coordenadora (OUTE_SWARM_ID) ou, fora dela, a mais recente
round_dir() {
  local d
  if [[ -n "${OUTE_SWARM_ID:-}" ]]; then d="$STATE_ROOT/$OUTE_SWARM_ID"
  else d="$(ls -dt "$STATE_ROOT"/*/ 2>/dev/null | head -1)"; d="${d%/}"; fi
  [[ -n "$d" && -f "$d/spawned" ]] || die "nenhuma aba registrada (${d:-$STATE_ROOT})"
  printf '%s' "$d"
}

# texto do campo de entrada do agente no pane (sem a sugestão esmaecida), numa linha; exit 1 se não achar o campo.
# claude/pi: entre as duas últimas linhas horizontais (─; a de cima pode trazer rótulo, ex.: "── ⠦ Working ──" do pi),
# sem o marcador ❯/>. codex: bloco do último "›", que também marca a opção de listas/diálogos (confiar na pasta, hooks,
# command center): aí não há campo (exit 1), porque digitar ali escolhe opções. Idem seletor do pi (/model…).
field_text() {
  local raw
  raw="$(herdr pane read "$1" --source visible --format ansi 2>/dev/null)" || return 1
  # 1) tira os códigos ANSI e o texto esmaecido (SGR 2: sugestão/placeholder) até o reset (0/22), mesmo com outros
  #    códigos no meio (o placeholder do codex vem ESC[2m ESC[48;2;…m texto ESC[0m); 38/48/58;2;r;g;b não são SGR 2
  # 2) braille (U+2800–28FF): animação do composer vazio do codex e spinner do pi; NBSP (depois do ❯) vira espaço
  printf '%s\n' "$raw" | LC_ALL=C awk '{
      out = ""; s = $0
      while ((i = index(s, "\033[")) > 0) {
        if (!dim) out = out substr(s, 1, i - 1)
        s = substr(s, i + 2)
        if (!match(s, /^[0-9;?]*[@-~]/)) { s = ""; break }
        seq = substr(s, 1, RLENGTH); s = substr(s, RLENGTH + 1)
        if (seq !~ /m$/) continue
        n = split(substr(seq, 1, length(seq) - 1), p, ";"); if (n == 0) dim = 0
        for (k = 1; k <= n; k++) {
          if (p[k] == "" || p[k] + 0 == 0 || p[k] + 0 == 22) dim = 0
          else if (p[k] + 0 == 2) dim = 1
          else if (p[k] ~ /^(38|48|58)$/) k += (p[k + 1] == 5 ? 2 : (p[k + 1] == 2 ? 4 : 0))
        }
      }
      if (!dim) out = out s
      print out
    }' | LC_ALL=C sed -e $'s/\r$//' -e $'s/\xe2[\xa0-\xa3][\x80-\xbf]//g' -e $'s/\xc2\xa0/ /g' | awk -v mode="$2" '
    function isrule(s,  t) { t = s; gsub(/─|━|═|╭|╮|╰|╯|├|┤| /, "", t); if (length(s) >= 10 && t == "") return 1
                             t = s; gsub(/^ +| +$/, "", t); return length(t) >= 10 && t ~ /^(──|━━|══)/ && t ~ /(──|━━|══)$/ }
    function clean(s) { gsub(/│/, "", s); sub(/^ *(❯|›|>)( |$)/, "", s); gsub(/^ +| +$/, "", s); return s }
    { l[NR] = $0 }
    END {
      if (mode == "codex") {
        for (i = NR; i >= 1; i--) if (l[i] ~ /^ *(│ *)?›( |$)/) break
        if (i < 1) exit 1
        # lista/diálogo: opção numerada ou dica de teclas de seleção abaixo do "›"
        if (clean(l[i]) ~ /^[0-9]+\. /) exit 1
        for (j = i + 1; j <= NR; j++) if (l[j] ~ /enter (continue|confirm|review|open|select|submit)|esc (back|skip|close|cancel)|↑\/↓/) exit 1
        out = clean(l[i])
        for (j = i + 1; j <= NR && l[j] !~ /^ *$/ && !isrule(l[j]); j++) out = out " " clean(l[j])
      } else {
        for (b = NR; b >= 1 && !isrule(l[b]); b--) ;
        for (a = b - 1; a >= 1 && !isrule(l[a]); a--) ;
        if (a < 1) exit 1
        out = ""
        for (j = a + 1; j < b; j++) {
          # pi: seletor (/model etc.) entre as réguas no lugar do editor; digitar ali filtra/escolhe
          if (mode == "pi" && l[j] ~ /Enter to (select|confirm)|(Esc|Escape)[^ ]* to cancel/) exit 1
          out = out " " clean(l[j])
        }
      }
      gsub(/  +/, " ", out); gsub(/^ | $/, "", out); print out
    }'
}

cmd_tell() {
  local force=0 want="" msg="" have=0 state line slug spane tab label panes pane="" agents st agent text got try
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1 ;;
      -*) die "opção desconhecida: $1" ;;
      *) if (( have == 0 )); then want="$1"; elif (( have == 1 )); then msg="$1"; else die "argumento a mais: $1"; fi; have=$((have + 1)) ;;
    esac; shift
  done
  (( have == 2 )) || die 'uso: oute-swarm tell <n>-<slug> "<mensagem>" [--force]'
  [[ -n "${HERDR_ENV:-}" ]] || die "rode dentro do herdr"
  want="$(slugify "$want")"
  # quebra de linha no send-text viraria Enter sem conferência: a mensagem vai numa linha só, sem controles
  msg="$(printf '%s' "$msg" | tr '\n\r\t' '   ' | tr -d '[:cntrl:]' | tr -s ' ')"; msg="${msg# }"; msg="${msg% }"
  [[ -n "$msg" ]] || die "mensagem vazia"
  state="$(round_dir)"
  line="$(awk -v s="$want" '$1==s' "$state/spawned" | tail -1)"; [[ -n "$line" ]] || die "$want não é desta rodada ($(basename "$state"))"
  read -r slug spane _ _ tab _ <<<"$line"
  label="#${slug%%-*} ${slug#*-}"
  # a partir daqui toda recusa fica no log da rodada
  refuse() { printf '%s tell %s recusado: %s\n' "$(date -u +%FT%TZ)" "$slug" "$1" >> "$state/log"; die "$1; ${2:-nada enviado}"; }
  ! is_closed "$state" "$slug" || refuse "aba $label já fechada (oute-swarm close)"
  # `pane list` não tem --tab (herdr 0.9.1); cada pane traz tab_id, então filtra no jq
  panes="$(herdr pane list 2>&1)" || refuse "herdr pane list falhou: $panes"
  jq -e . >/dev/null 2>&1 <<<"$panes" || refuse "herdr pane list devolveu algo que não é JSON: $panes"
  tab="$(tab_by_label "$label" || true)"
  if [[ -n "$tab" ]]; then
    # pane da aba, preferindo o que tem agente (ids mudam no restore; o gravado no spawn é só fallback)
    pane="$(jq -r --arg t "$tab" '[.. | objects | select(.pane_id? != null and .tab_id? == $t)] | (map(select((.agent? // "") != "")) + .)[0].pane_id // empty' <<<"$panes" 2>/dev/null || true)"
  fi
  # o id gravado no spawn só vale se ainda existir (senão é stale)
  if [[ -z "$pane" && -n "$spane" ]] && jq -e --arg p "$spane" 'any(.. | objects; (.pane_id? // "") == $p)' >/dev/null 2>&1 <<<"$panes"; then
    pane="$spane"
  fi
  [[ -n "$pane" ]] || refuse "pane da aba $label não encontrado (fechada?)"
  # 1) só com a sessão parada: idle/done (pronta) ou blocked (pergunta/aprovação na tela); working/unknown = ocupada
  agents="$(herdr agent list 2>&1)" || refuse "herdr agent list falhou: $agents"
  read -r agent st < <(jq -r --arg p "$pane" '[.. | objects | select(.pane_id? == $p and has("agent_status"))][0] | "\(.agent // "-") \(.agent_status // "-")"' <<<"$agents" 2>/dev/null || echo "- -")
  [[ "$agent" != - && "$agent" != null ]] || refuse "nenhum agente no pane $pane de $label"
  case "$st" in
    idle|done|blocked) ;;
    *) (( force )) || refuse "sessão $label ocupada ($st); tente depois (o Bardi pode usar --force)"
       echo "aviso: sessão $label em '$st'; seguindo por --force" >&2 ;;
  esac
  # 2) digita, confere o campo e só então Enter. Não bateu: limpa (ctrl+c, só com a sessão pronta) e tenta uma vez
  text="[coordenadora $(basename "$state"), repassando o Bardi] $msg"
  # acima de 800 caracteres o Claude Code mostra "[Pasted text #n]" e o campo não dá para conferir
  (( ${#text} <= 800 )) || refuse "mensagem longa demais (${#text} caracteres com o prefixo; máx. 800); resuma"
  # sem campo na tela (diálogo/lista; o herdr dá idle no codex nesses casos) nada é digitado: teclas ali escolhem opções
  field_text "$pane" "$agent" >/dev/null || refuse "campo de entrada de $label não encontrado na tela (diálogo ou lista aberta?)"
  for try in 1 2; do
    herdr pane send-text "$pane" "$text" >/dev/null || refuse "send-text falhou em $pane"
    sleep 0.5
    got="$(field_text "$pane" "$agent")" || got="(campo de entrada não encontrado na tela)"
    if [[ "$(tr -d '[:space:]' <<<"$got")" == "$(tr -d '[:space:]' <<<"$text")" ]]; then
      herdr pane send-keys "$pane" enter >/dev/null || refuse "send-keys enter falhou em $pane" "texto digitado, sem Enter"
      printf '%s tell %s ok%s\n' "$(date -u +%FT%TZ)" "$slug" "$( (( force )) && echo " (--force, $st)")" >> "$state/log"
      echo "enviado a $label ($pane)"
      return 0
    fi
    (( try == 1 )) || break
    [[ "$st" == idle || "$st" == done ]] || break   # ctrl+c/esc com a sessão trabalhando ou num diálogo interromperia/responderia
    herdr pane send-keys "$pane" ctrl+c >/dev/null 2>&1 || break
    sleep 0.5
    [[ -z "$(field_text "$pane" "$agent" 2>/dev/null)" ]] || break   # não limpou: não empilha outro ctrl+c
  done
  printf 'oute-swarm: campo de %s ficou assim (esperado a mensagem exata):\n%s\n' "$label" "$got" >&2
  refuse "o campo de entrada não contém exatamente a mensagem" "sem Enter; confira o pane $pane"
}

cmd_close() {
  local yes=0 all=0 want="" slug pane agent ts tab label id closed=0 pending=0 found=0 failed=0 state
  while [[ $# -gt 0 ]]; do
    case "$1" in --yes) yes=1 ;; --all) all=1 ;; -*) die "opção desconhecida: $1" ;; *) want="$(slugify "$1")" ;; esac; shift
  done
  (( all )) || [[ -n "$want" ]] || die "uso: oute-swarm close <n>-<slug>|--all [--yes]"
  [[ -n "${HERDR_ENV:-}" ]] || die "rode dentro do herdr"
  state="$(round_dir)"
  echo "rodada $(basename "$state")"
  while read -r slug pane agent ts tab _; do
    [[ -n "$slug" ]] || continue
    (( all )) || [[ "$slug" == "$want" ]] || continue
    found=1
    label="#${slug%%-*} ${slug#*-}"
    if is_closed "$state" "$slug"; then (( all )) || echo "já fechada: $label"; continue; fi
    # label primeiro; o id gravado no spawn só vale se ainda existir (senão é stale)
    id="$(tab_by_label "$label")"
    if [[ -z "$id" && "${tab:--}" != - ]] && tab_exists "$tab"; then id="$tab"; fi
    if [[ -z "$id" ]]; then
      echo "já fechada: $label"
      (( ! yes )) || mark_closed "$state" "$slug"
      continue
    fi
    pending=1
    if (( yes )); then
      if herdr tab close "$id" >/dev/null 2>&1; then echo "fechada: $label ($id)"; closed=1; mark_closed "$state" "$slug"
      else echo "falhou fechar $label ($id); feche manualmente" >&2; failed=1; fi
    else echo "fechar: $label ($id)"; fi
  done < "$state/spawned"
  (( all || found )) || die "$want não é desta rodada ($(basename "$state"))"
  # rodada fechada: o `oute-swarm watch` vê a marca e sai sozinho
  if (( all && yes && ! failed )); then date -u +%FT%TZ > "$state/fechada"; fi
  if (( ! pending )); then (( ! all )) || echo "nada a fechar"; return 0; fi
  (( yes )) || echo "(simulação — rode com --yes para fechar)"
  (( ! closed )) || echo "depois: oute-task clean  (e cancele os handoffs órfãos)"
}

# ---- watch: monitor da coordenadora (#45) ----
# Cada passada monta um retrato normalizado da rodada (chave<TAB>valor) e compara com o anterior; só imprime linha
# para mudança real. O retrato fica em $state/watch.state: a 1ª passada da rodada só grava a linha de base (silêncio)
# e um watch reiniciado (monitor expirou) compara com o último retrato, sem perder o que mudou no intervalo.
# Falha de herdr/gh numa passada não vira evento: o estado anterior daquela fonte é mantido (e sai um aviso só).
W_INBOX="${OUTE_INBOX:-$HOME/inbox}" W_OUTBOX="${OUTE_OUTBOX:-$HOME/outbox}"
declare -A W_PREV=() W_CUR=() W_IID=()

# evento: no stdout (monitor da coordenadora) e no log da rodada, com data/hora UTC (linha do tempo da retrospectiva)
w_ev() {
  [[ -n "$2" ]] || return 0
  printf '%s [%s] %s\n' "$(date +%H:%M)" "$1" "$2"
  printf '%s watch [%s] %s\n' "$(date -u +%FT%TZ)" "$1" "$2" >> "$W_STATE/log" || true
}
w_keep() { local k; for k in "${!W_PREV[@]}"; do [[ "$k" == "$1"* ]] && W_CUR[$k]="${W_PREV[$k]}"; done; return 0; }
w_label() { printf '#%s %s' "${1%%-*}" "${1#*-}"; }
# PR/issue de outro repo que o da rodada vêm como <repo>#<n> (sem colisão de número); os da rodada, só <n>
w_pfx() { [[ "$1" == "$2" ]] || printf '%s#' "$(basename "$1")"; }
w_ref() { if [[ "$1" == *"#"* ]]; then printf '%s' "$1"; else printf '#%s' "$1"; fi; }
w_hdr() { sed -n "s/^# $2: //p;/^\$/q" "$1" 2>/dev/null | head -1 || true; }

w_snapshot() {
  local state="$1" main="$2" since="$3" slug _p _a _ts tab repo label tabs kind num n st mg url name res all ns f id rc
  local gh_ok=1
  W_CUR=(); W_IID=()
  # abas e sessões: relidas do estado da rodada a cada passada (spawn/close depois de iniciado entram sozinhos)
  if tabs="$(herdr tab list 2>/dev/null)" && jq -e .result >/dev/null 2>&1 <<<"$tabs"; then
    while read -r slug _p _a _ts tab repo _; do
      [[ -n "$slug" ]] || continue
      W_IID[$slug]="$(w_pfx "${repo:-$main}" "$main")${slug%%-*}"
      if is_closed "$state" "$slug"; then W_CUR["tab|$slug"]=closed; continue; fi
      label="$(w_label "$slug")"
      # a aba pelo id gravado no spawn (se ainda tem o label) ou pelo label (ids mudam no restore do herdr)
      st="$(jq -r --arg l "$label" --arg t "${tab:--}" '[.. | objects | select(.tab_id? != null and (.label? // "") == $l)]
             | (map(select(.tab_id == $t)) + .)[0] // empty | .agent_status // "unknown"' <<<"$tabs" 2>/dev/null || true)"
      if [[ -z "$st" ]]; then W_CUR["tab|$slug"]=closed; continue; fi
      W_CUR["tab|$slug"]=open
      case "$st" in working|idle|done|blocked) ;; *) st=none ;; esac
      W_CUR["agent|$slug"]="$st"
    done < <(cat "$state/spawned" 2>/dev/null)
  else
    w_keep "tab|"; w_keep "agent|"; W_CUR["falha|herdr"]=1
  fi
  # PRs da rodada: criados depois do início, branch <tipo>/<n>-… (ou sessao/<n>-…) de uma issue aberta nela, em cada
  # repo das sessões (6º campo do spawned; sem ele, o da rodada). Um repo que falha mantém o estado anterior de todos.
  all=""
  while read -r repo; do
    [[ -n "$repo" ]] || continue
    ns="$(awk -v m="$main" -v r="$repo" '($6 == "" ? m : $6) == r {split($1, a, "-"); print a[1]}' "$state/spawned" \
          | jq -Rsc 'split("\n") | map(select(. != ""))')" || { gh_ok=0; break; }
    if res="$(cd "$repo" && gh pr list --state all --limit 100 --json number,headRefName,state,mergeable,createdAt,url,statusCheckRollup 2>/dev/null)" \
       && res="$(jq -r --arg since "$since" --argjson ns "$ns" --arg pf "$(w_pfx "$repo" "$main")" '
          def r: (.conclusion // "" | if . == "" then null else . end) // (.state // "") | ascii_upcase
                 | if test("^(SUCCESS|NEUTRAL|SKIPPED)$") then "pass"
                   elif test("^(FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STARTUP_FAILURE|STALE)$") then "fail"
                   else "pending" end;
          .[] | select((.createdAt // "") >= $since) | . as $p
          | ($p.headRefName | split("/") | last | capture("^(?<n>[0-9]+)-").n) as $n
          | select(any($ns[]; . == $n))
          | "pr\t\($pf)\($p.number)\t\($pf)\($n)\t\($p.state)\t\($p.mergeable // "UNKNOWN")\t\($p.url)",
            ([$p.statusCheckRollup[]? | {name: ((.name // .context // "?") | gsub("[\t\n|]"; " ")),
                                           t: (.completedAt // .startedAt // ""), r: r}]
             | group_by(.name)[] | max_by(.t) | "ci\t\($pf)\($p.number)\t\(.name)\t\(.r)")' <<<"$res" 2>/dev/null)"; then
      all+="${res:+$res$'\n'}"
    else
      gh_ok=0; break
    fi
  done < <(awk -v m="$main" '{print ($6 == "" ? m : $6)}' "$state/spawned" 2>/dev/null | sort -u)
  if (( gh_ok )); then
    while IFS=$'\t' read -r kind num n st mg url; do
      case "$kind" in
        pr)
          W_CUR["pr|$num|$n"]="$st"; W_CUR["url|$num"]="$url"
          case "$mg" in
            CONFLICTING) W_CUR["merge|$num"]=conflict ;;
            MERGEABLE) W_CUR["merge|$num"]=ok ;;
            *) [[ -z "${W_PREV[merge|$num]:-}" ]] || W_CUR["merge|$num"]="${W_PREV[merge|$num]}" ;;   # UNKNOWN: recalculando
          esac ;;
        ci) name="$n"; W_CUR["ci|$num|$name"]="$st" ;;
      esac
    done <<<"$all"
  else
    w_keep "pr|"; w_keep "url|"; w_keep "merge|"; w_keep "ci|"; W_CUR["falha|gh"]=1
  fi
  # canal de aprovação (de todos os agentes): pedido pendente em ~/outbox e resultado em ~/inbox
  for f in "$W_OUTBOX"/*.sh; do
    [[ -f "$f" ]] || continue
    id="$(basename "$f" .sh)"; W_CUR["ask|$id"]=pending
  done
  for f in "$W_INBOX"/*.out; do
    [[ -f "$f" ]] || continue
    rc="$(w_hdr "$f" rc)"; W_CUR["res|$(basename "$f" .out)"]="${rc:-?}"
  done
}

w_diff() {
  local k new old kind a b slug num pr f t
  while IFS= read -r k; do
    [[ -n "$k" ]] || continue
    new="${W_CUR[$k]:-}" old="${W_PREV[$k]:-}"
    [[ "$new" != "$old" ]] || continue
    IFS='|' read -r kind a b <<<"$k"
    case "$kind" in
      tab)
        case "$old>$new" in
          ">open") w_ev aba "$(w_label "$a"): aberta" ;;
          "closed>open") w_ev aba "$(w_label "$a"): reaberta" ;;
          "open>closed") w_ev aba "$(w_label "$a"): fechada$(is_closed "$W_STATE" "$a" || echo ' (sumiu do herdr, sem oute-swarm close)')" ;;
        esac ;;
      agent)
        [[ -n "$new" ]] || continue   # aba fechada: a sessão sai junto (o evento é o da aba)
        slug="$a" pr=""
        for t in "${!W_CUR[@]}"; do
          [[ "$t" == "pr|"*"|${W_IID[$slug]:-${slug%%-*}}" ]] || continue
          num="${t#pr|}"; num="${num%%|*}"; pr="${pr:+$pr, }PR $(w_ref "$num") ${W_CUR[$t],,}"
        done
        case "$new" in
          idle|done|blocked) w_ev sessao "$(w_label "$slug"): $new (${pr:-sem PR})" ;;
          working) if [[ "$old" =~ ^(idle|done|blocked)$ ]]; then w_ev sessao "$(w_label "$slug"): working (voltou a trabalhar)"; fi ;;
          none) if [[ "$old" =~ ^(working|idle|done|blocked)$ ]]; then w_ev sessao "$(w_label "$slug"): sem agente na aba (o agente saiu?)"; fi ;;
        esac ;;
      pr)
        [[ -n "$new" ]] || continue
        case "$new" in
          OPEN) w_ev pr "PR $(w_ref "$a") aberto (issue $(w_ref "$b")) ${W_CUR[url|$a]:-}" ;;
          MERGED) w_ev pr "PR $(w_ref "$a") mergeado (issue $(w_ref "$b"))" ;;
          CLOSED) w_ev pr "PR $(w_ref "$a") fechado sem merge (issue $(w_ref "$b"))" ;;
          *) w_ev pr "PR $(w_ref "$a"): $new (issue $(w_ref "$b"))" ;;
        esac ;;
      ci)
        [[ "$new" == pass || "$new" == fail ]] || continue
        w_ev ci "PR $(w_ref "$a") · $b: $new" ;;
      merge)
        case "$old>$new" in
          *">conflict") w_ev conflito "PR $(w_ref "$a") em conflito com a base (mergeable=CONFLICTING)" ;;
          "conflict>ok") w_ev conflito "PR $(w_ref "$a") sem conflito de novo" ;;
        esac ;;
      ask)
        [[ "$new" == pending ]] || continue
        f="$W_OUTBOX/$a.sh"
        w_ev canal "pedido pendente $a: $(w_hdr "$f" titulo) (agente $(w_hdr "$f" agente), $(w_hdr "$f" como)) — aprovação no host: oute watch" ;;
      res)
        [[ -n "$new" && "$new" != 0 ]] || continue
        if [[ "$new" == 126 ]] && grep -qs '^# recusado:' "$W_INBOX/$a.out"; then w_ev canal "pedido $a recusado no host"
        else w_ev canal "resultado $a: rc=$new (oute-inbox $a)"; fi ;;
      falha)
        if [[ -n "$new" ]]; then w_ev aviso "$a falhou nesta passada; mantendo o último estado conhecido"
        else w_ev aviso "$a respondendo de novo"; fi ;;
    esac
  done < <(printf '%s\n' "${!W_CUR[@]}" "${!W_PREV[@]}" | sort -u \
             | awk -F'|' 'BEGIN { split("falha tab agent pr ci merge ask res", o, " "); for (i in o) p[o[i]] = i }
                          { print (p[$1] ? p[$1] : 9) "\t" $0 }' | sort -s -n -k1,1 | cut -f2-)
}

cmd_watch() {
  local interval=60 round="" main since sfile tmp k v first=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --interval) interval="${2:?}"; shift 2 ;;
      --round) round="${2:?}"; shift 2 ;;
      *) die "uso: oute-swarm watch [--interval s] [--round <rodada>]" ;;
    esac
  done
  [[ "$interval" =~ ^[0-9]+$ ]] && (( interval >= 10 )) || die "--interval inválido: $interval (mínimo 10 s)"
  round="${round:-${OUTE_SWARM_ID:-}}"
  if [[ -n "$round" ]]; then W_STATE="$STATE_ROOT/$round"
  else W_STATE="$(ls -dt "$STATE_ROOT"/*/ 2>/dev/null | head -1)"; W_STATE="${W_STATE%/}"; fi
  [[ -n "$W_STATE" && -f "$W_STATE/meta" ]] || die "rodada não encontrada: ${W_STATE:-$STATE_ROOT}"
  main="$(sed -n 's/^repo=//p' "$W_STATE/meta")"; since="$(sed -n 's/^started=//p' "$W_STATE/meta")"
  [[ -d "$main" ]] || die "repo da rodada não encontrado: $main"
  command -v herdr >/dev/null && command -v gh >/dev/null && command -v jq >/dev/null || die "precisa de herdr, gh e jq"
  sfile="$W_STATE/watch.state"
  # um watch por rodada: o mais novo assume, e o antigo (monitor que expirou sem matar o processo) sai na próxima passada
  printf '%s\n' "$$" > "$W_STATE/watch.pid"
  if [[ -s "$sfile" ]]; then
    while IFS=$'\t' read -r k v; do [[ -n "$k" ]] && W_PREV[$k]="$v"; done < "$sfile"
    first=0
  fi
  echo "oute-swarm watch: rodada $(basename "$W_STATE") · a cada ${interval}s · $( (( first )) && echo 'linha de base nesta passada' || echo 'comparando com o último estado salvo')" >&2
  while :; do
    [[ "$(cat "$W_STATE/watch.pid" 2>/dev/null)" == "$$" ]] || { echo "oute-swarm watch: outro watch assumiu a rodada; saindo" >&2; exit 0; }
    if [[ -f "$W_STATE/fechada" ]]; then
      w_ev rodada "$(basename "$W_STATE") fechada (oute-swarm close --all); watch encerrado"
      rm -f "$W_STATE/watch.pid"; exit 0
    fi
    w_snapshot "$W_STATE" "$main" "$since"
    (( first )) || w_diff
    first=0
    tmp="$(mktemp "$W_STATE/.watch.XXXXXX")"
    for k in "${!W_CUR[@]}"; do printf '%s\t%s\n' "$k" "${W_CUR[$k]}"; done | sort > "$tmp"
    mv "$tmp" "$sfile"
    W_PREV=(); for k in "${!W_CUR[@]}"; do W_PREV[$k]="${W_CUR[$k]}"; done
    sleep "$interval"
  done
}

cmd_list() {
  local d line
  for d in "$STATE_ROOT"/*/; do
    [[ -f "$d/spawned" ]] || continue
    echo "== $(basename "$d")"
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      if is_closed "${d%/}" "${line%% *}"; then echo "  $line (fechada)"; else echo "  $line"; fi
    done < "$d/spawned"
  done
  echo "== worktrees"; oute-task list
}

case "${1:-}" in
  ""|-h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
  spawn) shift; cmd_spawn "$@" ;;
  tell) shift; cmd_tell "$@" ;;
  close) shift; cmd_close "$@" ;;
  watch) shift; cmd_watch "$@" ;;
  list) cmd_list ;;
  *) cmd_start "$@" ;;
esac
