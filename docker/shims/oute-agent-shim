#!/usr/bin/env bash
# Shim de claude/codex (vem antes dos binários reais no PATH): abrir o agente no CHECKOUT PRINCIPAL de um
# repo git cria uma worktree própria (oute-task) e abre a sessão lá. Vale para shell, herdr (new/restore) etc.
# Passa direto: worktree, fora de repo, headless (-p/--print/exec…), resume/continue (num resume com id, entra antes na
# worktree da sessão), subcomandos, sem terminal, OUTE_NO_WORKTREE=1.
# Opt-in OUTE_MEMORY_RUN=1 (#367): sessão interativa em worktree roda sob `ai-memory run` (ver memory_run).
set -uo pipefail
a="$(basename "$0")"
# `pi` segue como shim só para avisar (o binário antigo pode continuar em ~/.local/bin, no volume oute-home)
[[ "$a" != pi ]] || { echo "oute: Pi saiu do stack (#217), use claude ou codex" >&2; exit 1; }
shims="$(cd "$(dirname "$0")" && pwd)"
clean_path="$(printf '%s' ":$PATH:" | sed "s#:$shims:#:#g; s#^:##; s#:\$##")"
# Sem o agente no PATH (ainda não instalado em ~/.local/bin pelo oute-agents-install), usa a cópia de reserva da imagem.
fallback="${OUTE_AGENTS_FALLBACK:-/opt/oute/agents/bin}"
real="$(PATH="$clean_path" command -v "$a")" || { [[ -x "$fallback/$a" ]] && real="$fallback/$a"; } \
  || { echo "oute: $a não encontrado" >&2; exit 127; }
pass() { exec "$real" "$@"; }

# Restore do herdr: relança a sessão (`claude --resume <id>`, `codex resume <id>`) num shell novo,
# no cwd salvo do pane (o checkout principal, nas abas abertas por oute-task/oute-swarm), sem a env que o oute-task deu.
# O shim acha o cwd da sessão no transcript e, se for uma worktree de tarefa do mesmo repo, faz cd para ela (#40).
# Se a worktree tem a marca do oute-task (<git-dir>/oute-swarm-worker), desliga de novo a sugestão de prompt (#39).
resume_id() {   # id da sessão retomada (vazio se não é resume com id)
  local prev="" x i=0
  for x in "$@"; do
    i=$((i + 1))
    case "$a" in
      claude)
        case "$prev" in -r|--resume) printf '%s' "$x"; return ;; esac
        case "$x" in --resume=*) printf '%s' "${x#--resume=}"; return ;; esac ;;
      codex)   # codex resume [opções] <id>: primeiro argumento que não é opção
        [[ "${1:-}" == resume ]] || return 0
        if (( i > 1 )) && [[ "$x" != -* ]]; then
          case "$prev" in -c|--config|-m|--model|-p|--profile|-s|--sandbox|-a|--ask-for-approval|-C|--cd|-i|--image|--add-dir|--enable|--disable|--remote|--remote-auth-token-env|--local-provider) ;;
            *) printf '%s' "$x"; return ;; esac
        fi ;;
    esac
    prev="$x"
  done
}
resume_cwd() {   # cwd gravado no transcript da sessão <id>
  local id="$1" f
  [[ "$id" =~ ^[A-Za-z0-9-]+$ ]] || return 0
  case "$a" in
    claude) f="$(ls -t "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/"$id.jsonl" 2>/dev/null | head -n1)" ;;
    codex)  f="$(find "${CODEX_HOME:-$HOME/.codex}/sessions" -type f -name "rollout-*$id.jsonl" 2>/dev/null | head -n1)" ;;
  esac
  [[ -n "$f" && -f "$f" ]] || return 0
  grep -m1 -o '"cwd":"[^"]*"' "$f" | sed 's/^"cwd":"//; s/"$//'
}
swarm_env() {   # sessão do swarm (marca no git-dir da worktree): sem sugestão de prompt no claude
  local gd
  [[ "$a" == claude && -z "${CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION:-}" ]] || return 0
  gd="$(git -C "$1" rev-parse --path-format=absolute --git-dir 2>/dev/null)" || return 0
  if [[ -f "$gd/oute-swarm-worker" ]]; then export CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=false; fi
}
resume_in_worktree() {
  local id cwd real here wt_root gd cd_ my_cd
  id="$(resume_id "$@")"; [[ -n "$id" ]] || return 0
  cwd="$(resume_cwd "$id")"; [[ -n "$cwd" ]] || return 0
  here="$(pwd -P)"
  real="$(cd "$cwd" 2>/dev/null && pwd -P)" || { printf 'oute: a sessão %s era de %s, que não existe mais; retomando em %s.\n' "$id" "$cwd" "$here" >&2; return 0; }
  if [[ "$real" == "$here" ]]; then swarm_env "$real"; return 0; fi
  wt_root="$(cd "${OUTE_WORKTREES:-/workspace/.worktrees}" 2>/dev/null && pwd -P)" || wt_root="${OUTE_WORKTREES:-/workspace/.worktrees}"
  local why=""
  if [[ "$real/" != "$wt_root/"* ]]; then why="fora de $wt_root"
  elif ! gd="$(git -C "$real" rev-parse --path-format=absolute --git-dir 2>/dev/null)" \
    || ! cd_="$(git -C "$real" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || [[ "$gd" == "$cd_" ]]; then why="não é uma worktree"
  elif ! my_cd="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || [[ "$my_cd" != "$cd_" ]]; then why="worktree de outro repo"
  fi
  if [[ -n "$why" ]]; then
    printf 'oute: a sessão %s era de %s (%s); retomando em %s, sem trocar de diretório.\n' "$id" "$cwd" "$why" "$here" >&2
    return 0
  fi
  cd "$real" || return 0
  printf 'oute: retomando a sessão %s na worktree %s.\n' "$id" "$real" >&2
  swarm_env "$real"
}
resume_in_worktree "$@"
# Worktree de tarefa com id (marca do oute-task no git-dir): a conversa sai com a sessão no OTEL_RESOURCE_ATTRIBUTES
# (ADR-04, #128), também quando o agente não veio do oute-task: restore do herdr, -c/--resume, -p.
# Sem id (#599): a conversa aberta direto numa pasta de repositório sai só com oute.task.repo = o repositório principal
# da pasta, sem oute.task.id (folder_env). Fora de repositório, não marca.
# Nome do repositório principal da pasta <dir>, como o oute-task o grava (só [A-Za-z0-9._-]): a pasta que contém o `.git`
# comum, igual no checkout principal, numa subpasta e numa worktree. Vazio fora de repositório e em repositório sem
# pasta `.git` própria (bare, submódulo).
folder_repo() {
  local dir="$1" common
  common="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
  [[ "$(basename "$common")" == .git ]] || return 0
  printf '%s' "$(basename "$(dirname "$common")")" | tr -c 'A-Za-z0-9._-' '-'
  return 0
}
# Marca só o repositório. Com oute.task.id já no ambiente (quem chamou marcou a conversa, ex.: oute-regression), não mexe.
# O oute.task.repo que veio de outra pasta sai e entra o desta; o resto do valor fica como está.
folder_env() {
  local dir="$1" repo out="" part k parts=()
  repo="$(folder_repo "$dir")"
  [[ -n "$repo" ]] || return 0
  IFS=, read -r -a parts <<<"${OTEL_RESOURCE_ATTRIBUTES:-}" || true
  for part in ${parts[@]+"${parts[@]}"}; do
    k="${part%%=*}"; k="${k//[[:space:]]/}"
    case "$k" in
      oute.task.id) return 0 ;;
      ""|oute.task.repo) continue ;;
    esac
    out+="${out:+,}$part"
  done
  export OTEL_RESOURCE_ATTRIBUTES="${out:+$out,}oute.task.repo=$repo"
  return 0
}
task_env() {
  local v=""
  if command -v oute-task >/dev/null 2>&1; then v="$(oute-task --mark "$PWD" 2>/dev/null)" || v=""; fi
  if [[ -n "$v" ]]; then export OTEL_RESOURCE_ATTRIBUTES="$v"; else folder_env "$PWD"; fi
}
task_env
# Modelo da sessão (ADR-02, #219): quem retoma a conversa (restore do herdr, --resume, -c; `codex resume`) reabre com o
# modelo que a marca guardou (e o esforço, no Codex), se a marca é deste agente e a linha de comando não traz modelo.
model_env() {
  local x resume=0 extra=()
  command -v oute-task >/dev/null 2>&1 || return 0
  case "$a" in
    claude) for x in "$@"; do case "$x" in -r|--resume|--resume=*|-c|--continue) resume=1 ;; --model|--model=*) return 0 ;; esac; done ;;
    codex)  [[ "${1:-}" == resume ]] && resume=1
            for x in "$@"; do case "$x" in -m|--model|--model=*) return 0 ;; esac; done ;;
  esac
  (( resume )) || return 0
  mapfile -t extra < <(oute-task --model-args "$a" "$PWD" 2>/dev/null)
  [[ ${#extra[@]} -eq 0 ]] || MODEL_ARGS=("${extra[@]}")
}
MODEL_ARGS=()
model_env "$@"
[[ ${#MODEL_ARGS[@]} -eq 0 ]] || set -- "$@" "${MODEL_ARGS[@]}"

# Sessão nova e interativa: terminal, sem headless/ajuda/versão/resume/continue e sem subcomando.
fresh_interactive() {
  local x
  [[ -t 0 && -t 1 ]] || return 1
  for x in "$@"; do
    case "$x" in
      -p|--print|-h|--help|-v|--version|-r|--resume|--resume=*|-c|--continue) return 1 ;;
    esac
  done
  case "${1:-}" in   # subcomandos (não abrem sessão de trabalho)
    exec|e|resume|login|logout|mcp|config|doctor|update|install|plugin|completion|apply|app-server|sandbox|debug|setup-token|migrate-installer) return 1 ;;
  esac
}
# Opt-in OUTE_MEMORY_RUN=1 (#367): sessão interativa DENTRO de uma worktree de tarefa roda sob `ai-memory run`, para o
# outro agente (ai-memory run codex, na mesma worktree) receber o contexto da conversa quando a cota estoura. Vem antes
# do OUTE_NO_WORKTREE porque o oute-task abre o agente com ele. Sem --yolo (a config do entrypoint decide) e com
# --no-autowire (o entrypoint já instala hooks e MCP). No checkout principal não age: o fluxo do oute-task vem antes.
# Worker do swarm fica fora. Devolve (sem exec) quando não se aplica.
memory_run() {
  local gd cd_
  [[ -n "${OUTE_MEMORY_RUN:-}" && "${OUTE_MEMORY_RUN:-}" != 0 ]] || return 0
  fresh_interactive "$@" || return 0
  [[ -z "${AI_MEMORY_RUN_ID:-}" ]] || return 0   # já está sob run: sem recursão
  gd="$(git rev-parse --path-format=absolute --git-dir 2>/dev/null)" || return 0
  cd_="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
  [[ "$gd" != "$cd_" && ! -f "$gd/oute-swarm-worker" ]] || return 0
  command -v ai-memory >/dev/null 2>&1 || { echo "oute: OUTE_MEMORY_RUN=1, mas o ai-memory não está no PATH; abrindo $a sem ai-memory run." >&2; return 0; }
  exec ai-memory run "$a" --no-autowire --executable "$real" -- "$@"
}
memory_run "$@"

[[ -n "${OUTE_NO_WORKTREE:-}" ]] && pass "$@"
fresh_interactive "$@" || pass "$@"
gd="$(git rev-parse --path-format=absolute --git-dir 2>/dev/null)" || pass "$@"
cd_="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || pass "$@"
[[ "$gd" == "$cd_" ]] || pass "$@"     # já é uma worktree

def="sessao-$(date +%m%d-%H%M)"
printf 'oute: %s no checkout principal de %s — a sessão vai para uma worktree própria.\n' "$a" "$(basename "$(dirname "$cd_")")" >/dev/tty
read -r -p "nome da tarefa [$def]: " s </dev/tty || exit 130
exec oute-task "${s:-$def}" "$a" "$@"
