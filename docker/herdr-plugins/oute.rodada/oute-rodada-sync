#!/usr/bin/env bash
# oute-rodada-sync — atualiza os tokens do sidebar do herdr com o estado da rodada, a cota e o custo (#722, protótipo).
# Chamado pelo plugin oute.rodada (herdr-plugin.toml): a cada evento do herdr, no startup e pela ação `atualizar`.
#
# uso:  oute-rodada-sync [startup|--force]   sem argumento: o evento do herdr (HERDR_PLUGIN_EVENT) é o gatilho
# Fontes (só leitura, nenhuma chama modelo, ADR-05):
#   rodada   ~/.oute/swarm/<rodada>/{meta,spawned,closed,fechada,watch.state}: o que o `oute-swarm watch` já apurou
#            (agente, PR, CI); este script não chama `gh`
#   cota     `oute-quota --json` (cache de 120 s dele)
#   studio   GET $AGENT_STUDIO_URL/v1/tray (custo do dia, pendências); o token vai ao curl por stdin, nunca no argv
# Saída: `herdr pane report-metadata` (tokens oute_issue, oute_pr, oute_sessao) por sessão aberta e
#   `herdr workspace report-metadata` (oute_rodada, oute_cota, oute_custo) no workspace do dispatcher, com TTL: se o
#   plugin parar, os tokens somem sozinhos. Telemetria: `oute-emit sidebar` (ADR-04), no máximo uma a cada 5 min.
# Ambiente (teste): OUTE_SWARM_STATE_ROOT, OUTE_RODADA_MIN_INTERVAL (s, padrão 10), OUTE_RODADA_TTL_MS (padrão 300000),
#   OUTE_RODADA_EMIT_EVERY (s, padrão 300), HERDR_BIN_PATH, HERDR_PLUGIN_STATE_DIR.
# Sempre sai com 0: falha de fonte vira token ausente, nunca erro no herdr.
{ set +x; } 2>/dev/null
set -uo pipefail

HERDR="${HERDR_BIN_PATH:-herdr}"
ROOT="${OUTE_SWARM_STATE_ROOT:-$HOME/.oute/swarm}"
STATE="${HERDR_PLUGIN_STATE_DIR:-${TMPDIR:-/tmp}/oute-rodada.$(id -u)}"
MIN="${OUTE_RODADA_MIN_INTERVAL:-10}"
TTL="${OUTE_RODADA_TTL_MS:-300000}"
EMIT_EVERY="${OUTE_RODADA_EMIT_EVERY:-300}"
SRC="oute.rodada"
FORCE=0
TRIGGER="${HERDR_PLUGIN_EVENT:-manual}"
case "${1:-}" in
  --force) FORCE=1; TRIGGER=action ;;
  startup) TRIGGER=startup ;;
esac
TRIGGER="$(printf '%s' "$TRIGGER" | tr -c 'a-z0-9_.' '_' | cut -c1-48)"
command -v jq >/dev/null 2>&1 || exit 0

mkdir -p "$STATE" 2>/dev/null || exit 0
exec 9>"$STATE/lock"
flock -n 9 || exit 0          # outra atualização em curso: ela já lê o mesmo disco

now_s() { date +%s; return $?; }
now_ms() { echo $(( $(date +%s%N) / 1000000 )); return $?; }
T0="$(now_ms)"
if (( ! FORCE )); then
  last="$(cat "$STATE/last" 2>/dev/null || echo 0)"
  [[ "$last" =~ ^[0-9]+$ ]] || last=0
  (( $(now_s) - last >= MIN )) || exit 0
fi
now_s > "$STATE/last"

# ---- cota: "cl 13/85 cx ?" (5h/7d usados, em %; ? = sem leitura)
QUOTA_ST=off CTA=""
if command -v oute-quota >/dev/null 2>&1; then
  q="$(timeout 8 oute-quota --json 2>/dev/null)" || q=""
  if jq -e '.agents' >/dev/null 2>&1 <<<"$q"; then
    CTA="$(jq -r '
      def pct: if . == null then "?" else (. | floor | tostring) end;
      def one($a; $l): (.agents[$a] // {}) as $x
        | if $x.status == "ok" then "\($l) \($x.windows["5h"].used_pct | pct)/\($x.windows["7d"].used_pct | pct)" else "\($l) ?" end;
      [one("claude"; "cl"), one("codex"; "cx")] | join(" ")' <<<"$q")"
    if jq -e '[.agents[] | select(.status == "ok")] | length > 0' >/dev/null 2>&1 <<<"$q"; then QUOTA_ST=ok; else QUOTA_ST=unknown; fi
  else
    QUOTA_ST=erro
  fi
fi

# ---- agent-studio: custo do dia e pendências
STUDIO_ST=off CUSTO=""
if [[ -n "${AGENT_STUDIO_URL:-}" && -n "${AGENT_STUDIO_READ_TOKEN:-}" ]] && command -v curl >/dev/null 2>&1; then
  tray="$(printf 'header = "Authorization: Bearer %s"\n' "$AGENT_STUDIO_READ_TOKEN" \
    | curl -fsS -m 3 -K - "${AGENT_STUDIO_URL%/}/v1/tray" 2>/dev/null)" || tray=""
  if jq -e '.cost_today.usd' >/dev/null 2>&1 <<<"$tray"; then
    CUSTO="$(jq -r '"$\(.cost_today.usd | floor) hoje" + (if (.bar.pending // 0) > 0 then " · \(.bar.pending) pend" else "" end)' <<<"$tray")"
    STUDIO_ST=ok
  else
    STUDIO_ST=erro
  fi
fi

# ---- relatório de metadado ao herdr (display-only, com TTL)
FAILS=0 NPANES=0 NWS=0 NROUNDS=0
report_pane() {      # <pane> token=valor…
  local pane="$1"; shift
  local args=() kv
  for kv in "$@"; do [[ "$kv" == *=?* ]] && args+=(--token "$kv"); done
  (( ${#args[@]} )) || return 0
  "$HERDR" pane report-metadata "$pane" --source "$SRC" --ttl-ms "$TTL" "${args[@]}" >/dev/null 2>&1 || FAILS=$((FAILS + 1))
  NPANES=$((NPANES + 1))
  return 0
}
report_ws() {        # <workspace> token=valor…
  local ws="$1"; shift
  local args=() kv
  for kv in "$@"; do [[ "$kv" == *=?* ]] && args+=(--token "$kv"); done
  (( ${#args[@]} )) || return 0
  "$HERDR" workspace report-metadata "$ws" --source "$SRC" --ttl-ms "$TTL" "${args[@]}" >/dev/null 2>&1 || FAILS=$((FAILS + 1))
  NWS=$((NWS + 1))
  return 0
}

# rodada aberta: tem meta e não tem a marca `fechada` (a mesma regra do oute-swarm)
for dir in "$ROOT"/*/; do
  dir="${dir%/}"
  [[ -f "$dir/meta" && ! -f "$dir/fechada" ]] || continue
  NROUNDS=$((NROUNDS + 1))
  name="$(sed -n 's/^name=//p' "$dir/meta" | head -1)"
  dpane="$(sed -n 's/^dispatcher_pane=//p' "$dir/meta" | head -1)"
  [[ -n "$name" ]] || name="$(basename "$dir")"
  open=0
  while read -r slug pane _; do
    [[ -n "${slug:-}" && -n "${pane:-}" ]] || continue
    grep -qsxF -- "$slug" "$dir/closed" && continue
    open=$((open + 1))
    num="${slug%%-*}"
    st="$(awk -F'\t' -v k="agent|$slug" '$1 == k { print $2 }' "$dir/watch.state" 2>/dev/null | head -1)"
    # PR da issue desta sessão: linhas `pr|<pr>|<issue>\t<estado>`; CI do PR: `ci|<pr>|<nome>\t<pass|fail|pend…>`
    pr="" prst="" ci="" prshow=""
    # (de outro repo, o número leva o prefixo `dono/repo#`: o fim da chave é `|<n>` ou `#<n>`)
    pline="$(awk -F'\t' -v n="$num" 'index($1, "pr|") == 1 { t = substr($1, length($1) - length(n)); if (t == "|" n || t == "#" n) { print $1 "\t" $2; exit } }' "$dir/watch.state" 2>/dev/null)"
    if [[ -n "$pline" ]]; then
      key="${pline%%$'\t'*}"; prst="${pline#*$'\t'}"; pr="${key#pr|}"; pr="${pr%%|*}"
      prshow="$pr"; [[ "$prshow" == *'#'* ]] || prshow="#$prshow"
      fails="$(awk -F'\t' -v p="ci|$pr|" 'index($1, p) == 1 && $2 == "fail" { n++ } END { print n + 0 }' "$dir/watch.state")"
      pend="$(awk -F'\t' -v p="ci|$pr|" 'index($1, p) == 1 && $2 != "pass" && $2 != "fail" && $2 != "ok" { n++ } END { print n + 0 }' "$dir/watch.state")"
      if (( fails > 0 )); then ci="ci vermelho"; elif (( pend > 0 )); then ci="ci rodando"; else ci="ci verde"; fi
    fi
    report_pane "$pane" "oute_issue=#$num" "oute_sessao=${st:-?}" ${pr:+"oute_pr=$prshow ${prst,,} · $ci"}
  done < "$dir/spawned"
  if [[ -n "$dpane" ]]; then
    ws="${dpane%%:*}"
    report_ws "$ws" "oute_rodada=$name · $open ab." "oute_cota=$CTA" "oute_custo=$CUSTO"
  fi
done

# ---- telemetria (ADR-04): no máximo uma a cada EMIT_EVERY s, e sempre que algo falhou
RESULT=ok
(( FAILS > 0 )) && RESULT=parcial
[[ "$QUOTA_ST" == erro || "$STUDIO_ST" == erro ]] && RESULT=parcial
last_emit="$(cat "$STATE/last_emit" 2>/dev/null || echo 0)"
[[ "$last_emit" =~ ^[0-9]+$ ]] || last_emit=0
if command -v oute-emit >/dev/null 2>&1 && { [[ "$RESULT" != ok ]] || (( $(now_s) - last_emit >= EMIT_EVERY )); }; then
  now_s > "$STATE/last_emit"
  oute-emit sidebar "trigger=$TRIGGER" "result=$RESULT" "panes=$NPANES" "workspaces=$NWS" "rounds=$NROUNDS" \
    "ms=$(( $(now_ms) - T0 ))" "quota=$QUOTA_ST" "studio=$STUDIO_ST" </dev/null >/dev/null 2>&1 || true
fi
exit 0
