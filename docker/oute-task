#!/usr/bin/env bash
# oute-task — uma sessão de agente = uma git worktree + um branch próprios (padrão do oute-agent).
#
#   oute-task <slug> [claude|codex|shell] [args…]      cria/reabre a worktree da tarefa e abre o agente nela
#   oute-task -r <repo> <slug> [agente]                  idem, para um repo de /workspace (fora dele)
#   oute-task --agent claude|codex --model <id> <slug>   escolha explícita do agente e/ou do modelo (antes do slug)
#   oute-task list                                       worktrees de tarefa abertas (todos os spaces)
#   oute-task clean [--yes] [--space <nome> | --all] [--force-in-use]
#                                                        remove as já mergeadas/vazias (ou detached contidas na base);
#                                                        pula as em uso (#374), salvo --force-in-use
#                                                        e sem mudança local, só do space atual (--space: de outro;
#                                                        --all: de todos, inclusive as do formato antigo); avança (só
#                                                        fast-forward) o checkout principal dos repos com worktree ali
#
# Worktree: /workspace/.worktrees/<space>/<repo>-<slug>, <space> = label do space do herdr em nome de pasta (fora do
# herdr: _sem-space). Branch: sessao/<slug> (renomeie p/ <tipo>/<issue>-<slug> antes do PR). Slug: [a-z0-9-].
# Base: origin/<branch padrão> atualizado. Formato antigo (/workspace/.worktrees/<repo>-<slug>, antes da #277): reabre
# e aparece no list, sem migração; só o clean --all o considera.
# Modelo (ADR-02, #219): o oute-select escolhe pela issue do slug (<n>-…): --agent/--model (ou `codex` posicional, ou
# --model/-m nos args do agente) > label kaizen/docs > label aidlc:<fase> > Jev > Sonnet. Abre com `claude --model <id>`
# ou `codex -m <id> -c model_reasoning_effort=<e>`; a escolha fica na marca da sessão e vale no restore. Nunca bloqueia.
# Jev (#257): sem label de fase e com texto da tarefa (o prompt: último argumento do agente, com mais de uma palavra),
# o oute-select pede a fase ao Jev; sem texto (sessão aberta na mão), Sonnet sem chamar o Jev.
#
# Sessão no bucket (ADR-04, "Sessões (#128)"): abrir, reabrir e remover (clean --yes) emitem oute.task.opened/reopened/
# removed pelo oute-emit, e a conversa do agente sai marcada com a sessão no OTEL_RESOURCE_ATTRIBUTES. Nada disso muda
# saída, exec ou código de saída, nem com o coletor fora ou sem oute-emit.
#   oute-task --mark [dir]   (o shim usa) imprime o OTEL_RESOURCE_ATTRIBUTES com a marca da sessão da worktree; sem id, nada
#   oute-task --model-args <agente> [dir]   (o shim usa) argumentos de modelo da marca, um por linha, se o agente é o dela
set -euo pipefail
WT_ROOT="${OUTE_WORKTREES:-/workspace/.worktrees}"
WS_ROOT="${OUTE_WORKSPACE:-/workspace}"   # a variável só existe para os testes
die() { printf 'oute-task: %s\n' "$*" >&2; exit 1; }
slugify() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' | tr -s '-' | sed 's/^-//; s/-$//' | cut -c1-40; }
# git de rede sem prompt: helper do gh (GH_TOKEN) e nunca pedir usuário/senha no terminal
gitnet() { GIT_TERMINAL_PROMPT=0 git -c credential.https://github.com.helper= -c 'credential.https://github.com.helper=!gh auth git-credential' "$@"; }
main_root() { local c; c="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1; dirname "$c"; }
default_branch() { git -C "$1" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true; }
all_repos() { local d; for d in "$WS_ROOT"/*/; do [[ -d "$d/.git" ]] && echo "${d%/}"; done; }
# worktrees de tarefa de um repo sob <raiz>, uma por linha: "<caminho> <branch>" (detached: "-")
task_worktrees() {   # <repo> <raiz>
  git -C "$1" worktree list --porcelain | awk -v root="$2" '/^worktree /{w=$2} /^branch /{sub("refs/heads/","",$2); if (index(w, root"/")==1) print w, $2} /^detached$/{if (index(w, root"/")==1) print w, "-"}'
}

# ---------------------------------------------------------------- space do herdr (#277)
# Cada worktree fica em $WT_ROOT/<space>: o label do space atual do herdr em nome de pasta; fora do herdr, ou sem achar
# o label, _sem-space (o slugify nunca dá "_", então não colide com um label)
NO_SPACE=_sem-space
space_name() { local s; [[ "$1" == "$NO_SPACE" ]] && s="$1" || s="$(slugify "$1")"; printf '%s' "${s:-$NO_SPACE}"; }
current_space() {
  local label=""
  if [[ -n "${HERDR_ENV:-}" && -n "${HERDR_WORKSPACE_ID:-}" ]]; then
    label="$(herdr workspace get "$HERDR_WORKSPACE_ID" 2>/dev/null | jq -r '.result.workspace.label // empty' 2>/dev/null || true)"
    [[ -n "$label" ]] || echo "aviso: não achei o label do space $HERDR_WORKSPACE_ID no herdr; usando $NO_SPACE" >&2
  fi
  space_name "$label"
}

# ---------------------------------------------------------------- sessão no bucket (ADR-04, #128)
# Marca da sessão: <git-dir da worktree>/oute-task, uma chave por linha (id, repo, slug; em sessão de rodada, round e
# session; com o seletor, agent, model e effort, #219). Fica ao lado da marca oute-swarm-worker e some junto com a
# worktree.
attr() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '-'; }   # valor que cabe no OTEL_RESOURCE_ATTRIBUTES (sem vírgula, sem =)
mark_path() { local gd; gd="$(git -C "$1" rev-parse --path-format=absolute --git-dir 2>/dev/null)" && printf '%s/oute-task' "$gd"; }
mark_get() { [[ -f "$1" ]] || return 0; sed -n "s/^$2=//p" "$1" 2>/dev/null | head -n1 | tr -cd 'A-Za-z0-9._-' || true; }
# id de modelo na marca: como o mark_get, mais o sufixo [1m]
mark_model() { [[ -f "$1" ]] || return 0; sed -n 's/^model=//p' "$1" 2>/dev/null | head -n1 | tr -cd 'A-Za-z0-9._[]-' || true; }
mark_write() {   # <arquivo> <id> <repo> <slug> <rodada> <sessão do swarm> <agente> <modelo> <esforço>
  local f="$1"; shift
  { printf 'id=%s\nrepo=%s\nslug=%s\n' "$1" "$2" "$3"
    [[ -z "$4" ]] || printf 'round=%s\n' "$4"
    [[ -z "$5" ]] || printf 'session=%s\n' "$5"
    [[ -z "$6" ]] || printf 'agent=%s\n' "$6"
    [[ -z "$7" ]] || printf 'model=%s\n' "$7"
    [[ -z "$8" ]] || printf 'effort=%s\n' "$8"; } 2>/dev/null > "$f"
}
# OTEL_RESOURCE_ATTRIBUTES de agora sem oute.task.*/oute.swarm.* (fica a origem) + os pares dados (par sem valor não
# entra): chave que já existia não se repete, vale a nova
otel_attrs() {
  local out="" part k parts=()
  IFS=, read -r -a parts <<<"${OTEL_RESOURCE_ATTRIBUTES:-}" || true
  for part in ${parts[@]+"${parts[@]}"}; do
    k="${part%%=*}"; k="${k//[[:space:]]/}"
    case "$k" in ""|oute.task.*|oute.swarm.*) continue ;; esac
    out+="${out:+,}$part"
  done
  for part in "$@"; do [[ "$part" == *= ]] || out+="${out:+,}$part"; done
  printf '%s' "$out"
}
# marca nas conversas: <id> <repo> <slug> <rodada> <sessão do swarm>. Sem id não marca (e tira a de outra sessão, se
# veio no ambiente de quem chamou)
mark_env() {
  local v
  if [[ -n "$1" ]]; then
    v="$(otel_attrs "oute.task.id=$1" "oute.task.repo=$2" "oute.task.slug=$3" "oute.swarm.round=$4" "oute.swarm.session=$5")"
  else v="$(otel_attrs)"; fi
  [[ -z "$v" && -z "${OTEL_RESOURCE_ATTRIBUTES+x}" ]] || export OTEL_RESOURCE_ATTRIBUTES="$v"
}
# oute.agent dos eventos = quem chamou, em $WHO: o marcador que o harness põe no shell dele; ambiente do swarm = o
# agente do dispatcher (meta da rodada; sem ele, claude); `human` só com terminal e nenhum marcador; na dúvida,
# unknown. Sem $(…): o -t 1 olha o stdout
WHO=unknown
who_called() {
  local r a=""
  if [[ "${CLAUDECODE:-}" == 1 ]]; then WHO=claude
  elif [[ -n "${CODEX_THREAD_ID:-}" ]]; then WHO=codex
  elif [[ -n "${OUTE_SWARM_ID:-}${OUTE_SWARM_ROUND:-}${OUTE_SWARM_WORKER:-}" ]]; then
    r="${OUTE_SWARM_ID:-${OUTE_SWARM_ROUND:-}}"
    if [[ "$r" =~ ^[A-Za-z0-9._-]+$ && -f "$HOME/.oute/swarm/$r/meta" ]]; then
      a="$(sed -n 's/^agent=//p' "$HOME/.oute/swarm/$r/meta" 2>/dev/null | head -n1 | tr -cd 'a-z0-9_-' || true)"
    fi
    WHO="${a:-claude}"
  elif [[ -t 0 && -t 1 ]]; then WHO=human
  else WHO=unknown; fi
}
# evento da sessão: <opened|reopened|removed> chave=valor… Best-effort, como no oute-swarm e no oute-propose: sem
# oute-emit ou com o coletor fora, nada muda aqui. O resource do evento leva só a origem: a marca que esteja no
# ambiente de quem chamou é de outra sessão
emit() {
  local ev="$1"; shift
  command -v oute-emit >/dev/null 2>&1 || return 0
  OTEL_RESOURCE_ATTRIBUTES="$(otel_attrs)" oute-emit task "$ev" "$WHO" "$@" </dev/null >/dev/null 2>&1 || true
}
# sessão de uma worktree que o clean vai remover, lida antes (a marca vai embora junto), em T_*. Sem marca (worktree
# anterior à #128), repo e slug saem do caminho e o removed sai sem id
task_of() {   # <repo principal> <worktree>
  local f n; n="$(basename "$1")"
  T_ID=""; T_ROUND=""; T_SESS=""; T_REPO="$(attr "$n")"; T_SLUG="${2##*/}"; T_SLUG="$(attr "${T_SLUG#"$n"-}")"
  f="$(mark_path "$2")" || return 0
  T_ID="$(mark_get "$f" id)"; [[ -n "$T_ID" ]] || return 0
  T_ROUND="$(mark_get "$f" round)"; T_SESS="$(mark_get "$f" session)"
}
removed() {   # <base> <merged|empty|detached>, depois do task_of
  emit removed "id=$T_ID" "repo=$T_REPO" "slug=$T_SLUG" "base=$1" "reason=$2" "round=$T_ROUND" "session=$T_SESS" || true
}
# abertura: id estável na marca da worktree, evento e marca nas conversas. Chamada com `|| true`: nada daqui
# interrompe a abertura. Rodada: a do ambiente (dispatcher ou spawn; o worker leva o slug como sessão) ou, sem ele
# (restore, reabertura na mão), a que a marca guardou
# Escolha do seletor (S_*, do select_model): vai no evento e, para claude/codex, na marca; o `shell` não mexe nela
session() {   # <opened|reopened> <worktree> <repo> <slug> <agente> <base>
  local ev="$1" wt="$2" rname slug="$4" agent="$5" base="$6" mf="" id="" mid round eround mround="" sess msess="" legacy=""
  local ma="" mm="" me="" wa wm we
  rname="$(attr "$3")"
  if mf="$(mark_path "$wt")"; then
    id="$(mark_get "$mf" id)"; mround="$(mark_get "$mf" round)"; msess="$(mark_get "$mf" session)"
    ma="$(mark_get "$mf" agent)"; mm="$(mark_model "$mf")"; me="$(mark_get "$mf" effort)"
  fi
  if [[ "$agent" == shell ]]; then wa="$ma"; wm="$mm"; we="$me"; else wa="$agent"; wm="$S_MODEL"; we="$S_EFFORT"; fi
  mid="$id"; round="$mround"; sess="$msess"
  eround="${OUTE_SWARM_ID:-${OUTE_SWARM_ROUND:-}}"
  if [[ "$eround" =~ ^[A-Za-z0-9._-]+$ ]]; then
    round="$eround"; sess=""
    [[ -z "${OUTE_SWARM_WORKER:-}" ]] || sess="$slug"
  fi
  if [[ -z "$id" || "$round" != "$mround" || "$sess" != "$msess" || "$wa" != "$ma" || "$wm" != "$mm" || "$we" != "$me" ]]; then
    # worktree sem id na reabertura = anterior à #128: ganha um agora, com legacy
    if [[ -z "$id" ]]; then id="$rname-$slug-$(date -u +%Y%m%d%H%M%S)"; [[ "$ev" == opened ]] || legacy=true; fi
    if [[ -z "$mf" ]] || ! mark_write "$mf" "$id" "$rname" "$slug" "$round" "$sess" "$wa" "$wm" "$we"; then
      [[ -n "$mid" ]] || { echo "aviso: não consegui gravar o id da sessão em ${mf:-$wt}; a sessão segue sem id" >&2; id=""; legacy=""; }
    fi
  fi
  emit "$ev" "id=$id" "repo=$rname" "slug=$slug" "agent=$agent" "base=$base" "round=$round" "session=$sess" "legacy=$legacy" \
    "phase=$S_PHASE" "origin=$S_ORIGIN" "model=$S_MODEL" "effort=$S_EFFORT" "confidence=$S_CONF"
  mark_env "$id" "$rname" "$slug" "$round" "$sess"
}
cmd_mark() {
  local f id
  f="$(mark_path "${1:-$PWD}")" || return 0
  id="$(mark_get "$f" id)"; [[ -n "$id" ]] || return 0
  otel_attrs "oute.task.id=$id" "oute.task.repo=$(mark_get "$f" repo)" "oute.task.slug=$(mark_get "$f" slug)" \
    "oute.swarm.round=$(mark_get "$f" round)" "oute.swarm.session=$(mark_get "$f" session)"
}

# ---------------------------------------------------------------- modelo da sessão (ADR-02, #219)
S_PHASE=""; S_ORIGIN=""; S_MODEL=""; S_EFFORT=""; S_AGENT=""; S_CONF=""; MARGS=(); SEL_FILE=""
# argumentos de modelo do agente, em MARGS: <agente> <modelo> <esforço>; sem modelo, nenhum
model_args() {
  MARGS=()
  [[ -n "$2" ]] || return 0
  case "$1" in
    claude) MARGS=(--model "$2") ;;
    codex) MARGS=(-m "$2"); [[ -z "$3" ]] || MARGS+=(-c "model_reasoning_effort=$3") ;;
  esac
}
# --model/-m que já vem nos argumentos do agente (`oute-task x claude --model <id> …`): escolha explícita, e o
# oute-task não põe outro. <agente> <args…>; imprime o id
args_model() {
  local a="$1" prev="" x; shift
  for x in "$@"; do
    case "$prev" in --model) printf '%s' "$x"; return ;; -m) [[ "$a" != codex ]] || { printf '%s' "$x"; return; } ;; esac
    case "$x" in --model=*) printf '%s' "${x#--model=}"; return ;; esac
    prev="$x"
  done
}
# texto da tarefa (#257): o prompt nos argumentos do agente = o último, se é posicional, não é opção e tem mais de uma
# palavra. Posicional (#313) = o anterior é o `--` que fecha as opções, ou nenhum argumento antes dele é opção sem `=`
# (`-x`/`--x`): uma opção assim pode ser a dona de um ou de vários valores (`--append-system-prompt "…"`,
# `--add-dir /a "/b c"`, `--mcp-config a.json '{…}'`), e valor de opção nunca vai ao Jev. Sem saber quantos valores a
# opção leva, o texto não sai (`--verbose "prompt"`, `--resume <id> "prompt"`): use `--` antes do prompt, ou
# `--opção=valor`. Sessão aberta na mão não tem texto: o Jev não é chamado. <args…>
task_text() {
  [[ $# -gt 0 ]] || return 0
  local x="${!#}" a
  if [[ $# -lt 2 || "${@:$#-1:1}" != -- ]]; then
    for a in "${@:1:$#-1}"; do [[ "$a" != -* || "$a" == --*=* ]] || return 0; done
  fi
  [[ "$x" == -* || ! "$x" =~ [^[:space:]][[:space:]]+[^[:space:]] ]] || printf '%s' "$x"
}
# escolha da sessão, em S_*: <repo principal> <slug> <agente explícito ou vazio> <modelo explícito ou vazio> <fase fixa>
# <texto da tarefa ou vazio> (o texto vai ao oute-select pelo stdin, nunca por argumento).
# O `oute-swarm spawn` já resolveu e entrega o JSON em OUTE_SELECT_FILE (aqui, já em SEL_FILE); senão, o oute-select. Nunca interrompe a
# abertura: sem oute-select, nada muda; com ele falhando ou devolvendo algo inválido, aviso e o modelo padrão do
# agente. Só argumento inválido (código 2 do oute-select, que já disse o motivo) sai com erro.
select_model() {
  local js="" rc=0 args=() a m e p o c
  S_PHASE=""; S_ORIGIN=""; S_MODEL=""; S_EFFORT=""; S_AGENT=""; S_CONF=""
  if [[ -n "$SEL_FILE" && -r "$SEL_FILE" ]]; then js="$(cat "$SEL_FILE" 2>/dev/null || true)"
  elif command -v oute-select >/dev/null 2>&1; then
    [[ -z "$3" ]] || args+=(--agent "$3")
    [[ -z "$4" ]] || args+=(--model "$4")
    if [[ -n "$5" ]]; then args+=(--phase "$5"); else args+=(--task "$2"); fi
    if [[ -n "${6:-}" && -z "$5" ]]; then js="$(printf '%s' "$6" | oute-select --json --repo "$1" --text-file - ${args[@]+"${args[@]}"})" || rc=$?
    else js="$(oute-select --json --repo "$1" ${args[@]+"${args[@]}"} </dev/null)" || rc=$?; fi
    (( rc != 2 )) || exit 1
  else return 0; fi
  IFS='|' read -r a m e p o c < <(jq -r '[.agent, .model, .effort, .phase, .origin, .confidence] | map(. // "" | tostring) | join("|")' <<<"$js" 2>/dev/null) || true
  if (( rc != 0 )) || [[ ! "${a:-}" =~ ^(claude|codex)$ ]]; then
    echo "aviso: o seletor de modelo não respondeu; a sessão abre com o modelo padrão do agente" >&2; return 0
  fi
  S_AGENT="$a"
  [[ ! "$m" =~ ^[A-Za-z0-9._-]+(\[1m\])?$ ]] || S_MODEL="$m"
  [[ ! "$e" =~ ^[a-z]+$ ]] || S_EFFORT="$e"
  [[ ! "$p" =~ ^[a-z]+$ ]] || S_PHASE="$p"
  [[ ! "$o" =~ ^(manual|label|jev|padrao)$ ]] || S_ORIGIN="$o"
  [[ ! "${c:-}" =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]] || S_CONF="$c"
}
cmd_model_args() {   # <agente> [dir]
  local f
  f="$(mark_path "${2:-$PWD}")" || return 0
  [[ -n "${1:-}" && "$(mark_get "$f" agent)" == "$1" ]] || return 0
  model_args "$1" "$(mark_model "$f")" "$(mark_get "$f" effort)"
  [[ ${#MARGS[@]} -eq 0 ]] || printf '%s\n' "${MARGS[@]}"
}

cmd_list() {
  local r; for r in $(all_repos); do
    git -C "$r" worktree list | awk -v root="$WT_ROOT" 'index($1, root"/")==1'
  done
}

# ---------------------------------------------------------------- sessão em uso (#374)
# Worktree com sessão aberta não é limpa: o critério "sem commits" pegaria spike, dispatcher e worker no começo. Em
# uso é: (1) a do processo que chama (o PWD dele está nela); (2) de rodada do swarm não fechada: a worktree do
# dispatcher (branch sessao/swarm-<id> ou pasta <repo>-swarm-<id>, com meta e sem `fechada`) ou a sessão da marca
# (round + session) que está no `spawned` e fora do `closed`, com a aba viva no herdr (herdr fora do ar: vale o
# spawned); (3) agente (claude/codex) rodando com o cwd nela, via /proc. Saída: o motivo em IN_USE; 0 = em uso.
SWARM_STATE="$HOME/.oute/swarm"
in_use() {   # <worktree>
  local wt="$1" top c f r s b line tab cwd pid comm tabs
  IN_USE=""
  top="$(cd "$wt" 2>/dev/null && pwd -P)" || top="$wt"
  for c in "$PWD" "$(pwd -P)"; do
    if [[ "$c" == "$wt" || "$c" == "$wt"/* || "$c" == "$top" || "$c" == "$top"/* ]]; then IN_USE="esta sessão"; return 0; fi
  done
  b="$(git -C "$wt" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  r=""
  [[ "$b" =~ ^sessao/(swarm-[A-Za-z0-9-]+)$ ]] && r="${BASH_REMATCH[1]}"
  [[ -n "$r" ]] || { [[ "${wt##*/}" =~ -(swarm-[0-9]{4}-[0-9]{4})$ ]] && r="${BASH_REMATCH[1]}"; }
  if [[ -n "$r" && -f "$SWARM_STATE/$r/meta" && ! -f "$SWARM_STATE/$r/fechada" ]]; then IN_USE="dispatcher da rodada $r"; return 0; fi
  f="$(mark_path "$wt")" || f=""
  r="$(mark_get "$f" round)"; s="$(mark_get "$f" session)"
  if [[ -n "$r" && -n "$s" && -f "$SWARM_STATE/$r/spawned" && ! -f "$SWARM_STATE/$r/fechada" ]] \
     && ! grep -qsxF -- "$s" "$SWARM_STATE/$r/closed"; then
    line="$(awk -v s="$s" '$1==s' "$SWARM_STATE/$r/spawned" | tail -n1)"; tab="$(awk '{print $5}' <<<"$line")"
    if [[ -n "$line" ]]; then
      if [[ -z "$tab" || "$tab" == - ]] || ! tabs="$(herdr tab list 2>/dev/null)" || ! jq -e .result >/dev/null 2>&1 <<<"$tabs" \
         || jq -e --arg t "$tab" 'any(.. | objects; (.tab_id? // "") == $t)' >/dev/null 2>&1 <<<"$tabs"; then
        IN_USE="rodada $r"; return 0
      fi
    fi
  fi
  for c in /proc/[0-9]*; do
    pid="${c#/proc/}"; cwd="$(readlink "$c/cwd" 2>/dev/null || true)"
    [[ "$cwd" == "$wt" || "$cwd" == "$wt"/* || "$cwd" == "$top" || "$cwd" == "$top"/* ]] || continue
    comm="$(tr -d '\0' < "$c/comm" 2>/dev/null || true)"
    case "$comm" in claude|codex|node) IN_USE="agente rodando (pid $pid)"; return 0 ;; esac
  done
  return 1
}

# checkout principal atrás de origin/<base>: só fast-forward, e só se estiver na base e sem mudança local
sync_main() {
  local r="$1" base="$2" yes="$3" behind
  [[ "$(git -C "$r" branch --show-current)" == "$base" ]] || return 0
  behind="$(git -C "$r" rev-list --count "$base..origin/$base" 2>/dev/null || echo 0)"
  [[ "$behind" != 0 ]] || return 0
  if [[ -n "$(git -C "$r" status --porcelain --untracked-files=no 2>/dev/null)" ]]; then echo "mantém  $r ($base: $behind commit(s) atrás, mas com mudanças locais)"; return 0; fi
  if (( ! yes )); then echo "atualizar $r ($base: $behind commit(s) atrás de origin/$base)"; return 1; fi
  if git -C "$r" merge -q --ff-only "origin/$base" 2>/dev/null; then echo "atualizada $r ($base → $(git -C "$r" rev-parse --short HEAD))"
  else echo "mantém  $r ($base não avança só com fast-forward)"; fi
}

cmd_clean() {
  local yes=0 all=0 sp="" flags="" root force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes) yes=1 ;;
      --all) all=1; flags=" --all" ;;
      --force-in-use) force=1 ;;
      --space) [[ -n "${2:-}" ]] || die "uso: oute-task clean [--yes] [--space <nome> | --all]"
               sp="$(space_name "$2")"; flags=" --space $sp"; shift ;;
      *) die "opção desconhecida: $1 (uso: oute-task clean [--yes] [--space <nome> | --all] [--force-in-use])" ;;
    esac
    shift
  done
  (( ! all )) || [[ -z "$sp" ]] || die "--space e --all não andam juntos"
  # escopo: o space atual (ou o do --space) ou, com --all, tudo sob $WT_ROOT (como antes da #277)
  if (( all )); then root="$WT_ROOT"; echo "todos os spaces ($WT_ROOT)"
  else [[ -n "$sp" ]] || sp="$(current_space)"; root="$WT_ROOT/$sp"; echo "space $sp ($root)"; fi
  local r wt br ahead why reason todo=0 list legacy=0
  who_called || true
  for r in $(all_repos); do
    list="$(task_worktrees "$r" "$root")"
    if (( ! all )); then
      legacy=$(( legacy + $(task_worktrees "$r" "$WT_ROOT" | awk -v root="$WT_ROOT" '{n=$1; sub("/[^/]*$","",n); if (n==root) c++} END {print c+0}') ))
      [[ -n "$list" ]] || continue   # repo sem worktree no space: nem fetch nem fast-forward
    fi
    local base; base="$(default_branch "$r")"; base="${base:-main}"
    gitnet -C "$r" fetch -q origin --prune 2>/dev/null || true
    while read -r wt br; do
      [[ -n "$wt" ]] || continue
      if (( ! force )) && in_use "$wt"; then echo "em uso  $wt ($IN_USE)"; continue; fi
      if [[ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]]; then echo "mantém  $wt (mudanças locais)"; continue; fi
      if [[ "$br" == - ]]; then   # detached HEAD (ex.: sessão que voltou a origin/<base> depois do merge): sem branch a apagar
        if git -C "$wt" merge-base --is-ancestor HEAD "origin/$base" 2>/dev/null; then why="detached, contida em origin/$base"
        else ahead="$(git -C "$wt" rev-list --count "origin/$base..HEAD" 2>/dev/null || echo '?')"
             echo "mantém  $wt (detached com $ahead commit(s) fora de origin/$base)"; continue; fi
        todo=1
        if (( yes )); then task_of "$r" "$wt" || true; git -C "$r" worktree remove "$wt" && echo "removida $wt ($why)" && removed "$base" detached
        else echo "remover $wt ($why)"; fi
        continue
      fi
      ahead="$(git -C "$r" rev-list --count "origin/$base..$br" 2>/dev/null || echo 1)"
      why=""; reason=""
      if [[ "$ahead" == 0 ]]; then why="sem commits além de origin/$base"; reason=empty
      elif command -v gh >/dev/null && [[ "$(cd "$r" && gh pr list --head "$br" --state merged --json number --jq length 2>/dev/null || echo 0)" != 0 ]]; then why="PR mergeado"; reason=merged
      fi
      if [[ -z "$why" ]]; then echo "mantém  $wt ($br: $ahead commit(s) sem PR mergeado)"; continue; fi
      todo=1
      # o evento sai com a worktree removida, mesmo que o branch não apague
      if (( yes )); then task_of "$r" "$wt" || true
        git -C "$r" worktree remove "$wt" && { removed "$base" "$reason"; git -C "$r" branch -D "$br" >/dev/null && echo "removida $wt ($why)"; }
      else echo "remover $wt ($why)"; fi
    done <<<"$list"
    sync_main "$r" "$base" "$yes" || todo=1
  done
  (( ! legacy )) || echo "formato antigo: $legacy worktree(s) direto em $WT_ROOT, fora do escopo; só o 'oute-task clean --all' as considera"
  (( yes || ! todo )) || echo "(simulação — rode 'oute-task clean --yes$flags' para aplicar)"
}

cmd_open() {
  local repo="$1" slug="$2"; shift 2
  local agent="${1:-${O_AGENT:-claude}}" pos="${1:-}"; [[ $# -gt 0 ]] && shift
  local main name base="" wt br sp ev=reopened xagent="$O_AGENT" xmodel="$O_MODEL" amodel=""
  who_called || true
  # a escolha do spawn vale só para esta abertura: sai do ambiente antes do exec, para um `oute-task <outro-slug>`
  # rodado de dentro da sessão não herdar o agente e o modelo do worker
  SEL_FILE="${OUTE_SELECT_FILE:-}"; unset OUTE_SELECT_FILE
  # antes de criar a worktree: agente fora do stack não deixa sessão vazia para trás
  case "$agent" in
    claude|codex|shell) ;;
    pi) die "Pi saiu do stack (#217), use claude ou codex" ;;
    *) die "agente desconhecido: $agent (claude|codex|shell)" ;;
  esac
  [[ -z "$O_AGENT" || -z "$pos" || "$pos" == "$O_AGENT" ]] || die "--agent $O_AGENT e o agente $pos não andam juntos"
  main="$(main_root "$repo")" || die "$repo não é um repositório git"
  name="$(basename "$main")"; slug="$(slugify "$slug")"; [[ -n "$slug" ]] || die "slug vazio"
  # modelo da sessão (#219), também antes da worktree: --model inválido sai aqui. Escolha explícita = --agent,
  # --model, `codex` posicional e o --model/-m dos argumentos do agente; o `claude` posicional (o do shim) não conta
  if [[ "$agent" != shell ]]; then
    [[ "$pos" != codex ]] || xagent=codex
    amodel="$(args_model "$agent" "$@")"
    [[ -z "$O_MODEL" || -z "$amodel" || "$amodel" == "$O_MODEL" ]] || die "--model $O_MODEL e o modelo $amodel dos argumentos do agente não andam juntos"
    select_model "$main" "$slug" "$xagent" "${xmodel:-$amodel}" "$O_PHASE" "$(task_text "$@")"
    agent="${S_AGENT:-$agent}"
    [[ -n "$amodel" ]] || model_args "$agent" "$S_MODEL" "$S_EFFORT"
  fi
  sp="$(current_space)"; wt="$WT_ROOT/$sp/$name-$slug"; br="sessao/$slug"
  # formato antigo (antes da #277): a worktree que já existe direto em $WT_ROOT continua sendo a da tarefa
  [[ -d "$wt" || ! -d "$WT_ROOT/$name-$slug" ]] || wt="$WT_ROOT/$name-$slug"
  if [[ -d "$wt" ]]; then
    echo "reabrindo $wt ($(git -C "$wt" branch --show-current))" >&2
  else
    [[ ! -e "$WT_ROOT/$sp/.git" ]] || die "$WT_ROOT/$sp é uma worktree no formato antigo; não dá para usá-la como pasta do space $sp"
    mkdir -p "$WT_ROOT/$sp"
    git -C "$main" worktree prune   # registro de worktree cuja pasta sumiu não pode bloquear o add
    gitnet -C "$main" fetch -q origin --prune || echo "aviso: fetch falhou; usando o que há localmente" >&2
    base="$(default_branch "$main")"; base="${base:-main}"
    if git -C "$main" show-ref -q --verify "refs/heads/$br"; then git -C "$main" worktree add -q "$wt" "$br"
    else git -C "$main" worktree add -q -b "$br" "$wt" "origin/$base"; fi
    echo "worktree $wt · branch $br (de origin/$base)" >&2
    ev=opened
  fi
  cd "$wt"
  [[ -n "$base" ]] || { base="$(default_branch "$main")"; base="${base:-main}"; }
  session "$ev" "$wt" "$name" "$slug" "$agent" "$base" || true   # sessão no bucket (ADR-04, #128)
  case "$agent" in
    claude|codex)
      # sessão aberta pelo `oute-swarm spawn`: sem sugestão de prompt no campo do Claude Code (um Enter na hora errada a submeteria)
      # a marca no git-dir da worktree vale no restore do herdr (`claude --resume <id>` sem esta env): o shim a lê
      if [[ "$agent" == claude && -n "${OUTE_SWARM_WORKER:-}" ]]; then
        export CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION="${CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION:-false}"
        touch "$(git rev-parse --path-format=absolute --git-dir)/oute-swarm-worker" 2>/dev/null || true
      fi
      OUTE_NO_WORKTREE=1 exec "$agent" ${MARGS[@]+"${MARGS[@]}"} "$@" ;;   # passa pelo shim, que deixa seguir
    shell) exec bash -i ;;
  esac
}

O_AGENT=""; O_MODEL=""; O_PHASE=""
case "${1:-}" in
  ""|-h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' ;;
  list) cmd_list ;;
  clean) shift; cmd_clean "$@" ;;
  --mark) cmd_mark "${2:-}" 2>/dev/null || true ;;
  --model-args) cmd_model_args "${2:-}" "${3:-}" 2>/dev/null || true ;;
  *) r="$PWD"
     # opções da abertura, antes do slug; --phase (fase fixa, sem ler a issue) é o que o oute-swarm usa no dispatcher
     while [[ "${1:-}" == -* ]]; do
       case "$1" in
         -r) [[ $# -ge 3 ]] || die "uso: oute-task -r <repo> <slug> [agente]"
             r="$2"; [[ -d "$r" ]] || r="$WS_ROOT/$r" ;;
         --agent) O_AGENT="${2:-}"; [[ "$O_AGENT" != pi ]] || die "Pi saiu do stack (#217), use claude ou codex"
                  [[ "$O_AGENT" == claude || "$O_AGENT" == codex ]] || die "--agent inválido: ${O_AGENT:-(vazio)} (claude|codex)" ;;
         --model) O_MODEL="${2:-}"; [[ -n "$O_MODEL" ]] || die "--model sem valor" ;;
         --phase) O_PHASE="${2:-}"; [[ -n "$O_PHASE" ]] || die "--phase sem valor" ;;
         *) die "opção desconhecida: $1 (uso: oute-task [-r <repo>] [--agent claude|codex] [--model <id>] <slug> [agente] [args…])" ;;
       esac
       shift 2
     done
     [[ $# -ge 1 ]] || die "uso: oute-task [-r <repo>] [--agent claude|codex] [--model <id>] <slug> [agente] [args…]"
     cmd_open "$r" "$@" ;;
esac
