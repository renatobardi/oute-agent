#!/usr/bin/env python3
"""oute-select — seletor de modelo por sessão (ADR-02, #219, #257): diz com que agente e modelo uma sessão abre, sem abrir.

  oute-select [--json] [--repo <dir>] [--issue <n> | --task <slug>] [--phase <fase>]
              [--agent claude|codex] [--model <id>] [--text-file <arquivo>|-]

  --issue <n>      issue da sessão; --task <n>-<slug> tira o número do slug (slug sem número = sessão sem issue)
  --repo <dir>     checkout em que o `gh` lê a issue (padrão: o diretório atual)
  --phase <fase>   fase fixa, sem ler a issue (o dispatcher do swarm abre em `plan`)
  --agent/--model  escolha explícita (origem `manual`); o que faltar vem da linha da fase
  --text-file <f>  texto da tarefa (`-` = stdin), para o Jev classificar a fase quando nenhum label a dá
  --json           {"phase","origin","agent","model","effort","reason","confidence","reserve"}; sem ele, uma linha para ler

Precedência: --agent/--model > exceção por label (`kaizen`, `docs`) > label `aidlc:<fase>` > Jev > padrão (Sonnet).
Origem: `manual`, `label`, `jev` ou `padrao`. `effort` só existe no Codex. Campo sem valor sai como "".

Reserva (#258): quando a sessão abriria no Claude e ele está indisponível (`claude auth status` ≠ 0 ou `claude` ausente,
teto de 5 s), abre no Codex, na linha da mesma fase, e `reserve` vale `indisponivel` (senão ""). Não troca de agente
com --agent/--model ou --phase explícitos (só avisa), nem quando o `auth status` não responde a tempo (aviso, abre no
Claude). Com o Codex também fora (`codex login status` ≠ 0 ou ausente): aviso "Claude e Codex indisponíveis" e abre no
Claude.

Reserva por cota (#355): com o Claude disponível e sem escolha explícita, lê `oute-quota --json` (teto de 3 s). Qualquer
janela do Claude >= `max_pct` (90) -> abre no Codex, `reserve` = `cota`, com a janela e a hora do reset no aviso.
Exceção: só a janela de 5 h passou do corte, está abaixo de 100% e reseta em menos de `reset_grace_s` (20 min) -> só
aviso, abre no Claude. Cota do Claude `unknown` ou leitura que falha -> só aviso, abre no Claude. Claude e Codex >= corte:
aviso, abre no Claude. Codex `unknown`: troca, com aviso. Nunca bloqueia.
Tabela: $OUTE_SELECT_TABLE (padrão /opt/oute/select/models.toml, o config/select/ do checkout, só leitura).

Jev (#257): só sem label de fase (sessão sem issue, ou issue sem `aidlc:<fase>`), com texto da tarefa e sem --model.
Chamado direto na TypeSafe (primitivo `choice`), com teto de 3 s; a chave vem de $OUTE_TYPESAFE_API_KEY e só o texto
da tarefa sai da máquina, e só por `https://` (#313): com $OUTE_SELECT_JEV_URL em outro esquema o Jev não é chamado.
Confiança >= 0,6: origem `jev` e o modelo da fase classificada. Confiança menor, erro, tempo esgotado, sem a chave ou
endereço sem `https://`: padrão, com aviso. `confidence` é a do Jev sempre que ele respondeu (senão, "").

Nunca bloqueia a abertura: `gh` fora do ar, issue sem label, Jev fora do ar ou tabela ausente dão o padrão, com aviso
em stderr e código 0 (sem tabela, `model` sai vazio e o agente abre com o modelo dele). Código 2 só para argumento
inválido.
"""
import datetime
import json
import os
import signal
import re
import subprocess
import sys
import threading
import tomllib
import urllib.error
import urllib.request

TABLE = os.environ.get("OUTE_SELECT_TABLE", "/opt/oute/select/models.toml")
AGENTS = ("claude", "codex")
MODEL_RE = re.compile(r"[A-Za-z0-9._-]+(\[1m\])?")
PHASE_RE = re.compile(r"[a-z]+")
USAGE = "uso: oute-select [--json] [--repo <dir>] [--issue <n> | --task <slug>] [--phase <fase>] " \
        "[--agent claude|codex] [--model <id>] [--text-file <arquivo>|-]"

# Jev direto na TypeSafe (ADR-02, #257). A URL só muda nos testes (TypeSafe falsa, com TLS) e só vale com https://
# (#313): sem TLS, o texto da tarefa e a chave iriam em claro.
JEV_URL_ENV = "OUTE_SELECT_JEV_URL"
JEV_URL = os.environ.get(JEV_URL_ENV, "https://api.typesafe.ai/v1/systemone")
JEV_URL_RE = re.compile(r"https://[A-Za-z0-9.-]+(:[0-9]+)?(/[!-~]*)?")   # sem usuário, espaço ou caractere de controle
JEV_MODEL = "jev-1.13.0"     # id exato, como os da tabela
JEV_KEY_ENV = "OUTE_TYPESAFE_API_KEY"
JEV_TIMEOUT = 3.0            # teto da chamada inteira, em segundos
JEV_MIN_CONFIDENCE = 0.6
JEV_TEXT_MAX = 16000         # caracteres do texto da tarefa que vão ao Jev (limite dele: 32k tokens)
JEV_REPLY_MAX = 1 << 20
# Reserva (#258): checagem de disponibilidade dos agentes. $OUTE_SELECT_AGENT_TIMEOUT só encurta (testes), nunca passa de 5 s.
AUTH_TIMEOUT = 5.0
# Reserva por cota (#355): `oute-quota --json`, teto de 3 s ($OUTE_SELECT_QUOTA_TIMEOUT só encurta, nos testes)
QUOTA_TIMEOUT = 3.0
QUOTA_MAX_PCT = 90.0
QUOTA_GRACE_S = 1200.0
JEV_INSTRUCTIONS = "Em que fase do ciclo de entrega de software esta tarefa está?"
# o que cada fase do ADR-07 faz, para o Jev escolher; fase da tabela sem descrição aqui vai só com o nome
PHASE_HINTS = {
    "strat": "estratégia: oportunidade, pesquisa, comparar caminhos antes de decidir o que fazer",
    "intent": "intenção: entender e questionar o pedido, o problema e o resultado esperado",
    "spec": "especificação: escrever a issue com critérios de aceite e o que fica fora",
    "arch": "arquitetura: decisão estrutural, ADR, limites entre componentes",
    "design": "design: interface de módulos, protótipo descartável, desenho da solução",
    "plan": "planejamento: quebrar o trabalho em issues, triagem, dependências, riscos",
    "build": "construção: escrever ou alterar código, testes e a documentação da mudança; corrigir bug",
    "qa": "qualidade: revisar ou auditar um pull request, rodar gates e analisar o resultado",
    "ship": "entrega: preparar a release, checklist, deploy e verificação depois do deploy",
    "ops": "operação: ler telemetria, conferir saúde e custo, diagnosticar anomalia em produção",
    "learn": "aprendizado: analisar uso, custo, incidentes e rodadas para tirar lições",
    "iter": "iteração: sintetizar o aprendizado em roadmap e próximo ciclo, limpar o backlog",
    "ctx": "contexto: manter glossário, regras, memória e documentação de contexto coerentes",
}


def die(msg):
    print(f"oute-select: {msg}", file=sys.stderr)
    sys.exit(2)


def warn(msg):
    print(f"oute-select: aviso: {msg}", file=sys.stderr)


def line_ok(d):
    return isinstance(d, dict) and all(isinstance(d.get(k), str) and MODEL_RE.fullmatch(d[k])
                                       for k in ("claude", "codex", "effort"))


def load_table():
    """(padrão, {fase: linha}, [(label, linha)]); tabela ausente ou inválida = (None, {}, []), com aviso"""
    try:
        with open(TABLE, "rb") as f:
            t = tomllib.load(f)
        default, phases, exceptions = t["default"], {}, []
        if not line_ok(default):
            raise ValueError("[default] sem claude, codex ou effort")
        for ln in t.get("line", []):
            if not line_ok(ln) or not isinstance(ln.get("phases"), list):
                raise ValueError("[[line]] sem phases, claude, codex ou effort")
            for p in ln["phases"]:
                if not isinstance(p, str) or not PHASE_RE.fullmatch(p):
                    raise ValueError(f"fase inválida: {p!r}")
                phases[p] = ln
        for ex in t.get("exception", []):
            if not line_ok(ex) or not isinstance(ex.get("label"), str) or not ex["label"]:
                raise ValueError("[[exception]] sem label, claude, codex ou effort")
            exceptions.append((ex["label"], ex))
        return default, phases, exceptions
    except (OSError, KeyError, ValueError, TypeError) as e:   # tomllib.TOMLDecodeError é ValueError
        warn(f"tabela de fase ausente ou inválida ({TABLE}: {e}); a sessão abre com o modelo padrão do agente")
        return None, {}, []


def issue_labels(repo, issue):
    """labels da issue pelo `gh`; None se o gh não respondeu (fora do ar, sem auth, issue inexistente, sem gh)"""
    try:
        timeout = float(os.environ.get("OUTE_SELECT_GH_TIMEOUT", "10"))
    except ValueError:
        timeout = 10.0
    try:
        r = subprocess.run(["gh", "issue", "view", str(issue), "--json", "labels"], cwd=repo or None,
                           capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
        if r.returncode != 0:
            return None
        return [x["name"] for x in json.loads(r.stdout)["labels"]]
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
        return None


class JevError(Exception):
    """falha do Jev, com um motivo curto que nunca leva a chave nem o corpo da resposta"""


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k):   # redirecionamento levaria o Authorization a outro host
        return None


def jev_timeout():
    """teto da chamada: $OUTE_SELECT_JEV_TIMEOUT só encurta (testes), nunca passa de 3 s"""
    try:
        t = float(os.environ.get("OUTE_SELECT_JEV_TIMEOUT", ""))
    except ValueError:
        return JEV_TIMEOUT
    return t if 0 < t <= JEV_TIMEOUT else JEV_TIMEOUT


def jev_phase(text, key, phases):
    """(fase, confiança) do Jev para o texto da tarefa; JevError em qualquer falha. Vai só o texto e as fases."""
    body = {"state": text, "model": JEV_MODEL,
            "questions": {"fase": {"type": "choice", "instructions": JEV_INSTRUCTIONS,
                                   "criteria": {p: PHASE_HINTS.get(p, p) for p in phases}}}}
    limit, got = jev_timeout(), {}

    def call():
        try:
            # a chave só existe aqui, no cabeçalho: nunca em argv, log, aviso ou evento
            req = urllib.request.Request(JEV_URL, data=json.dumps(body, ensure_ascii=False).encode(), method="POST",
                                         headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"})
            with urllib.request.build_opener(NoRedirect).open(req, timeout=limit) as r:
                got["raw"] = r.read(JEV_REPLY_MAX + 1)
        except urllib.error.HTTPError as e:
            got["err"] = f"HTTP {e.code}"
        except (OSError, ValueError) as e:   # URLError é OSError; o motivo sai pelo tipo, sem a mensagem
            slow = isinstance(e, TimeoutError) or isinstance(getattr(e, "reason", None), TimeoutError)
            got["err"] = f"sem resposta em {limit:g} s" if slow else f"falha de rede ({type(e).__name__})"

    # o timeout do urllib vale por operação de socket (e não cobre o DNS): a thread limita a chamada inteira
    t = threading.Thread(target=call, daemon=True)
    t.start()
    t.join(limit)
    if t.is_alive() or not got:
        raise JevError(f"sem resposta em {limit:g} s")
    if "err" in got:
        raise JevError(got["err"])
    raw = got["raw"]
    try:
        if len(raw) > JEV_REPLY_MAX:
            raise ValueError
        ans = json.loads(raw)["answers"]["fase"]
        phase, conf = ans["choice"], ans["confidence"]
        if phase not in phases or isinstance(conf, bool) or not isinstance(conf, (int, float)) or not 0 <= conf <= 1:
            raise ValueError
    except (ValueError, KeyError, TypeError):
        raise JevError("resposta inválida") from None
    return phase, float(conf)


def read_text(path):
    """texto da tarefa de --text-file (`-` = stdin), sem espaço nas pontas e cortado; ilegível = sem texto"""
    try:
        if path == "-":
            raw = sys.stdin.buffer.read(4 * JEV_TEXT_MAX)
        else:
            with open(path, "rb") as f:
                raw = f.read(4 * JEV_TEXT_MAX)
    except OSError as e:
        warn(f"não li o texto da tarefa ({e.strerror or type(e).__name__}); sigo sem ele")
        return ""
    return raw.decode("utf-8", "replace").replace("\x00", "").strip()[:JEV_TEXT_MAX]


def fmt_conf(c):
    return f"{c:.2f}".replace(".", ",")


def by_jev(text, phases, why):
    """(linha ou None, fase, origem, motivo, aviso, confiança ou None) pelo Jev, quando a issue não deu a fase (`why`)"""
    if not JEV_URL_RE.fullmatch(JEV_URL):   # o valor não vai no aviso: pode levar credencial
        w = f"{why}, e o endereço do Jev (${JEV_URL_ENV}) não é https://: o Jev não é chamado"
        return None, "", "padrao", w, w, None
    key = os.environ.get(JEV_KEY_ENV, "").strip()
    if not key:
        w = f"{why}, e sem a chave da TypeSafe (${JEV_KEY_ENV}) o Jev não classifica"
        return None, "", "padrao", w, w, None
    try:
        phase, conf = jev_phase(text, key, phases)
    except JevError as e:
        w = f"{why}, e o Jev falhou ({e})"
        return None, "", "padrao", w, w, None
    if conf < JEV_MIN_CONFIDENCE:
        w = f"{why}, e o Jev ficou com confiança baixa ({fmt_conf(conf)} em {phase}, mínimo {fmt_conf(JEV_MIN_CONFIDENCE)})"
        return None, "", "padrao", w, w, conf
    return phases[phase], phase, "jev", f"Jev: fase {phase}, confiança {fmt_conf(conf)} ({why})", None, conf


def by_issue(repo, issue, phases, exceptions):
    """(linha ou None, fase, origem, motivo, aviso, cabe o Jev?) pela issue: exceção por label, depois a fase.
    O Jev só cabe quando se sabe que não há label de fase: sessão sem issue, ou issue lida sem `aidlc:<fase>` da tabela"""
    if issue is None:
        return None, "", "padrao", "sessão sem issue", "sessão sem issue", True
    labels = issue_labels(repo, issue)
    if labels is None:
        why = f"o gh não respondeu para a issue #{issue}"
        return None, "", "padrao", why, why, False
    found = [x[len("aidlc:"):] for x in labels if x.startswith("aidlc:")]
    known = [p for p in found if p in phases]
    phase = known[0] if known else ""
    for label, ln in exceptions:
        if label in labels:
            return ln, phase, "label", f"label {label} da issue #{issue}", None, False
    if known:
        extra = f"issue #{issue} com mais de um label de fase ({', '.join(found)}); vale {phase}" if len(found) > 1 else None
        return phases[phase], phase, "label", f"label aidlc:{phase} da issue #{issue}", extra, False
    if found:
        why = f"issue #{issue} com fase fora da tabela (aidlc:{found[0]})"
    else:
        why = f"issue #{issue} sem label aidlc:<fase>"
    return None, "", "padrao", why, why, True


def guess_agent(model, default, phases, exceptions):
    """agente de um --model dado sem --agent: a coluna da tabela em que o id aparece; fora dela, pelo prefixo"""
    lines = [default] if default else []
    lines += list(phases.values()) + [ln for _, ln in exceptions]
    if any(ln["codex"] == model for ln in lines):
        return "codex"
    if any(ln["claude"] == model for ln in lines):
        return "claude"
    return "codex" if model.startswith(("gpt-", "codex")) else "claude"


def auth_timeout():
    try:
        t = float(os.environ.get("OUTE_SELECT_AGENT_TIMEOUT", ""))
    except ValueError:
        return AUTH_TIMEOUT
    return t if 0 < t <= AUTH_TIMEOUT else AUTH_TIMEOUT


def agent_state(cmd):
    """"ok", "down" (rc ≠ 0, ausente ou sem permissão) ou "slow" (sem resposta no teto); a saída do agente é descartada"""
    try:
        r = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=auth_timeout())
    except subprocess.TimeoutExpired:
        return "slow"
    except (OSError, subprocess.SubprocessError):
        return "down"
    return "ok" if r.returncode == 0 else "down"


def quota_read():
    """o JSON do `oute-quota --json`, ou None (ausente, sem resposta no teto, saída inválida); a saída de erro é descartada"""
    try:
        limit = float(os.environ.get("OUTE_SELECT_QUOTA_TIMEOUT", ""))
        limit = limit if 0 < limit <= QUOTA_TIMEOUT else QUOTA_TIMEOUT
    except ValueError:
        limit = QUOTA_TIMEOUT
    try:
        p = subprocess.Popen(["oute-quota", "--json"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        return None
    try:
        raw, _ = p.communicate(timeout=limit)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, signal.SIGKILL)   # o oute-quota e os curls dele
        except OSError:
            pass
        p.kill()
        p.wait()
        return None
    try:
        q = json.loads(raw)
        return q if isinstance(q, dict) and isinstance(q.get("agents"), dict) else None
    except ValueError:
        return None


def num(v, default):
    return float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) and v >= 0 else default


def quota_windows(q, agent):
    """(status, {janela: (used_pct, resets_in_s, resets_at)}) de um agente; formato inesperado = ("unknown", {})"""
    a = q["agents"].get(agent)
    if not isinstance(a, dict) or a.get("status") != "ok" or not isinstance(a.get("windows"), dict):
        return "unknown", {}
    out = {}
    for name, w in a["windows"].items():
        if isinstance(w, dict) and isinstance(w.get("used_pct"), (int, float)) and not isinstance(w["used_pct"], bool):
            out[name] = (float(w["used_pct"]), num(w.get("resets_in_s"), None), w.get("resets_at"))
    return ("ok", out) if out else ("unknown", {})


def reset_text(at):
    """hora do reset para o aviso, no fuso local; fora do formato, o texto como veio (ou "sem hora de reset")"""
    try:
        return datetime.datetime.fromisoformat(at).astimezone().strftime("%d/%m %H:%M %Z")
    except (ValueError, TypeError):
        return str(at)[:40] if isinstance(at, str) and at else "sem hora de reset"


def quota_over(wins, cut):
    return {n: w for n, w in wins.items() if w[0] >= cut}


def quota_trigger():
    """("claude"|"codex", aviso ou None) pela cota: "codex" só com o Claude em/acima do corte e sem exceção"""
    q = quota_read()
    if q is None:
        return "claude", "não li a cota (`oute-quota --json` falhou ou não respondeu em tempo); abrindo no Claude"
    cut, grace = num(q.get("max_pct"), QUOTA_MAX_PCT), num(q.get("reset_grace_s"), QUOTA_GRACE_S)
    cst, cw = quota_windows(q, "claude")
    if cst != "ok":
        return "claude", "a cota do Claude está desconhecida (unknown); abrindo no Claude"
    over = quota_over(cw, cut)
    if not over:
        return "claude", None
    desc = ", ".join(f"{n} em {w[0]:g}% (reseta {reset_text(w[2])})" for n, w in sorted(over.items()))
    five = over.get("5h")
    if list(over) == ["5h"] and five[0] < 100 and five[1] is not None and five[1] < grace:
        return "claude", f"Claude com a janela de 5h em {five[0]:g}%, mas reseta em menos de {grace / 60:g} min " \
                         f"({reset_text(five[2])}); abrindo no Claude"
    xst, xw = quota_windows(q, "codex")
    if xst == "ok":
        xover = quota_over(xw, cut)
        if xover:
            xd = ", ".join(f"{n} em {w[0]:g}% (reseta {reset_text(w[2])})" for n, w in sorted(xover.items()))
            return "claude", f"cota do Claude esgotada ({desc}) e a do Codex também ({xd}); abrindo no Claude"
        return "codex", f"cota do Claude esgotada ({desc}); abrindo no Codex (reserva por cota)"
    return "codex", f"cota do Claude esgotada ({desc}) e a do Codex está desconhecida (unknown); " \
                    "abrindo no Codex mesmo assim (reserva por cota)"


def main(argv):
    opt = {"json": False, "repo": "", "issue": None, "phase": "", "agent": "", "model": "", "text-file": ""}
    it = iter(argv)
    for a in it:
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if a == "--json":
            opt["json"] = True
            continue
        if a not in ("--repo", "--issue", "--task", "--phase", "--agent", "--model", "--text-file"):
            die(f"opção desconhecida: {a}\n{USAGE}")
        v = next(it, None)
        if v is None:
            die(f"{a} sem valor\n{USAGE}")
        if a == "--task":
            m = re.match(r"([0-9]+)-", v)
            opt["issue"] = int(m.group(1)) if m else None
        elif a == "--issue":
            if not re.fullmatch(r"[0-9]+", v):
                die(f"--issue inválido: {v}")
            opt["issue"] = int(v)
        else:
            opt[a[2:]] = v
    agent, model = opt["agent"], opt["model"]
    if agent == "pi":
        die("Pi saiu do stack (#217), use claude ou codex")
    if agent and agent not in AGENTS:
        die(f"agente inválido: {agent}; use claude ou codex")
    if model and not MODEL_RE.fullmatch(model):
        die(f"modelo inválido: {model}")

    default, phases, exceptions = load_table()
    warning, confidence = None, None
    if opt["phase"]:
        phase = opt["phase"]
        if phase in phases:
            ln, origin, reason = phases[phase], "padrao", f"fase {phase} fixa"
        else:
            ln, origin, reason = None, "padrao", f"fase fixa fora da tabela ({phase})"
            phase, warning = "", reason
    else:
        ln, phase, origin, reason, warning, ask = by_issue(opt["repo"], opt["issue"], phases, exceptions)
        # Jev: só sem label de fase, com texto, e quando a linha da fase ainda escolhe algo (sem --model)
        if ask and phases and not model and opt["text-file"]:
            text = read_text(opt["text-file"])
            if text:
                ln, phase, origin, reason, warning, confidence = by_jev(text, phases, reason)
    if ln is None:
        ln = default
    if agent or model:
        origin = "manual"
        reason = " ".join(x for x in (agent and f"--agent {agent}", model and f"--model {model}") if x) + f" ({reason})"
    if not agent:
        agent = guess_agent(model, default, phases, exceptions) if model else "claude"
    # reserva (#258): só quando a sessão abriria no Claude. Escolha explícita (--agent, --model, --phase) só avisa
    reserve = ""
    if agent == "claude":
        explicit = bool(opt["agent"] or model or opt["phase"])
        cs = agent_state(["claude", "auth", "status"])
        if cs == "slow":
            warn(f"o `claude auth status` não respondeu em {auth_timeout():g} s; abrindo no Claude")
        elif cs == "down" and explicit:
            warn("o Claude está indisponível (`claude auth status` falhou), mas a escolha foi explícita "
                 "(--agent, --model ou --phase); abrindo no Claude")
        elif cs == "down":
            xs = agent_state(["codex", "login", "status"])
            if xs == "down":
                warn("Claude e Codex indisponíveis; abrindo no Claude")
            else:
                if xs == "slow":
                    warn(f"o `codex login status` não respondeu em {auth_timeout():g} s; abrindo no Codex mesmo assim")
                agent, reserve = "codex", "indisponivel"
                warn("o Claude está indisponível (`claude auth status` falhou); abrindo no Codex (reserva)")
        if cs != "down" and not explicit:   # gatilho de cota (#355): só com o Claude disponível e sem escolha explícita
            who, note = quota_trigger()
            if note:
                warn(note)
            if who == "codex":
                agent, reserve = "codex", "cota"
    # o aviso só interessa quando o padrão escolheu o modelo; sem tabela, o aviso dela já saiu
    if warning and not model and default:
        warn(f"{warning}; abrindo no padrão ({ln[agent]})" if ln is default else warning)
    if not model and ln:
        model = ln[agent]
    effort = ln["effort"] if ln and agent == "codex" else ""
    out = {"phase": phase, "origin": origin, "agent": agent, "model": model, "effort": effort, "reason": reason,
           "confidence": "" if confidence is None else round(confidence, 4), "reserve": reserve}
    if opt["json"]:
        print(json.dumps(out, ensure_ascii=False))
    else:
        print(f"fase {phase or '-'} · origem {origin} · agente {agent} · modelo {model or '-'}"
              f"{' · esforço ' + effort if effort else ''}"
              f"{' · confiança ' + fmt_conf(confidence) if confidence is not None else ''}"
              f"{' · reserva ' + reserve if reserve else ''} · motivo: {reason}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
